local function New(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end
local function Corner(o, r) return New("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function Stroke(o, c, t) return New("UIStroke", { Color = c or T.Stroke, Transparency = t or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o) end
local function Pad(o, l, t, r, b)
	return New("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b) }, o)
end
local function List(o, pad)
	return New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, pad or 0) }, o)
end
local function Tween(o, t, p, style)
	TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), p):Play()
end
local function Connect(sig, fn)
	local c = sig:Connect(fn)
	table.insert(Library.Connections, c)
	return c
end
local function Label(parent, text, size, color, font)
	return New("TextLabel", {
		BackgroundTransparency = 1, Text = text, TextSize = size or 14, TextColor3 = color or T.Text,
		Font = font or Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left,
	}, parent)
end
local function GuiParent()
	local ok, ui = pcall(function() return gethui and gethui() end)
	if ok and ui then return ui end
	local ok2 = pcall(function() return game:GetService("CoreGui").Name end)
	if ok2 then return game:GetService("CoreGui") end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end
local function InRect(gui, pos)
	local a, s = gui.AbsolutePosition, gui.AbsoluteSize
	return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end
local function RowHover(row)
	Connect(row.MouseEnter, function() Tween(row, .15, { BackgroundTransparency = .85 }) end)
	Connect(row.MouseLeave, function() Tween(row, .15, { BackgroundTransparency = 1 }) end)
end

local IconLib
pcall(function()
	IconLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"))()
end)

local function normIcon(r)
	if type(r) ~= "table" then return end
	local url = r.Url or r.Image or r.Id
	if not url then return end
	return {
		Url = url,
		RectSize = r.ImageRectSize or r.RectSize or Vector2.zero,
		RectOffset = r.ImageRectOffset or r.RectOffset or Vector2.zero,
	}
end

function Library:GetIcon(name)
	if name == nil then return end
	if type(name) == "number" then
		return { Url = "rbxassetid://" .. name, RectSize = Vector2.zero, RectOffset = Vector2.zero }
	end
	if type(name) ~= "string" then return end
	if name:match("^rbxassetid://") or name:match("^rbxasset://") then
		return { Url = name, RectSize = Vector2.zero, RectOffset = Vector2.zero }
	end
	name = name:gsub("^lucide[%-:]", "")
	if not IconLib then return end
	local res
	pcall(function()
		if type(IconLib.GetAsset) == "function" then res = normIcon(IconLib.GetAsset(name)) end
		if not res and type(IconLib.Icons) == "table" then res = normIcon(IconLib.Icons[name]) end
		if not res then res = normIcon(IconLib[name]) end
	end)
	return res
end

function Library:ApplyIcon(img, name)
	local i = self:GetIcon(name)
	if i then
		img.Image, img.ImageRectSize, img.ImageRectOffset = i.Url, i.RectSize, i.RectOffset
		img.Visible = true
		return true
	end
	img.Visible = false
	return false
end

function Library:PlaySound(name)
	if self.SoundEnabled == false then return end
	local id = self.Sounds and (self.Sounds[name] or self.Sounds.Click)
	if not id or id == "" then return end
	local now = os.clock()
	if self._soundClock and now - self._soundClock < .04 then return end
	self._soundClock = now
	local s = Instance.new("Sound")
	s.Name = "UILibSound"
	s.SoundId = id
	s.Volume = self.SoundVolume or .35
	s.PlaybackSpeed = 1 + (math.random() - .5) * .08
	s.Parent = SoundService
	s:Play()
	task.delay(2, function() if s and s.Parent then s:Destroy() end end)
end

local function CheckBox(parent, size)
	local box = New("Frame", {
		AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0),
		Size = UDim2.fromOffset(size, size), BackgroundColor3 = T.Element,
		BackgroundTransparency = .15, BorderSizePixel = 0,
	}, parent)
	Corner(box, 7)
	local stroke = Stroke(box, T.Stroke, .5)
	stroke.Thickness = 1.5
	local scale = New("UIScale", { Scale = 1 }, box)

	local holder = New("Frame", {
		BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5),
		Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(size - 6, size - 6),
	}, box)
	local checkScale = New("UIScale", { Scale = 0 }, holder)

	local function tick(px, py, w, h, rot)
		local f = New("Frame", {
			AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(px, py),
			Size = UDim2.fromOffset(w, h), BackgroundColor3 = T.Bg,
			BorderSizePixel = 0, Rotation = rot,
		}, holder)
		Corner(f, w / 2)
		return f
	end
	tick(.30, .68, 3, size * .27, -45)
	tick(.66, .55, 3, size * .45, 45)
	holder.Visible = false

	return { box = box, stroke = stroke, holder = holder, checkScale = checkScale, scale = scale }
end

function Library:Notify(title, text, duration)
	if not self.NotifyHolder or not self.NotifyHolder.Parent then
		if self.NotifyGui then pcall(function() self.NotifyGui:Destroy() end) end
		local g = New("ScreenGui", { Name = "UILibNotify", ResetOnSpawn = false, DisplayOrder = 200, IgnoreGuiInset = true }, GuiParent())
		self.NotifyGui = g
		self.NotifyHolder = New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(260, 400) }, g)
		local l = List(self.NotifyHolder, 8); l.VerticalAlignment = Enum.VerticalAlignment.Bottom
	end
	local f = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Panel, BackgroundTransparency = 1 }, self.NotifyHolder)
	Corner(f, 6); local s = Stroke(f, T.Stroke, 1); Pad(f, 12, 8, 12, 10); List(f, 2)
	local nscale = New("UIScale", { Scale = .75 }, f)
	local a = Label(f, title, 14, T.Text, Enum.Font.GothamBold); a.Size = UDim2.new(1, 0, 0, 18); a.TextTransparency = 1
	local b = Label(f, text or "", 13, T.SubText, Enum.Font.Gotham); b.Size = UDim2.new(1, 0, 0, 0); b.AutomaticSize = Enum.AutomaticSize.Y; b.TextWrapped = true; b.TextTransparency = 1
	Tween(f, .3, { BackgroundTransparency = .1 }); Tween(s, .3, { Transparency = 0 })
	Tween(a, .3, { TextTransparency = 0 }); Tween(b, .3, { TextTransparency = 0 }); Tween(nscale, .35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration or 4, function()
		Tween(f, .28, { BackgroundTransparency = 1 }); Tween(s, .28, { Transparency = 1 })
		Tween(a, .28, { TextTransparency = 1 }); Tween(b, .28, { TextTransparency = 1 }); Tween(nscale, .28, { Scale = .85 })
		task.wait(.32); f:Destroy()
	end)
end

function Library:Add(kind, cfg)
	if kind == "Window" then return self:AddWindow(cfg) end
	error("Library:Add - unknown kind '" .. tostring(kind) .. "'")
end

function Library:AddWindow(cfg)
	cfg = cfg or {}
	local tk = cfg.ToggleKey or Enum.KeyCode.RightShift
	if type(tk) == "string" then tk = Enum.KeyCode[tk] or Enum.KeyCode.RightShift end
	local Win = { Tabs = {}, Title = cfg.Title or "Script", Icon = cfg.Icon or "layout-grid", ToggleKey = tk }

	local gui = New("ScreenGui", { Name = "UILib", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100, IgnoreGuiInset = true }, GuiParent())
	Win.Gui = gui

	local blur = New("BlurEffect", { Size = 0, Enabled = false }, Lighting)
	Win.Blur = blur

	-- Main Holder (Includes UI + Tabs underneath)
	local mainHolder = New("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .48),
		Size = UDim2.fromOffset(600, 680), -- 600x600 UI + 80px for Tabs
		BackgroundTransparency = 1,
	}, gui)
	Win.MainHolder = mainHolder

	-- Neon Glow Fade for the whole UI
	local neonGlow = New("ImageLabel", {
		BackgroundTransparency = 1, Image = "rbxassetid://243660364", ImageColor3 = T.Accent,
		ImageTransparency = 1, Size = UDim2.new(1, 80, 1, 80), Position = UDim2.fromOffset(-40, -40), ZIndex = 1
	}, mainHolder)

	-- The Square UI
	local main = New("Frame", {
		AnchorPoint = Vector2.new(.5, 0), Position = UDim2.fromScale(.5, 0),
		Size = UDim2.fromOffset(600, 600), 
		BackgroundColor3 = T.Bg, BackgroundTransparency = T.Transparency, BorderSizePixel = 0, ClipsDescendants = true, ZIndex = 2
	}, mainHolder)
	Corner(main, 12); Stroke(main, T.Stroke, .4)
	
	local scale = New("UIScale", { Scale = .9 }, mainHolder)
	Win.Main = main

	-- Top Bar
	local topBar = New("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1, BorderSizePixel = 0, ZIndex = 3 }, main)
	Pad(topBar, 12, 12, 12, 0)

	local topList = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1,1) }, topBar)
	local tl = List(topList, 10); tl.FillDirection = Enum.FillDirection.Horizontal; tl.VerticalAlignment = Enum.VerticalAlignment.Center

	local titleBlock = New("Frame", { Size = UDim2.fromOffset(140, 36), BackgroundColor3 = T.Element, BorderSizePixel = 0 }, topList)
	Corner(titleBlock, 6)
	local titleTxt = Label(titleBlock, Win.Title, 14, T.Text, Enum.Font.GothamBold)
	titleTxt.Size = UDim2.fromScale(1, 1); titleTxt.TextXAlignment = Enum.TextXAlignment.Center

	New("Frame", { Size = UDim2.fromOffset(1, 24), BackgroundColor3 = T.Stroke, BorderSizePixel = 0 }, topList)

	local bellBlock = New("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 12), Size = UDim2.fromOffset(36, 36), BackgroundColor3 = T.Element, BackgroundTransparency = .25, BorderSizePixel = 0, Active = true, ZIndex = 3 }, topBar)
	Corner(bellBlock, 6); local bellStroke = Stroke(bellBlock, T.Stroke, .55)
	local bellImg = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(20, 20), ImageColor3 = T.Text }, bellBlock)
	Library:ApplyIcon(bellImg, "bell")
	Connect(bellBlock.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			Library:PlaySound("Click")
			Tween(bellStroke, .15, { Transparency = 0, Color = T.Accent })
			task.delay(.18, function() Tween(bellStroke, .25, { Transparency = .55, Color = T.Stroke }) end)
		end
	end)

	-- Detached Tabs Box (Underneath the UI)
	local tabHolder = New("Frame", {
		AnchorPoint = Vector2.new(.5, 1), Position = UDim2.fromScale(.5, 1),
		Size = UDim2.fromOffset(600, 70), BackgroundTransparency = 1, ZIndex = 2
	}, mainHolder)
	
	local tabBg = New("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
		Size = UDim2.new(1, -40, 1, -10), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.05
	}, tabHolder)
	Corner(tabBg, 10); Stroke(tabBg, T.Stroke, 0.5)

	local tabList = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, tabHolder)
	local tl2 = List(tabList, 12); tl2.FillDirection = Enum.FillDirection.Horizontal; tl2.HorizontalAlignment = Enum.HorizontalAlignment.Center; tl2.VerticalAlignment = Enum.VerticalAlignment.Center

	local content = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 60), Size = UDim2.new(1, -24, 1, -72), ZIndex = 2 }, main)
	local pages = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, content)

	local toggleGen = 0
	function Win:Toggle(v)
		if v == nil then v = not mainHolder.Visible end
		toggleGen += 1
		local gen = toggleGen
		if v then
			mainHolder.Position = UDim2.fromScale(.5, .48)
			mainHolder.Visible = true
			scale.Scale = .9
			blur.Enabled = true
			Tween(scale, .35, { Scale = 1 }, Enum.EasingStyle.Back)
			Tween(blur, .35, { Size = 14 })
			Tween(neonGlow, .45, { ImageTransparency = 0.35 }) -- Fade in neon glow
		else
			Tween(scale, .22, { Scale = .9 })
			Tween(blur, .22, { Size = 0 })
			Tween(neonGlow, .2, { ImageTransparency = 1 }) -- Fade out neon glow
			task.delay(.22, function()
				if gen == toggleGen then
					mainHolder.Visible = false
					if blur.Size < .1 then blur.Enabled = false end
				end
			end)
		end
	end
	
	Connect(UIS.InputBegan, function(i, gp)
		if gp or Library._listening then return end
		local key = Win.ToggleKey
		local mk = Library.Flags.__menukey
		if mk and Enum.KeyCode[mk] then key = Enum.KeyCode[mk] end
		if i.KeyCode == key then Win:Toggle() end
	end)

	local dragging, startPos, startFrame
	Connect(topBar.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, startPos, startFrame = true, i.Position, mainHolder.Position
		end
	end)
	Connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startPos
			mainHolder.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X, startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
		end
	end)
	Connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)

	function Win:Select(tab)
		for _, t in ipairs(Win.Tabs) do
			local on = t == tab
			t.Page.Visible = on
			Tween(t.Btn, .25, { BackgroundTransparency = on and 0 or 0.6, BackgroundColor3 = on and T.Element or T.Panel })
			Tween(t.Img, .2, { ImageColor3 = on and T.Accent or T.SubText })
			Tween(t.Fallback, .2, { TextColor3 = on and T.Accent or T.SubText })
			
			-- Lucide Icon Glow Spread
			Tween(t.Glow, .3, { 
				ImageTransparency = on and 0.2 or 1, 
				Size = on and UDim2.fromOffset(60, 60) or UDim2.fromOffset(30, 30) 
			})
			
			if on then
				Tween(t.BtnScale, .1, { Scale = 1.15 })
				task.delay(.1, function() Tween(t.BtnScale, .2, { Scale = 1 }, Enum.EasingStyle.Back) end)
			else
				Tween(t.BtnScale, .2, { Scale = 1 })
			end
		end
		Win.Current = tab
	end

	function Win:AddTab(name, icon)
		local Tab = { Name = name, Groups = { Left = 0, Right = 0 } }

		local btn = New("TextButton", {
			Text = "", AutoButtonColor = false, Size = UDim2.fromOffset(44, 44), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.6, BorderSizePixel = 0,
