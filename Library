        dpiScale = math.clamp(tonumber(scale) or 1, 0.2, 3)
        if Win.Visible then mainScale.Scale = dpiScale end
    end

    function Win:Toggle(state)
        if state == nil then state = not Win.Visible end
        Win.Visible = state
        if state then
            main.Visible = true
            mainScale.Scale = dpiScale * 0.96
            main.BackgroundTransparency = 1
            Tween(mainScale, 0.28, { Scale = dpiScale })
            Tween(main, 0.28, { BackgroundTransparency = T.Transparency })
            Tween(blurEffect, 0.3, { Size = 12 })
        else
            Tween(mainScale, 0.2, { Scale = dpiScale * 0.96 })
            Tween(main, 0.2, { BackgroundTransparency = 1 })
            Tween(blurEffect, 0.25, { Size = 0 })
            task.delay(0.22, function() if not Win.Visible then main.Visible = false end end)
        end
    end

    Connect(UIS.InputBegan, function(input, gameProcessed)
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode ~= Win.ToggleKey then return end
        if Library._listening then return end
        Win:Toggle()
    end)

    function Win:Select(tab)
        for _, t in ipairs(Win.Tabs) do
            local active = (t == tab)
            t.Page.Visible = active
            Tween(t.Btn, 0.18, { BackgroundColor3 = active and T.Group or T.Bg })
            Tween(t.Img, 0.18, { ImageColor3 = active and T.Text or T.SubText })
