            if resetText then refreshText() end
        end

        function obj:SetValue(v, silent)
            obj.Value = v
            Library.Flags[idx] = v
            refreshText()
            if not silent then emit(obj, o, v) end
            if idx == "MenuKeybind" and typeof(v) == "EnumItem" and v ~= Enum.KeyCode.Unknown then
                for _, w in ipairs(Library.Windows) do
                    if w.ToggleKey ~= nil then w.ToggleKey = v end
                    if w._win and w._win.ToggleKey ~= nil then w._win.ToggleKey = v end
