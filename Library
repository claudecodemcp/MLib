-------------------------------------------------
-- Theme
-------------------------------------------------
local Theme = {
    Background     = Color3.fromRGB(16, 16, 18),
    Secondary      = Color3.fromRGB(22, 22, 26),
    Tertiary       = Color3.fromRGB(32, 32, 38),
    Accent         = Color3.fromRGB(135, 100, 255),
    Text           = Color3.fromRGB(240, 240, 245),
    TextDim        = Color3.fromRGB(155, 155, 165),
    Outline        = Color3.fromRGB(50, 50, 60),
    ToggleOn       = Color3.fromRGB(135, 100, 255),
    ToggleOff      = Color3.fromRGB(55, 55, 65),
    SliderBg       = Color3.fromRGB(40, 40, 48),
