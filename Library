local TooltipFrame = New("TextLabel", {
	BackgroundColor3 = T.Element, TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 12,
	AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 24), Visible = false, ZIndex = 100, Parent = GuiParent()
