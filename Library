----------------------------------------------------------------------
--// Config System
----------------------------------------------------------------------
local fs = (writefile and readfile and isfolder and makefolder and listfiles and isfile)

function Library:SaveConfig(name)
	if not fs then return Library:Notify("Error", "Executor lacks filesystem functions.", 3) end
	if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
	local data = {}
	for k, v in pairs(self.Flags) do
		if typeof(v) == "Color3" then data[k] = {Type = "Color3", R = v.R, G = v.G, B = v.B}
		elseif typeof(v) == "table" then data[k] = {Type = "Table", Data = v}
		else data[k] = v end
	end
	writefile(self.ConfigFolder .. "/" .. name .. ".json", HttpService:JSONEncode(data))
	Library:Notify("Config", "Saved config: " .. name, 3)
end

function Library:LoadConfig(name)
	if not fs then return Library:Notify("Error", "Executor lacks filesystem functions.", 3) end
	local path = self.ConfigFolder .. "/" .. name .. ".json"
	if not isfile(path) then return Library:Notify("Config", "Config not found.", 3) end
	
	local ok, data = pcall(HttpService.JSONDecode, HttpService, readfile(path))
	if not ok then return end
	
	for k, v in pairs(data) do
		if self.Options[k] then
			local targetVal = v
			if type(v) == "table" and v.Type == "Color3" then targetVal = Color3.new(v.R, v.G, v.B)
			elseif type(v) == "table" and v.Type == "Table" then targetVal = v.Data end
			pcall(function() self.Options[k]:SetValue(targetVal) end)
		end
	end
	Library:Notify("Config", "Loaded config: " .. name, 3)
end

function Library:GetConfigs()
	if not fs then return {} end
	if not isfolder(self.ConfigFolder) then makefolder(self.ConfigFolder) end
	local list = {}
	for _, file in ipairs(listfiles(self.ConfigFolder)) do
		local name = file:match("([^/\\]+)%.json$")
		if name then table.insert(list, name) end
	end
	return list
end

----------------------------------------------------------------------
--// Search System
----------------------------------------------------------------------
local function UpdateSearch(text)
	text = text:lower()
	for _, win in pairs(Library.Windows) do
		for _, tab in ipairs(win.Tabs) do
			local tabVisible = false
			for _, group in pairs(tab.Groups) do
				local groupVisible = false
				for _, elem in ipairs(group.Elements) do
					local str = (elem.Option and elem.Option.Text) or elem.Text or ""
					if text == "" or str:lower():find(text) then elem.Holder.Visible = true; groupVisible = true else elem.Holder.Visible = false end
				end
				for _, dep in ipairs(group.DepBoxes) do
					local depVisible = false
					for _, elem in ipairs(dep.Elements) do
						local str = (elem.Option and elem.Option.Text) or elem.Text or ""
						if text ~= "" and str:lower():find(text) then elem.Holder.Visible = true; depVisible = true end
					end
					if text ~= "" then dep.Container.Visible = depVisible else dep:UpdateVisibility() end
				end
				group.Holder.Visible = groupVisible or text == ""
				if groupVisible then tabVisible = true end
			end
			tab.Page.Visible = tabVisible or (text == "" and win.Current == tab)
		end
	end
end

