	end)
	Connect(UserInputService.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag = false end end)

	-- Toggle Logic
	local tGen = 0
	function Win:Toggle(v)
		if v == nil then v = not main.Visible end
		tGen += 1; local g = tGen
		if v then
			main.Position = UDim2.fromScale(.5, .48); main.Visible = true; scale.Scale = .95; blur.Enabled = true
			Tween(scale, .4, { Scale = 1 }, Enum.EasingStyle.Back); Tween(blur, .4, { Size = 16 })
			PlaySound("6895079853", 0.4) -- Open sound
		else
			Tween(scale, .25, { Scale = .95 }); Tween(blur, .25, { Size = 0 })
			task.delay(.25, function() if g == tGen then main.Visible = false; blur.Enabled = false end end)
		end
	end
	Connect(UserInputService.InputBegan, function(i, gp) if not gp and not Library._listening and i.KeyCode == Win.ToggleKey then Win:Toggle() end end)
	Win:Toggle(true)

	function Win:Select(tab)
		for _, t in ipairs(Win.Tabs) do
			local on = t == tab
			t.Page.Visible = on
			Tween(t.Btn, .25, { BackgroundColor3 = on and T.Element or T.Panel, BackgroundTransparency = on and 0 or 0.3 })
			Tween(t.Img, .25, { ImageColor3 = on and T.Text or T.SubText })
			Tween(t.Scale, .3, { Scale = on and 1.1 or 1 }, Enum.EasingStyle.Back)
		end
		Win.Current = tab
	end

	function Win:AddTab(name, icon)
		local Tab = { Name = name, Groups = {} }
		local btn = New("TextButton", { Text = "", Size = UDim2.fromOffset(46, 46), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.3, LayoutOrder = #Win.Tabs + 1 }, TabList)
		Corner(btn, 12); Stroke(btn, T.Stroke, 0.5); local tScale = New("UIScale", { Scale = 1 }, btn)
		local img = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(22, 22), ImageColor3 = T.SubText }, btn)
		if icon then Library:ApplyIcon(img, icon) end
		
		Connect(btn.MouseEnter, function() if Win.Current ~= Tab then Tween(tScale, .2, { Scale = 1.05 }, Enum.EasingStyle.Back) end end)
		Connect(btn.MouseLeave, function() if Win.Current ~= Tab then Tween(tScale, .2, { Scale = 1 }) end end)

		local page = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, pages)
		local function col(pos, size)
			local s = New("ScrollingFrame", { BackgroundTransparency = 1, Position = pos, Size = size, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, page)
			List(s, 10); Pad(s, 0, 0, 0, 12)
			return s
		end
		Tab.Cols = { Left = col(UDim2.fromOffset(0, 0), UDim2.new(.5, -5, 1, 0)), Right = col(UDim2.new(.5, 5, 0, 0), UDim2.new(.5, -5, 1, 0)) }
		Tab.Btn, Tab.Img, Tab.Scale, Tab.Page = btn, img, tScale, page
		
		Connect(btn.MouseButton1Click, function() Win:Select(Tab) end)
		table.insert(Win.Tabs, Tab)
		if #Win.Tabs == 1 then Win:Select(Tab) end

		function Tab:AddGroup(title, icon, side)
			side = side or "Left"
			local Group = { Elements = {}, DepBoxes = {} }
			local box = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Group, LayoutOrder = #Group.Elements + 1 }, Tab.Cols[side])
			Corner(box, 8); Stroke(box, T.Stroke, .8)
			
			local top = New("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, box)
			local gIcon = New("ImageLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(16, 16), ImageColor3 = T.SubText }, top)
			if icon then Library:ApplyIcon(gIcon, icon) end
			local hdr = Label(top, title, 14, T.Text, T.FontBold); hdr.Position = UDim2.fromOffset(36, 0); hdr.Size = UDim2.new(1, -48, 1, 0)
			New("Frame", { Position = UDim2.new(0, 12, 0, 39), Size = UDim2.new(1, -24, 0, 1), BackgroundColor3 = T.Stroke, BackgroundTransparency = 0.5 }, box)
			
			local holder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, box)
			List(holder, 2); Pad(holder, 8, 8, 8, 10)
			Group.Holder = box; Group.Container = holder
			local function reg(idx, obj) if idx then Library.Options[idx] = obj; Library.Flags[idx] = obj.Value end end
			local function fire(cb, ...) if cb then task.spawn(cb, ...) end end

			-- LABEL
			function Group:AddLabel(text)
				local l = Label(holder, text, 13, T.SubText)
				l.Size = UDim2.new(1, 0, 0, 0); l.AutomaticSize = Enum.AutomaticSize.Y; l.TextWrapped = true
				Pad(l, 6, 4, 6, 4); table.insert(Group.Elements, { Text = text, Holder = l })
				return { SetText = function(_, t) l.Text = t end }
			end

			-- BUTTON
			function Group:AddButton(text, callback)
				local b = New("TextButton", { Text = text, Font = T.Font, TextSize = 14, TextColor3 = T.Text, Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element }, holder)
				Corner(b, 6); Stroke(b, T.Stroke, .8)
				Connect(b.MouseEnter, function() Tween(b, .2, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
				Connect(b.MouseLeave, function() Tween(b, .2, { BackgroundColor3 = T.Element }) end)
				Connect(b.MouseButton1Click, function() PlaySound("6895079853", 0.2); fire(callback) end)
				table.insert(Group.Elements, { Text = text, Holder = b }); return b
			end

			-- TOGGLE
			function Group:AddToggle(idx, o)
				local obj = { Value = o.Default or false, Type = "Toggle" }
				local row = New("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.6 }, holder)
				Corner(row, 6)
				Connect(row.MouseEnter, function() Tween(row, .2, { BackgroundTransparency = 0.3 }) end)
				Connect(row.MouseLeave, function() Tween(row, .2, { BackgroundTransparency = 0.6 }) end)
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 0); l.Size = UDim2.new(1, -50, 1, 0)
				
				local track = New("Frame", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -10, .5, 0), Size = UDim2.fromOffset(28, 28), BackgroundColor3 = T.Stroke }, row)
				Corner(track, 14)
				local knob = New("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.35, .5), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = T.SubText }, track)
				Corner(knob, 8)
				
				function obj:SetValue(v, silent)
					obj.Value = v and true or false; Library.Flags[idx] = obj.Value
					Tween(track, .25, { BackgroundColor3 = obj.Value and T.Accent or T.Stroke })
					Tween(knob, .3, { Position = UDim2.fromScale(obj.Value and .65 or .35, .5), BackgroundColor3 = obj.Value and Color3.new(1,1,1) or T.SubText }, Enum.EasingStyle.Back)
					if not silent then PlaySound("131935970184832", 0.2); fire(o.Callback, obj.Value) end
					Library.UpdateDepBoxes()
				end
				Connect(row.MouseButton1Click, function() obj:SetValue(not obj.Value) end)
				AddTooltip(row, o.Tooltip); reg(idx, obj); obj:SetValue(obj.Value, true)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row }); return obj
			end

			-- SLIDER (with right-click to type)
			function Group:AddSlider(idx, o)
				local min, max, rnd = o.Min or 0, o.Max or 100, o.Rounding or 0
				local obj = { Value = math.clamp(o.Default or min, min, max), Type = "Slider" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.Element, BackgroundTransparency = 0.6 }, holder)
				Corner(row, 6)
				
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 6); l.Size = UDim2.new(.7, 0, 0, 20)
				local val = Label(row, "", 13, T.SubText); val.AnchorPoint = Vector2.new(1, 0); val.Position = UDim2.new(1, -10, 0, 6)
				val.Size = UDim2.new(.3, 0, 0, 20); val.TextXAlignment = Enum.TextXAlignment.Right
				
				local bar = New("TextButton", { Text = "", Position = UDim2.fromOffset(10, 30), Size = UDim2.new(1, -20, 0, 4), BackgroundColor3 = T.Stroke }, row)
				Corner(bar, 2)
				local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Accent }, bar); Corner(fill, 2)
				local knob = New("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = T.Accent }, bar); Corner(knob, 6)
				
				function obj:SetValue(v, silent)
					v = math.clamp(Round(v, rnd), min, max)
					obj.Value = v; Library.Flags[idx] = v
					local a = (v - min) / (max - min)
					Tween(fill, .1, { Size = UDim2.fromScale(a, 1) }); Tween(knob, .1, { Position = UDim2.new(a, 0, .5, 0) })
					val.Text = tostring(v) .. (o.Suffix or "")
					if not silent then fire(o.Callback, v) end
				end
				
				-- Manual Input Logic
				local inputBox = New("TextBox", { BackgroundTransparency = 1, Size = UDim2.fromScale(1,1), Text = "", Visible = false, TextColor3 = T.Text, Font = T.Font, TextSize = 13 }, val)
				Connect(val.InputBegan, function(i) 
					if i.UserInputType == Enum.UserInputType.MouseButton2 then 
						val.Visible = false; inputBox.Visible = true; inputBox.Text = tostring(obj.Value); inputBox:CaptureFocus() 
					end 
				end)
				Connect(inputBox.FocusLost, function()
					inputBox.Visible = false; val.Visible = true
					local num = tonumber(inputBox.Text)
					if num then obj:SetValue(num) end
				end)

				local dragging = false
				local function upd(x)
					local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
					obj:SetValue(min + (max - min) * a)
				end
				Connect(bar.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i.Position.X) end end)
				Connect(UserInputService.InputChanged, function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end end)
				Connect(UserInputService.InputEnded, function() dragging = false end)
				AddTooltip(row, o.Tooltip); reg(idx, obj); obj:SetValue(obj.Value, true)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row }); return obj
			end

			-- DROPDOWN
			function Group:AddDropdown(idx, o)
				local values = o.Values or {}
				local obj = { Value = o.Multi and {} or (o.Default or values[1]), Type = "Dropdown", Values = values }
				if o.Multi and type(o.Default) == "table" then for _, v in ipairs(o.Default) do obj.Value[v] = true end end
				
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, holder)
				List(row, 4)
				
				local head = New("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Element }, row)
				Corner(head, 6); Stroke(head, T.Stroke, .8)
				Connect(head.MouseEnter, function() Tween(head, .2, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
				Connect(head.MouseLeave, function() Tween(head, .2, { BackgroundColor3 = T.Element }) end)
				
				local l = Label(head, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 0); l.Size = UDim2.new(.5, 0, 1, 0)
				local cur = Label(head, "", 13, T.SubText); cur.AnchorPoint = Vector2.new(1, 0); cur.Position = UDim2.new(1, -36, 0, 0)
				cur.Size = UDim2.new(.5, -40, 1, 0); cur.TextXAlignment = Enum.TextXAlignment.Right; cur.TextTruncate = Enum.TextTruncate.AtEnd
				
				local arrow = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -10, .5, 0), Size = UDim2.fromOffset(16, 16), ImageColor3 = T.SubText }, head)
				Library:ApplyIcon(arrow, "chevron-down")
				
				local list = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Element, Visible = false, LayoutOrder = 2 }, row)
				Corner(list, 6); List(list, 2); Pad(list, 4, 4, 4, 4); Stroke(list, T.Stroke, .8)
				local listScale = New("UIScale", { Scale = 1 }, list)
				
				local items = {}
				local dstate = { open = false }
				function dstate.close() dstate.open = false; list.Visible = false; Tween(arrow, .2, { Rotation = 0 }) end
				function dstate.hitTest(pos) return InRect(head, pos) or (dstate.open and InRect(list, pos)) or (items[pos] ~= nil) end
				table.insert(Library._dropdowns, dstate)

				local function text()
					if o.Multi then
						local t = {}
						for _, v in ipairs(obj.Values) do if obj.Value[v] then table.insert(t, v) end end
						return #t > 0 and table.concat(t, ", ") or "None"
					end
					return tostring(obj.Value or "None")
				end
				
				local function refresh()
					cur.Text = text(); Library.Flags[idx] = obj.Value
					for v, b in pairs(items) do
						local on = o.Multi and obj.Value[v] or obj.Value == v
						Tween(b, .2, { TextColor3 = on and T.Accent or T.SubText })
					end
					Library.UpdateDepBoxes()
				end

				local function build()
					for _, b in pairs(items) do b:Destroy() end
					items = {}
					for i, v in ipairs(obj.Values) do
						local b = New("TextButton", { Text = v, Font = T.Font, TextSize = 13, TextColor3 = T.SubText, Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = T.Element, BackgroundTransparency = 1, LayoutOrder = i }, list)
						Corner(b, 4)
						Connect(b.MouseEnter, function() Tween(b, .15, { BackgroundTransparency = .85, TextColor3 = T.Text }) end)
						Connect(b.MouseLeave, function() Tween(b, .15, { BackgroundTransparency = 1, TextColor3 = obj.Value == v and T.Accent or T.SubText }) end)
						Connect(b.MouseButton1Click, function()
							if o.Multi then obj.Value[v] = not obj.Value[v] or nil else obj.Value = v end
							refresh(); fire(o.Callback, obj.Value)
						end)
						items[v] = b
					end
					refresh()
				end
				
				function obj:SetValues(v) obj.Values = v; build() end
				function obj:SetValue(v, silent)
					if o.Multi then
						obj.Value = {}
						for k, on in pairs(type(v) == "table" and v or {}) do if on then obj.Value[type(k) == "number" and on or k] = true end end
					else obj.Value = v end
					refresh(); if not silent then fire(o.Callback, obj.Value) end
				end
				
				Connect(head.MouseButton1Click, function()
					if dstate.open then dstate.close() else
						for _, d in ipairs(Library._dropdowns) do if d ~= dstate then d.close() end end
						dstate.open = true; list.Visible = true; Tween(arrow, .2, { Rotation = 180 })
						listScale.Scale = .95; Tween(listScale, .2, { Scale = 1 }, Enum.EasingStyle.Quint)
					end
				end)
				
				AddTooltip(head, o.Tooltip)
				build(); reg(idx, obj)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end
			
			-- KEYBIND
			function Group:AddKeybind(idx, o)
				local obj = { Value = o.Default or "None", Mode = o.Mode or "Toggle", Type = "Keybind" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.6 }, holder)
				Corner(row, 6)
				
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 0); l.Size = UDim2.new(1, -100, 1, 0)
				
				local b = New("TextButton", { Text = obj.Value, Font = T.Font, TextSize = 13, TextColor3 = T.Text, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(80, 24), BackgroundColor3 = T.Stroke }, row)
				Corner(b, 4)
				
				local listening = false
				function obj:SetValue(v, silent)
					obj.Value = tostring(v); b.Text = obj.Value; Library.Flags[idx] = obj.Value
					if not silent then fire(o.Callback, obj.Value) end
				end
				
				Connect(b.MouseButton1Click, function() if not listening then listening = true; Library._listening = true; b.Text = "..." end end)
				Connect(b.MouseButton2Click, function()
					local menu = OpenContextMenu(b, UDim2.fromOffset(100, 70))
					for _, m in ipairs({"Toggle", "Hold", "Always"}) do
						local mb = New("TextButton", { Text = m, Size = UDim2.new(1,0,0,20), BackgroundTransparency = 1, TextColor3 = m == obj.Mode and T.Accent or T.SubText, Font = T.Font, TextSize = 13 }, menu)
						Connect(mb.MouseButton1Click, function() obj.Mode = m; menu:Destroy() end)
					end
				end)

				Connect(UserInputService.InputBegan, function(i, gp)
					if listening and i.UserInputType == Enum.UserInputType.Keyboard then
						listening = false; Library._listening = false; obj:SetValue(i.KeyCode == Enum.KeyCode.Escape and "None" or i.KeyCode.Name)
					elseif listening and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
						if not InRect(b, i.Position) then listening = false; Library._listening = false; obj:SetValue(obj.Value) end
					elseif not listening and not gp and i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode.Name == obj.Value then
						fire(o.Callback, obj.Value)
					end
				end)
				
				reg(idx, obj)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end

			-- DEPENDENCY BOX
			function Group:AddDependencyBox()
				local depContainer = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false }, holder)
				List(depContainer, 2)
				local dep = { Elements = {}, Container = depContainer, Dependencies = {} }
				
				function dep:SetupDependencies(deps) dep.Dependencies = deps; dep:UpdateVisibility(); table.insert(Library.DepBoxes, dep) end
				function dep:UpdateVisibility()
					local show = true
					for _, data in ipairs(dep.Dependencies) do if not data[1] or data[1].Value ~= data[2] then show = false break end end
					depContainer.Visible = show
				end
				
				table.insert(Group.DepBoxes, dep)
				local DepGroup = { Elements = dep.Elements, Container = depContainer, Holder = depContainer }
				setmetatable(DepGroup, { __index = Group })
				return DepGroup
			end

			-- COLOR PICKER
			function Group:AddColorPicker(idx, o)
				local obj = { Value = o.Default or Color3.new(1,1,1), Type = "ColorPicker" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.6 }, holder)
				Corner(row, 6)
				
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 0); l.Size = UDim2.new(1, -50, 1, 0)
				local cBtn = New("TextButton", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = obj.Value }, row)
				Corner(cBtn, 4); Stroke(cBtn, Color3.new(0,0,0), .5)
				
				Connect(cBtn.MouseButton1Click, function()
					local menu = OpenContextMenu(cBtn, UDim2.fromOffset(160, 160))
					local satMap = New("TextButton", { Size = UDim2.new(1, 0, 0, 120), BackgroundColor3 = obj.Value }, menu); Corner(satMap, 4)
					New("UIGradient", { Color = ColorSequence.new(Color3.new(1,1,1), obj.Value), Transparency = NumberSequence.new(0, 1) }, satMap)
					
					local hueBar = New("TextButton", { Size = UDim2.new(1, 0, 0, 12), Position = UDim2.new(0, 0, 0, 124) }, menu); Corner(hueBar, 2)
					New("UIGradient", { Color = ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.new(1,0,0)),ColorSequenceKeypoint.new(0.16,Color3.new(1,1,0)),ColorSequenceKeypoint.new(0.33,Color3.new(0,1,0)),ColorSequenceKeypoint.new(0.5,Color3.new(0,1,1)),ColorSequenceKeypoint.new(0.66,Color3.new(0,0,1)),ColorSequenceKeypoint.new(0.83,Color3.new(1,0,1)),ColorSequenceKeypoint.new(1,Color3.new(1,0,0))} }, hueBar)
					
					local hexBox = New("TextBox", { Size = UDim2.new(1, 0, 0, 20), Position = UDim2.new(0, 0, 0, 140), PlaceholderText = "Hex (e.g. FF0000)", Text = "", BackgroundColor3 = T.Bg, TextColor3 = T.Text, Font = T.Font, TextSize = 12 }, menu)
					Corner(hexBox, 4); Pad(hexBox, 6, 0, 6, 0)
					
					local isDraggingHue, isDraggingSat = false, false
					Connect(hueBar.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingHue = true end end)
					Connect(satMap.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 then isDraggingSat = true end end)
					Connect(UserInputService.InputEnded, function() isDraggingHue = false; isDraggingSat = false end)
					
					Connect(UserInputService.InputChanged, function(i)
						if isDraggingHue then
							local m = math.clamp((i.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
							local h, s, v = obj.Value:ToHSV()
							obj.Value = Color3.fromHSV(m, s, v); cBtn.BackgroundColor3 = obj.Value; satMap.BackgroundColor3 = obj.Value; fire(o.Callback, obj.Value)
						elseif isDraggingSat then
							local x = math.clamp((i.Position.X - satMap.AbsolutePosition.X) / satMap.AbsoluteSize.X, 0, 1)
							local y = math.clamp(1 - ((i.Position.Y - satMap.AbsolutePosition.Y) / satMap.AbsoluteSize.Y), 0, 1)
							local h = obj.Value:ToHSV()
							obj.Value = Color3.fromHSV(h, x, y); cBtn.BackgroundColor3 = obj.Value; fire(o.Callback, obj.Value)
						end
					end)
					
					Connect(hexBox.FocusLost, function(enter)
						if enter then
							local ok, c = pcall(Color3.fromHex, hexBox.Text)
							if ok and c then obj.Value = c; cBtn.BackgroundColor3 = c; fire(o.Callback, c) end
						end
					end)
				end)
				
				AddTooltip(row, o.Tooltip); reg(idx, obj)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row }); return obj
			end

			return Group
		end
		return Tab
	end
	
	table.insert(Library.Windows, Win)
	return Win
end

function Library.UpdateDepBoxes()
	for _, dep in ipairs(Library.DepBoxes) do
		if dep.Container and dep.Container.Parent then dep:UpdateVisibility() end
	end
end

if not Library._dropdownListener then
	Library._dropdownListener = UserInputService.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		for _, d in ipairs(Library._dropdowns) do
			if d.open and not d.hitTest(input.Position) then d.close() end
		end
	end)
end

return Library
