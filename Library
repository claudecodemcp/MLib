local Players       = game:GetService("Players")
local TweenService  = game:GetService("TweenService")
local UIS           = game:GetService("UserInputService")
local Lighting      = game:GetService("Lighting")

local Library = {
	Flags = {}, Options = {}, Windows = {}, Connections = {},
	_listening = false,
	_dropdowns = {},
	Theme = {
		Bg        = Color3.fromRGB(20, 20, 20),
		Panel     = Color3.fromRGB(30, 30, 30),
		Group     = Color3.fromRGB(35, 35, 35),
		Element   = Color3.fromRGB(45, 45, 45),
		Stroke    = Color3.fromRGB(55, 55, 55),
		Text      = Color3.fromRGB(255, 255, 255),
		SubText   = Color3.fromRGB(170, 170, 170),
		Accent    = Color3.fromRGB(255, 255, 255),
		Transparency = 0.05,
	},
	ConfigFolder = "UILib/configs",
}
local T = Library.Theme

local function New(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end
local function Corner(o, r) return New("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function Stroke(o, c, t) return New("UIStroke", { Color = c or T.Stroke, Transparency = t or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o) end
local function Pad(o, l, t, r, b) return New("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b) }, o) end
local function List(o, pad) return New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, pad or 0) }, o) end
local function Tween(o, t, p, style) TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out), p):Play() end
local function Connect(sig, fn) local c = sig:Connect(fn); table.insert(Library.Connections, c); return c end
local function Label(parent, text, size, color, font)
	return New("TextLabel", { BackgroundTransparency = 1, Text = text, TextSize = size or 14, TextColor3 = color or T.Text, Font = font or Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left }, parent)
end
local function GuiParent()
	local ok, ui = pcall(function() return gethui and gethui() end)
	if ok and ui then return ui end
	local ok2 = pcall(function() return game:GetService("CoreGui").Name end)
	if ok2 then return game:GetService("CoreGui") end
	return Players.LocalPlayer:WaitForChild("PlayerGui")
end
local function InRect(gui, pos)
	local a, s = gui.AbsolutePosition, gui.AbsoluteSize
	return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end
local function RowHover(row)
	Connect(row.MouseEnter, function() Tween(row, .15, { BackgroundColor3 = Color3.fromRGB(55, 55, 55) }) end)
	Connect(row.MouseLeave, function() Tween(row, .15, { BackgroundColor3 = T.Group }) end)
end

--// Icons \\--
local IconLib
pcall(function() IconLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"))() end)
function Library:ApplyIcon(img, name)
	if type(name) == "number" then name = "rbxassetid://" .. name end
	if type(name) == "string" and (name:match("^rbxassetid://") or name:match("^rbxasset://")) then
		img.Image = name; img.Visible = true; return true
	end
	if IconLib and type(name) == "string" then
		name = name:gsub("^lucide[%-:]", "")
		local ok, res = pcall(function() return IconLib.GetAsset(name) end)
		if ok and res then
			img.Image = res.Url; img.ImageRectSize = res.ImageRectSize; img.ImageRectOffset = res.ImageRectOffset; img.Visible = true; return true
		end
	end
	img.Visible = false
	return false
end

--// Window Creation \\--
function Library:AddWindow(cfg)
	cfg = cfg or {}
	local tk = cfg.ToggleKey or Enum.KeyCode.RightShift
	if type(tk) == "string" then tk = Enum.KeyCode[tk] or Enum.KeyCode.RightShift end
	local Win = { Tabs = {}, Title = cfg.Title or "Script", ToggleKey = tk }

	local gui = New("ScreenGui", { Name = "UILib", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100, IgnoreGuiInset = true }, GuiParent())
	Win.Gui = gui

	local main = New("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
		Size = UDim2.fromOffset(700, 500),
		BackgroundColor3 = T.Bg, BackgroundTransparency = T.Transparency, BorderSizePixel = 0
	}, gui)
	Corner(main, 8); Stroke(main, T.Stroke, .6)
	local scale = New("UIScale", { Scale = 1 }, main)
	Win.Main = main

	--// Top Bar (Outside the main dark box) \\--
	local topBar = New("Frame", {
		Size = UDim2.new(1, 0, 0, 50), Position = UDim2.fromOffset(0, -60), BackgroundTransparency = 1
	}, main)

	-- Title Pill
	local titlePill = New("Frame", { Size = UDim2.fromOffset(140, 44), BackgroundColor3 = T.Group }, topBar)
	Corner(titlePill, 6); Stroke(titlePill, T.Stroke, .6)
	local titleTxt = Label(titlePill, Win.Title, 16, T.Text, Enum.Font.GothamBold)
	titleTxt.Size = UDim2.fromScale(1, 1); titleTxt.TextXAlignment = Enum.TextXAlignment.Center

	-- Divider
	New("Frame", { Position = UDim2.fromOffset(150, 10), Size = UDim2.fromOffset(2, 24), BackgroundColor3 = T.Stroke }, topBar)

	-- Tabs Container
	local tabList = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(165, 0), Size = UDim2.new(1, -300, 1, 0) }, topBar)
	local tl = List(tabList, 6); tl.FillDirection = Enum.FillDirection.Horizontal; tl.VerticalAlignment = Enum.VerticalAlignment.Center

	-- Right Icons (Bell + Close)
	local rightIcons = New("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(90, 44), BackgroundTransparency = 1 }, topBar)
	local rl = List(rightIcons, 6); rl.FillDirection = Enum.FillDirection.Horizontal; rl.HorizontalAlignment = Enum.HorizontalAlignment.Right; rl.VerticalAlignment = Enum.VerticalAlignment.Center

	-- Bell
	local bellBlock = New("Frame", { Size = UDim2.fromOffset(42, 42), BackgroundColor3 = T.Group }, rightIcons)
	Corner(bellBlock, 6); Stroke(bellBlock, T.Stroke, .6)
	local bellImg = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5,.5), Position = UDim2.fromScale(.5,.5), Size = UDim2.fromOffset(20, 20), ImageColor3 = T.Text }, bellBlock)
	Library:ApplyIcon(bellImg, "bell")

	-- Close Button
	local closeBtn = New("TextButton", { Size = UDim2.fromOffset(42, 42), BackgroundColor3 = T.Group, Text = "" }, rightIcons)
	Corner(closeBtn, 6); Stroke(closeBtn, T.Stroke, .6)
	local closeImg = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5,.5), Position = UDim2.fromScale(.5,.5), Size = UDim2.fromOffset(20, 20), ImageColor3 = T.SubText }, closeBtn)
	Library:ApplyIcon(closeImg, "x")
	Connect(closeBtn.MouseButton1Click, function() Win:Toggle(false) end)

	--// Content \\--
	local content = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 1, -24) }, main)
	local pages = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, content)

	-- Drag Logic
	local dragging, startPos, startFrame
	Connect(topBar.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, startPos, startFrame = true, i.Position, main.Position
		end
	end)
	Connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startPos
			main.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X, startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
		end
	end)
	Connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)

	-- Toggle Logic
	function Win:Toggle(v)
		if v == nil then v = not main.Visible end
		main.Visible = v
	end
	Connect(UIS.InputBegan, function(i, gp)
		if gp or Library._listening then return end
		if i.KeyCode == Win.ToggleKey then Win:Toggle() end
	end)

	function Win:Select(tab)
		for _, t in ipairs(Win.Tabs) do
			local on = t == tab
			t.Page.Visible = on
			Tween(t.Btn, .2, { BackgroundColor3 = on and T.Group or T.Bg })
			Tween(t.Img, .2, { ImageColor3 = on and T.Text or T.SubText })
		end
		Win.Current = tab
	end

	function Win:AddTab(name, icon)
		local Tab = { Name = name, Groups = {} }
		
		local btn = New("TextButton", { Text = "", Size = UDim2.fromOffset(42, 42), BackgroundColor3 = T.Bg, LayoutOrder = #Win.Tabs + 1 }, tabList)
		Corner(btn, 6); Stroke(btn, T.Stroke, .4)
		
		local img = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(20, 20), ImageColor3 = T.SubText }, btn)
		if icon then Library:ApplyIcon(img, icon) end

		local page = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, pages)
		
		local function column(pos, size)
			local s = New("ScrollingFrame", { BackgroundTransparency = 1, Position = pos, Size = size, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, page)
			List(s, 10); Pad(s, 0, 0, 0, 12)
			return s
		end
		
		Tab.Cols = { Left = column(UDim2.fromOffset(0, 0), UDim2.new(.5, -5, 1, 0)), Right = column(UDim2.new(.5, 5, 0, 0), UDim2.new(.5, -5, 1, 0)) }
		Tab.Btn, Tab.Img, Tab.Page = btn, img, page
		
		Connect(btn.MouseButton1Click, function() Win:Select(Tab) end)
		table.insert(Win.Tabs, Tab)
		if #Win.Tabs == 1 then Win:Select(Tab) end

		function Tab:AddGroup(title, side)
			side = side or "Left"
			local Group = {}
			-- Exact flat dark look from screenshot
			local box = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Group, LayoutOrder = #Group.Elements + 1 }, Tab.Cols[side])
			Corner(box, 6)
			
			local topGrp = New("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, box)
			local hdr = Label(topGrp, title, 16, T.Text, Enum.Font.GothamMedium)
			hdr.Position = UDim2.fromOffset(12, 0); hdr.Size = UDim2.new(1, -24, 1, 0)
			
			-- Inner holder for elements (very tight padding, like screenshot)
			local holder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, box)
			List(holder, 2); Pad(holder, 6, 0, 6, 10)
			Group.Holder = box; Group.Container = holder

			local function reg(idx, obj) if idx then Library.Options[idx] = obj; Library.Flags[idx] = obj.Value end end
			local function fire(cb, ...) if cb then task.spawn(cb, ...) end end

			-- LABEL
			function Group:AddLabel(text)
				local l = Label(holder, text, 15, T.Text)
				l.Size = UDim2.new(1, 0, 0, 0); l.AutomaticSize = Enum.AutomaticSize.Y; l.TextWrapped = true
				Pad(l, 6, 6, 6, 6)
				return { SetText = function(_, t) l.Text = t end }
			end

			-- BUTTON
			function Group:AddButton(text, callback)
				local b = New("TextButton", { Text = text, Font = Enum.Font.GothamMedium, TextSize = 15, TextColor3 = T.Text, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Group, BackgroundTransparency = 0.4 }, holder)
				Corner(b, 4)
				Connect(b.MouseEnter, function() Tween(b, .15, { BackgroundColor3 = Color3.fromRGB(60, 60, 60) }) end)
				Connect(b.MouseLeave, function() Tween(b, .15, { BackgroundColor3 = T.Group, BackgroundTransparency = 0.4 }) end)
				Connect(b.MouseButton1Click, function() fire(callback) end)
				return b
			end

			-- TOGGLE (Pill track, white circle)
			function Group:AddToggle(idx, o)
				local obj = { Value = o.Default or false, Type = "Toggle" }
				local row = New("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Group, BackgroundTransparency = 1 }, holder)
				RowHover(row)
				local l = Label(row, o.Text or idx, 15, T.Text); l.Position = UDim2.fromOffset(8, 0); l.Size = UDim2.new(1, -50, 1, 0)
				
				-- Exact pill toggle from screenshot
				local track = New("Frame", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(32, 20), BackgroundColor3 = Color3.fromRGB(10,10,10) }, row)
				Corner(track, 10)
				local knob = New("Frame", { AnchorPoint = Vector2.new(0, .5), Position = UDim2.fromOffset(2, 0), Size = UDim2.fromOffset(16, 16), BackgroundColor3 = Color3.fromRGB(80,80,80) }, track)
				Corner(knob, 8)
				
				function obj:SetValue(v, silent)
					obj.Value = v and true or false
					Library.Flags[idx] = obj.Value
					if obj.Value then
						Tween(knob, .2, { Position = UDim2.fromOffset(14, 0), BackgroundColor3 = T.Accent }, Enum.EasingStyle.Back)
					else
						Tween(knob, .2, { Position = UDim2.fromOffset(2, 0), BackgroundColor3 = Color3.fromRGB(80,80,80) }, Enum.EasingStyle.Back)
					end
					if not silent then fire(o.Callback, obj.Value) end
				end
				Connect(row.MouseButton1Click, function() obj:SetValue(not obj.Value) end)
				reg(idx, obj); obj:SetValue(obj.Value, true)
				return obj
			end

			-- SLIDER (Top text, value right, thin bar below)
			function Group:AddSlider(idx, o)
				local min, max, rnd = o.Min or 0, o.Max or 100, o.Rounding or 0
				local obj = { Value = math.clamp(o.Default or min, min, max), Type = "Slider" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundColor3 = T.Group, BackgroundTransparency = 1 }, holder)
				RowHover(row)
				
				local l = Label(row, o.Text or idx, 15, T.Text); l.Position = UDim2.fromOffset(8, 6); l.Size = UDim2.new(.7, 0, 0, 20)
				local val = Label(row, "", 15, T.Text); val.AnchorPoint = Vector2.new(1, 0); val.Position = UDim2.new(1, -8, 0, 6)
				val.Size = UDim2.new(.3, 0, 0, 20); val.TextXAlignment = Enum.TextXAlignment.Right
				
				local bar = New("TextButton", { Text = "", Position = UDim2.fromOffset(8, 32), Size = UDim2.new(1, -16, 0, 4), BackgroundColor3 = Color3.fromRGB(10,10,10) }, row)
				Corner(bar, 2)
				local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Accent }, bar); Corner(fill, 2)
				local knob = New("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = T.Accent }, bar); Corner(knob, 6)
				
				function obj:SetValue(v, silent)
					local m = 10 ^ rnd
					v = math.clamp(math.floor(v * m + .5) / m, min, max)
					obj.Value = v; Library.Flags[idx] = v
					local a = (v - min) / (max - min)
					Tween(fill, .1, { Size = UDim2.fromScale(a, 1) }); Tween(knob, .1, { Position = UDim2.new(a, 0, .5, 0) })
					val.Text = tostring(v) .. (o.Suffix or "")
					if not silent then fire(o.Callback, v) end
				end
				local dragging = false
				local function upd(x)
					local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
					obj:SetValue(min + (max - min) * a)
				end
				Connect(bar.InputBegan, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i.Position.X) end
				end)
				Connect(UIS.InputChanged, function(i)
					if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
				end)
				Connect(UIS.InputEnded, function() dragging = false end)
				reg(idx, obj); obj:SetValue(obj.Value, true)
				return obj
			end

			-- DROPDOWN
			function Group:AddDropdown(idx, o)
				local values = o.Values or {}
				local obj = { Value = o.Multi and {} or (o.Default or values[1]), Type = "Dropdown", Values = values }
				if o.Multi and type(o.Default) == "table" then for _, v in ipairs(o.Default) do obj.Value[v] = true end end
				
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, holder)
				List(row, 2)
				
				local head = New("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Group }, row)
				Corner(head, 4)
				Connect(head.MouseEnter, function() Tween(head, .15, { BackgroundColor3 = Color3.fromRGB(55, 55, 55) }) end)
				Connect(head.MouseLeave, function() Tween(head, .15, { BackgroundColor3 = T.Group }) end)
				
				local l = Label(head, o.Text or idx, 15, T.Text); l.Position = UDim2.fromOffset(8, 0); l.Size = UDim2.new(.5, 0, 1, 0)
				local cur = Label(head, "", 14, T.SubText); cur.AnchorPoint = Vector2.new(1, 0); cur.Position = UDim2.new(1, -32, 0, 0)
				cur.Size = UDim2.new(.5, -40, 1, 0); cur.TextXAlignment = Enum.TextXAlignment.Right; cur.TextTruncate = Enum.TextTruncate.AtEnd
				
				local arrow = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -10, .5, 0), Size = UDim2.fromOffset(16, 16), ImageColor3 = T.SubText }, head)
				Library:ApplyIcon(arrow, "chevron-down")
				
				local list = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = Color3.fromRGB(30,30,30), Visible = false, LayoutOrder = 2 }, row)
				Corner(list, 4); List(list, 2); Pad(list, 4, 4, 4, 4)
				local listScale = New("UIScale", { Scale = 1 }, list)
				
				local items = {}
				local dstate = { open = false }
				function dstate.close() dstate.open = false; list.Visible = false; Tween(arrow, .2, { Rotation = 0 }) end
				function dstate.hitTest(pos) return InRect(head, pos) or (dstate.open and InRect(list, pos)) or (items[pos] ~= nil) end
				table.insert(Library._dropdowns, dstate)

				local function text()
					if o.Multi then
						local t = {}
						for _, v in ipairs(obj.Values) do if obj.Value[v] then table.insert(t, v) end end
						return #t > 0 and table.concat(t, ", ") or "None"
					end
					return tostring(obj.Value or "None")
				end
				
				local function refresh()
					cur.Text = text(); Library.Flags[idx] = obj.Value
					for v, b in pairs(items) do
						local on = o.Multi and obj.Value[v] or obj.Value == v
						Tween(b, .2, { TextColor3 = on and T.Accent or T.SubText })
					end
				end

				local function build()
					for _, b in pairs(items) do b:Destroy() end
					items = {}
					for i, v in ipairs(obj.Values) do
						local b = New("TextButton", { Text = v, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = T.SubText, Size = UDim2.new(1, 0, 0, 26), BackgroundColor3 = T.Group, BackgroundTransparency = 1, LayoutOrder = i }, list)
						Corner(b, 4)
						Connect(b.MouseEnter, function() Tween(b, .15, { BackgroundTransparency = .8 }) end)
						Connect(b.MouseLeave, function() Tween(b, .15, { BackgroundTransparency = 1 }) end)
						Connect(b.MouseButton1Click, function()
							if o.Multi then obj.Value[v] = not obj.Value[v] or nil else obj.Value = v end
							refresh(); fire(o.Callback, obj.Value)
						end)
						items[v] = b
					end
					refresh()
				end
				
				function obj:SetValues(v) obj.Values = v; build() end
				function obj:SetValue(v, silent)
					if o.Multi then
						obj.Value = {}
						for k, on in pairs(type(v) == "table" and v or {}) do if on then obj.Value[type(k) == "number" and on or k] = true end end
					else obj.Value = v end
					refresh(); if not silent then fire(o.Callback, obj.Value) end
				end
				
				Connect(head.MouseButton1Click, function()
					if dstate.open then dstate.close() else
						for _, d in ipairs(Library._dropdowns) do if d ~= dstate then d.close() end end
						dstate.open = true; list.Visible = true; Tween(arrow, .2, { Rotation = 180 })
						listScale.Scale = .95; Tween(listScale, .2, { Scale = 1 }, Enum.EasingStyle.Quint)
					end
				end)
				
				build(); reg(idx, obj)
				return obj
			end

			return Group
		end
		return Tab
	end
	
	table.insert(Library.Windows, Win)
	return Win
end

if not Library._dropdownListener then
	Library._dropdownListener = UIS.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		for _, d in ipairs(Library._dropdowns) do
			if d.open and not d.hitTest(input.Position) then d.close() end
		end
	end)
end

return Library
