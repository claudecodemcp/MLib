Pad(TooltipFrame, 8, 4, 8, 4); Corner(TooltipFrame, 4); Stroke(TooltipFrame, T.Stroke, 0)

local function AddTooltip(btn, text)
	if not text or text == "" then return end
	Connect(btn.MouseEnter, function() TooltipFrame.Text = text; TooltipFrame.Visible = true end)
	Connect(btn.MouseLeave, function() TooltipFrame.Visible = false end)
end
RunService.RenderStepped:Connect(function()
	if TooltipFrame.Visible then TooltipFrame.Position = UDim2.fromOffset(Mouse.X + 10, Mouse.Y + 15) end
end)

--// Notifications \\--
function Library:Notify(title, text, duration)
	if not self.NotifyHolder or not self.NotifyHolder.Parent then
		if self.NotifyGui then pcall(function() self.NotifyGui:Destroy() end) end
		local g = New("ScreenGui", { Name = "UILibNotify", ResetOnSpawn = false, DisplayOrder = 200, IgnoreGuiInset = true }, GuiParent())
		self.NotifyGui = g
		self.NotifyHolder = New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(260, 400) }, g)
		local l = List(self.NotifyHolder, 8); l.VerticalAlignment = Enum.VerticalAlignment.Bottom
	end
	local f = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Panel, BackgroundTransparency = 1 }, self.NotifyHolder)
	Corner(f, 6); local s = Stroke(f, T.Stroke, 1); Pad(f, 12, 8, 12, 10); List(f, 2)
	local nscale = New("UIScale", { Scale = .75 }, f)
	local a = Label(f, title, 14, T.Text, Enum.Font.GothamBold); a.Size = UDim2.new(1, 0, 0, 18); a.TextTransparency = 1
	local b = Label(f, text or "", 13, T.SubText); b.Size = UDim2.new(1, 0, 0, 0); b.AutomaticSize = Enum.AutomaticSize.Y; b.TextWrapped = true; b.TextTransparency = 1
	Tween(f, .3, { BackgroundTransparency = .1 }); Tween(s, .3, { Transparency = 0 }); Tween(a, .3, { TextTransparency = 0 }); Tween(b, .3, { TextTransparency = 0 }); Tween(nscale, .35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(duration or 4, function()
		Tween(f, .28, { BackgroundTransparency = 1 }); Tween(s, .28, { Transparency = 1 }); Tween(a, .28, { TextTransparency = 1 }); Tween(b, .28, { TextTransparency = 1 }); Tween(nscale, .28, { Scale = .85 })
		task.wait(.32); f:Destroy()
	end)
end

--// Search System \\--
local function UpdateSearch(SearchText)
	SearchText = SearchText:lower()
	local isSearching = #SearchText > 0
	for _, win in pairs(Library.Windows) do
		for _, tab in ipairs(win.Tabs) do
			local tabHasVisible = false
			for _, group in pairs(tab.Groups) do
				local groupHasVisible = false
				for _, elem in ipairs(group.Elements) do
					local text = (elem.Option and elem.Option.Text) or elem.Text or ""
					if not isSearching or text:lower():find(SearchText) then elem.Holder.Visible = true; groupHasVisible = true else elem.Holder.Visible = false end
				end
				for _, dep in ipairs(group.DepBoxes) do
					local depHasVisible = false
					for _, elem in ipairs(dep.Elements) do
						local text = (elem.Option and elem.Option.Text) or elem.Text or ""
						if isSearching and text:lower():find(SearchText) then elem.Holder.Visible = true; depHasVisible = true end
					end
					if isSearching then dep.Container.Visible = depHasVisible else dep:UpdateVisibility() end
				end
				group.Holder.Visible = groupHasVisible or isSearching == false
				if groupHasVisible then tabHasVisible = true end
			end
			tab.Page.Visible = tabHasVisible or (isSearching == false and win.Current == tab)
		end
	end
end

--// Context Menu (Keybinds/Colors) \\--
local ActiveMenu = nil
local function OpenContextMenu(btn, size)
	if ActiveMenu then ActiveMenu:Destroy() end
	local menu = New("Frame", { BackgroundColor3 = T.Panel, Size = size, Visible = true, ZIndex = 50, Parent = Library.Windows[1].Gui })
	Corner(menu, 4); Stroke(menu, T.Stroke, 0); List(menu, 2); Pad(menu, 4, 4, 4, 4)
	menu.Position = UDim2.fromOffset(btn.AbsolutePosition.X, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 4)
	ActiveMenu = menu
	return menu
end
UIS.InputBegan:Connect(function(input)
	if ActiveMenu and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		if not InRect(ActiveMenu, input.Position) then ActiveMenu:Destroy(); ActiveMenu = nil end
	end
end)

--// Window \\--
function Library:AddWindow(cfg)
	cfg = cfg or {}
	local tk = cfg.ToggleKey or Enum.KeyCode.RightShift
	if type(tk) == "string" then tk = Enum.KeyCode[tk] or Enum.KeyCode.RightShift end
	local Win = { Tabs = {}, Title = cfg.Title or "Script", Icon = cfg.Icon or "layout-grid", ToggleKey = tk }

	local gui = New("ScreenGui", { Name = "UILib", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100, IgnoreGuiInset = true }, GuiParent())
	Win.Gui = gui

	local blur = New("BlurEffect", { Size = 0, Enabled = false }, Lighting)
	Win.Blur = blur

	local main = New("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .48), -- Shifted slightly up for tabs
		Size = cfg.Size or UDim2.fromOffset(700, 480),
		BackgroundColor3 = T.Bg, BackgroundTransparency = T.Transparency, BorderSizePixel = 0, ClipsDescendants = true,
	}, gui)
	Corner(main, 8); Stroke(main, T.Stroke, .4)
	local scale = New("UIScale", { Scale = .9 }, main)
	Win.Main = main

	--// Floating Tab Bar \\--
	local TabBar = New("Frame", {
		AnchorPoint = Vector2.new(.5, 0), Position = UDim2.fromScale(.5, .5), -- Positioned below via RunService
		Size = UDim2.fromOffset(0, 46), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1
	}, gui)
	local TabList = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, TabBar)
	local tl = List(TabList, 8) -- The little spaces between tabs
	tl.FillDirection = Enum.FillDirection.Horizontal; tl.HorizontalAlignment = Enum.HorizontalAlignment.Center; tl.VerticalAlignment = Enum.VerticalAlignment.Center

	-- Keep TabBar floating under the Main window
	Connect(RunService.RenderStepped, function()
		TabBar.Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset, main.Position.Y.Scale, main.Position.Y.Offset + main.AbsoluteSize.Y / 2 + 8)
		TabBar.Visible = main.Visible
	end)

	--// Top Bar \\--
	local topBar = New("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1 }, main)
	Pad(topBar, 12, 12, 12, 0)
	
	local titleBlock = New("Frame", { Size = UDim2.fromOffset(130, 36), BackgroundColor3 = T.Element }, topBar)
	Corner(titleBlock, 6); titleBlock.Position = UDim2.fromOffset(0, 0)
	local titleTxt = Label(titleBlock, Win.Title, 14, T.Text, Enum.Font.GothamBold)
	titleTxt.Size = UDim2.fromScale(1, 1); titleTxt.TextXAlignment = Enum.TextXAlignment.Center

	-- Search Box
	local searchBlock = New("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(200, 36), BackgroundColor3 = T.Element }, topBar)
	Corner(searchBlock, 6)
	local searchBox = New("TextBox", { BackgroundTransparency = 1, Size = UDim2.fromScale(1,1), PlaceholderText = "Search...", Text = "", TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 13 }, searchBlock)
	Pad(searchBox, 8, 0, 8, 0)
	Connect(searchBox:GetPropertyChangedSignal("Text"), function() UpdateSearch(searchBox.Text) end)

	--// Content \\--
	local content = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 60), Size = UDim2.new(1, -24, 1, -72) }, main)
	local pages = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, content)

	--// Dragging & Toggling \\--
	local dragging, startPos, startFrame
	Connect(topBar.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, startPos, startFrame = true, i.Position, main.Position
		end
	end)
	Connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startPos
			main.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X, startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
		end
	end)
	Connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)

	local toggleGen = 0
	function Win:Toggle(v)
		if v == nil then v = not main.Visible end
		toggleGen += 1
		local gen = toggleGen
		if v then
			main.Position = UDim2.fromScale(.5, .48)
			main.Visible = true
			scale.Scale = .9
			blur.Enabled = true
			Tween(scale, .35, { Scale = 1 }, Enum.EasingStyle.Back)
			Tween(blur, .35, { Size = 14 })
		else
			Tween(scale, .22, { Scale = .9 })
			Tween(blur, .22, { Size = 0 })
			task.delay(.22, function()
				if gen == toggleGen then
					main.Visible = false
					if blur.Size < .1 then blur.Enabled = false end
				end
			end)
		end
	end
	Connect(UIS.InputBegan, function(i, gp)
		if gp or Library._listening then return end
		if i.KeyCode == Win.ToggleKey then Win:Toggle() end
	end)

	function Win:Select(tab)
		for _, t in ipairs(Win.Tabs) do
			local on = t == tab
			t.Page.Visible = on
			Tween(t.Btn, .2, { BackgroundColor3 = on and T.Element or T.Panel })
			Tween(t.Img, .2, { ImageColor3 = on and T.Accent or T.SubText })
		end
		Win.Current = tab
	end

	function Win:AddTab(name, icon)
		local Tab = { Name = name, Groups = {} }
		local btn = New("TextButton", { Text = "", Size = UDim2.fromOffset(40, 40), BackgroundColor3 = T.Panel, LayoutOrder = #Win.Tabs + 1 }, TabList)
		Corner(btn, 8) -- Slight rounding for floating tabs
		
		local img = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(20, 20), ImageColor3 = T.SubText }, btn)
		if icon then Library:ApplyIcon(img, icon) end

		local page = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, pages)
		
		local function column(pos, size)
			local s = New("ScrollingFrame", { BackgroundTransparency = 1, Position = pos, Size = size, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, page)
			List(s, 8); Pad(s, 0, 0, 0, 12)
			return s
		end
		
		Tab.Cols = { Left = column(UDim2.fromOffset(0, 0), UDim2.new(.5, -4, 1, 0)), Right = column(UDim2.new(.5, 4, 0, 0), UDim2.new(.5, -4, 1, 0)) }
		Tab.Btn, Tab.Img, Tab.Page = btn, img, page
		
		Connect(btn.MouseButton1Click, function() Win:Select(Tab) end)
		table.insert(Win.Tabs, Tab)
		if #Win.Tabs == 1 then Win:Select(Tab) end

		function Tab:AddGroup(title, icon, side)
			side = side or "Left"
			local Group = { Elements = {}, DepBoxes = {} }
			local box = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Group, LayoutOrder = #Group.Elements + 1 }, Tab.Cols[side])
			Corner(box, 6)
			
			local topGrp = New("Frame", { Size = UDim2.new(1, 0, 0, 36), BackgroundTransparency = 1 }, box)
			local hdr = Label(topGrp, title, 14, T.Text, Enum.Font.GothamMedium)
			hdr.Position = UDim2.fromOffset(12, 0); hdr.Size = UDim2.new(1, -24, 1, 0)
			
			local holder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, box)
			List(holder, 2); Pad(holder, 6, 0, 6, 8)
			Group.Holder = box
			Group.Container = holder

			local function reg(idx, obj)
				if idx then Library.Options[idx] = obj; Library.Flags[idx] = obj.Value end
			end
			local function fire(cb, ...) if cb then task.spawn(cb, ...) end end

			function Group:AddLabel(text)
				local l = Label(holder, text, 13, T.SubText)
				l.Size = UDim2.new(1, 0, 0, 0); l.AutomaticSize = Enum.AutomaticSize.Y; l.TextWrapped = true
				Pad(l, 6, 4, 6, 4)
				local obj = { Text = text, Holder = l }
				table.insert(Group.Elements, obj)
				return { SetText = function(_, t) l.Text = t; obj.Text = t end }
			end

			function Group:AddButton(text, callback)
				local b = New("TextButton", { Text = text, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = T.Text, Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Element }, holder)
				Corner(b, 4)
				Connect(b.MouseEnter, function() Tween(b, .18, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
				Connect(b.MouseLeave, function() Tween(b, .18, { BackgroundColor3 = T.Element }) end)
				Connect(b.MouseButton1Click, function() fire(callback) end)
				table.insert(Group.Elements, { Text = text, Holder = b })
				return b
			end

			function Group:AddToggle(idx, o)
				local obj = { Value = o.Default or false, Type = "Toggle" }
				local row = New("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 1 }, holder)
				RowHover(row)
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(6, 0); l.Size = UDim2.new(1, -48, 1, 0)
				
				local track = New("Frame", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -6, .5, 0), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = T.Stroke }, row)
				Corner(track, 12)
				local knob = New("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = T.Text }, track)
				Corner(knob, 7)
				
				function obj:SetValue(v, silent)
					obj.Value = v and true or false
					Library.Flags[idx] = obj.Value
					Tween(track, .25, { BackgroundColor3 = obj.Value and T.Accent or T.Stroke })
					Tween(knob, .3, { BackgroundColor3 = obj.Value and T.Bg or T.SubText }, Enum.EasingStyle.Back)
					if not silent then fire(o.Callback, obj.Value) end
					Library.UpdateDepBoxes()
				end
				Connect(row.MouseButton1Click, function() obj:SetValue(not obj.Value) end)
				AddTooltip(row, o.Tooltip)
				reg(idx, obj); obj:SetValue(obj.Value, true)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end

			function Group:AddSlider(idx, o)
				local min, max, rnd = o.Min or 0, o.Max or 100, o.Rounding or 0
				local obj = { Value = math.clamp(o.Default or min, min, max), Type = "Slider" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1 }, holder)
				RowHover(row)
				
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(6, 4); l.Size = UDim2.new(.7, 0, 0, 20)
				local val = Label(row, "", 14, T.Text); val.AnchorPoint = Vector2.new(1, 0); val.Position = UDim2.new(1, -6, 0, 4)
				val.Size = UDim2.new(.3, 0, 0, 20); val.TextXAlignment = Enum.TextXAlignment.Right
				
				local bar = New("TextButton", { Text = "", Position = UDim2.fromOffset(6, 30), Size = UDim2.new(1, -12, 0, 3), BackgroundColor3 = T.Stroke }, row)
				Corner(bar, 2)
				local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Accent }, bar); Corner(fill, 2)
				local knob = New("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = T.Accent }, bar); Corner(knob, 5)
				
				function obj:SetValue(v, silent)
					local m = 10 ^ rnd
					v = math.clamp(math.floor(v * m + .5) / m, min, max)
					obj.Value = v; Library.Flags[idx] = v
					local a = (v - min) / (max - min)
					Tween(fill, .1, { Size = UDim2.fromScale(a, 1) }); Tween(knob, .1, { Position = UDim2.new(a, 0, .5, 0) })
					val.Text = tostring(v) .. (o.Suffix or "")
					if not silent then fire(o.Callback, v) end
				end
				local dragging = false
				local function upd(x)
					local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
					obj:SetValue(min + (max - min) * a)
				end
				Connect(bar.InputBegan, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i.Position.X) end
				end)
				Connect(UIS.InputChanged, function(i)
					if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
				end)
				Connect(UIS.InputEnded, function() dragging = false end)
				AddTooltip(row, o.Tooltip)
				reg(idx, obj); obj:SetValue(obj.Value, true)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end

			function Group:AddDropdown(idx, o)
				local values = o.Values or {}
				local obj = { Value = o.Multi and {} or (o.Default or values[1]), Type = "Dropdown", Values = values }
				if o.Multi and type(o.Default) == "table" then for _, v in ipairs(o.Default) do obj.Value[v] = true end end
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, holder)
				List(row, 2)
				
				local head = New("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Element }, row)
				Corner(head, 4)
				local l = Label(head, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(8, 0); l.Size = UDim2.new(.5, 0, 1, 0)
				local cur = Label(head, "", 13, T.SubText); cur.AnchorPoint = Vector2.new(1, 0); cur.Position = UDim2.new(1, -32, 0, 0)
				cur.Size = UDim2.new(.5, -40, 1, 0); cur.TextXAlignment = Enum.TextXAlignment.Right; cur.TextTruncate = Enum.TextTruncate.AtEnd
				
				local list = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Element, Visible = false, LayoutOrder = 2 }, row)
				Corner(list, 4); List(list, 2); Pad(list, 4, 4, 4, 4)
				local listScale = New("UIScale", { Scale = 1 }, list)
				local items = {}
				local dstate = { open = false }
				function dstate.close() dstate.open = false; list.Visible = false end
				function dstate.hitTest(pos) return InRect(head, pos) or (dstate.open and InRect(list, pos)) or (items[pos] ~= nil) end
				table.insert(Library._dropdowns, dstate)

				local function text()
					if o.Multi then
						local t = {}
						for _, v in ipairs(obj.Values) do if obj.Value[v] then table.insert(t, v) end end
						return #t > 0 and table.concat(t, ", ") or "None"
					end
					return tostring(obj.Value or "None")
				end
				
				local function refresh()
					cur.Text = text(); Library.Flags[idx] = obj.Value
					for v, b in pairs(items) do
						local on = o.Multi and obj.Value[v] or obj.Value == v
						Tween(b, .2, { TextColor3 = on and T.Accent or T.SubText })
					end
					Library.UpdateDepBoxes()
				end

				local function build()
					for _, b in pairs(items) do b:Destroy() end
					items = {}
					for i, v in ipairs(obj.Values) do
						local b = New("TextButton", { Text = v, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.SubText, Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = T.Element, BackgroundTransparency = 1, LayoutOrder = i }, list)
						Connect(b.MouseEnter, function() Tween(b, .15, { BackgroundTransparency = .85 }) end)
						Connect(b.MouseLeave, function() Tween(b, .15, { BackgroundTransparency = 1 }) end)
						Connect(b.MouseButton1Click, function()
							if o.Multi then obj.Value[v] = not obj.Value[v] or nil else obj.Value = v end
							refresh(); fire(o.Callback, obj.Value)
						end)
						items[v] = b
					end
					refresh()
				end
				
				function obj:SetValues(v) obj.Values = v; build() end
				function obj:SetValue(v, silent)
					if o.Multi then
						obj.Value = {}
						for k, on in pairs(type(v) == "table" and v or {}) do if on then obj.Value[type(k) == "number" and on or k] = true end end
					else obj.Value = v end
					refresh(); if not silent then fire(o.Callback, obj.Value) end
				end
				
				Connect(head.MouseButton1Click, function()
					if dstate.open then dstate.close() else
						for _, d in ipairs(Library._dropdowns) do if d ~= dstate then d.close() end end
						dstate.open = true; list.Visible = true
						listScale.Scale = .95; Tween(listScale, .2, { Scale = 1 }, Enum.EasingStyle.Quint)
					end
				end)
				
				AddTooltip(head, o.Tooltip)
				build(); reg(idx, obj)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end
			
			function Group:AddKeybind(idx, o)
				local obj = { Value = o.Default or "None", Mode = o.Mode or "Toggle", Type = "Keybind" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 1 }, holder)
				RowHover(row)
				
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(6, 0); l.Size = UDim2.new(1, -100, 1, 0)
				
				local b = New("TextButton", { Text = obj.Value, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.Text, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -6, .5, 0), Size = UDim2.fromOffset(80, 24), BackgroundColor3 = T.Stroke }, row)
				Corner(b, 4)
				
				local listening = false
				function obj:SetValue(v, silent)
					obj.Value = tostring(v); b.Text = obj.Value; Library.Flags[idx] = obj.Value
					if not silent then fire(o.Callback, obj.Value) end
				end
				
				Connect(b.MouseButton1Click, function() if not listening then listening = true; Library._listening = true; b.Text = "..." end end)
				Connect(b.MouseButton2Click, function()
					local menu = OpenContextMenu(b, UDim2.fromOffset(100, 60))
					for _, m in ipairs({"Toggle", "Hold", "Always"}) do
						local mb = New("TextButton", { Text = m, Size = UDim2.new(1,0,0,24), BackgroundTransparency = 1, TextColor3 = m == obj.Mode and T.Accent or T.SubText, Font = Enum.Font.Gotham, TextSize = 13 }, menu)
						Connect(mb.MouseButton1Click, function() obj.Mode = m; menu:Destroy() end)
					end
				end)

				Connect(UIS.InputBegan, function(i, gp)
					if listening and i.UserInputType == Enum.UserInputType.Keyboard then
						listening = false; Library._listening = false; obj:SetValue(i.KeyCode == Enum.KeyCode.Escape and "None" or i.KeyCode.Name)
					elseif listening and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
						if not InRect(b, i.Position) then listening = false; Library._listening = false; obj:SetValue(obj.Value) end
					elseif not listening and not gp and i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode.Name == obj.Value then
						fire(o.Callback, obj.Value)
					end
				end)
				
				reg(idx, obj)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end

			function Group:AddDependencyBox()
				local depContainer = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false }, holder)
				List(depContainer, 2)
				local dep = { Elements = {}, Container = depContainer, Dependencies = {} }
				
				function dep:SetupDependencies(deps)
					dep.Dependencies = deps
					dep:UpdateVisibility()
					table.insert(Library.DepBoxes, dep)
				end
				
				function dep:UpdateVisibility()
					local show = true
					for _, data in ipairs(dep.Dependencies) do
						local opt, val = data[1], data[2]
						if not opt or opt.Value ~= val then show = false break end
					end
					depContainer.Visible = show
				end
				
				table.insert(Group.DepBoxes, dep)
				local DepGroup = { Elements = dep.Elements, Container = depContainer, Holder = depContainer }
				setmetatable(DepGroup, { __index = Group })
				return DepGroup
			end

			function Group:AddColorPicker(idx, o)
				local obj = { Value = o.Default or Color3.new(1,1,1), Type = "Color" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 1 }, holder)
				RowHover(row)
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(6, 0); l.Size = UDim2.new(1, -50, 1, 0)
				
				local colorBtn = New("TextButton", { Size = UDim2.fromOffset(24, 24), AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -6, .5, 0), BackgroundColor3 = obj.Value }, row)
				Corner(colorBtn, 4); Stroke(colorBtn, Color3.new(0,0,0), .5)
				
				Connect(colorBtn.MouseButton1Click, function()
					local menu = OpenContextMenu(colorBtn, UDim2.fromOffset(180, 200))
					local hueBar = New("TextButton", { Size = UDim2.new(1, 0, 0, 15), Position = UDim2.new(0,0,0,0) }, menu)
					New("UIGradient", { Color = ColorSequence.new{ColorSequenceKeypoint.new(0,Color3.new(1,0,0)),ColorSequenceKeypoint.new(0.16,Color3.new(1,1,0)),ColorSequenceKeypoint.new(0.33,Color3.new(0,1,0)),ColorSequenceKeypoint.new(0.5,Color3.new(0,1,1)),ColorSequenceKeypoint.new(0.66,Color3.new(0,0,1)),ColorSequenceKeypoint.new(0.83,Color3.new(1,0,1)),ColorSequenceKeypoint.new(1,Color3.new(1,0,0))}, Rotation = 0 }, hueBar)
					Corner(hueBar, 2)
					
					local hexBox = New("TextBox", { Size = UDim2.new(1, 0, 0, 24), Position = UDim2.new(0,0,0,25), PlaceholderText = "Hex (ex. FF0000)", Text = "", BackgroundColor3 = T.Bg, TextColor3 = T.Text }, menu)
					Corner(hexBox, 4); Pad(hexBox, 6, 0, 6, 0)
					
					Connect(hueBar.MouseButton1Click, function()
						local m = Mouse.X - hueBar.AbsolutePosition.X
						local hue = math.clamp(m / hueBar.AbsoluteSize.X, 0, 1)
						local h, s, v = obj.Value:ToHSV()
						obj.Value = Color3.fromHSV(hue, s, v)
						colorBtn.BackgroundColor3 = obj.Value; fire(o.Callback, obj.Value)
					end)
					Connect(hexBox.FocusLost, function(enter)
						if enter then
							local ok, c = pcall(Color3.fromHex, hexBox.Text)
							if ok and c then obj.Value = c; colorBtn.BackgroundColor3 = c; fire(o.Callback, c); hexBox.Text = "" end
						end
					end)
				end)
				
				AddTooltip(row, o.Tooltip)
				reg(idx, obj)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end

			return Group
		end
		return Tab
	end
	
	table.insert(Library.Windows, Win)
	task.defer(function() Win:Toggle(true) end)
	return Win
end

function Library.UpdateDepBoxes()
	for _, dep in ipairs(Library.DepBoxes) do
		if dep.Container and dep.Container.Parent then dep:UpdateVisibility() end
	end
end

if not Library._dropdownListener then
	Library._dropdownListener = UIS.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		for _, d in ipairs(Library._dropdowns) do
			if d.open and not d.hitTest(input.Position) then d.close() end
		end
	end)
end

return Library
