	end)

	-- Top Bar
	local topBar = New("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1 }, main)
	Pad(topBar, 16, 12, 16, 0)
	
	local titleBlock = New("Frame", { Size = UDim2.fromOffset(150, 36), BackgroundTransparency = 1 }, topBar)
	local tIcon = New("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(22, 22), Position = UDim2.new(0, 0, .5, -11), ImageColor3 = T.Text }, titleBlock)
	Library:ApplyIcon(tIcon, Win.Icon)
	local titleTxt = Label(titleBlock, Win.Title, 16, T.Text, T.FontBold); titleTxt.Position = UDim2.fromOffset(32, 0); titleTxt.Size = UDim2.new(1, -32, 1, 0)

	local searchBlock = New("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(220, 36), BackgroundColor3 = T.Element }, topBar)
	Corner(searchBlock, 6); Stroke(searchBlock, T.Stroke, .6)
	local sIcon = New("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(10, 10), ImageColor3 = T.SubText }, searchBlock); Library:ApplyIcon(sIcon, "search")
	local searchBox = New("TextBox", { BackgroundTransparency = 1, Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -42, 1, 0), PlaceholderText = "Search features...", Text = "", TextColor3 = T.Text, Font = T.Font, TextSize = 13 }, searchBlock)
	Connect(searchBox:GetPropertyChangedSignal("Text"), function() UpdateSearch(searchBox.Text) end)

	local content = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 60), Size = UDim2.new(1, -32, 1, -76) }, main)
	local pages = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, content)

	-- Dragging
	local drag, start, startF
	Connect(topBar.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then drag, start, startF = true, i.Position, main.Position end end)
	Connect(UserInputService.InputChanged, function(i)
