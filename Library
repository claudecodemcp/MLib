			BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5),
			Size = UDim2.fromOffset(30, 30), Image = "rbxassetid://243660364", ImageColor3 = T.Accent, ImageTransparency = 1, ZIndex = 1
		}, btn)

