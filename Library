local SaveManager = {}
SaveManager.Folder = "UILib/configs"
SaveManager.Ignore = {}

function SaveManager:SetFolder(folder) self.Folder = folder or "UILib/configs" end
function SaveManager:Ignore(key) self.Ignore[key] = true end

local function ensureFolder(path)
    if not isfolder or not makefolder then return end
    local current = ""
    for part in string.gmatch(path, "[^/]+") do
        current = current == "" and part or (current .. "/" .. part)
        if not isfolder(current) then pcall(makefolder, current) end
    end
end

function SaveManager:Save(name)
    if not writefile then Library:Notify("writefile not available") return false end
    ensureFolder(self.Folder)
    local data = {}
    for idx, opt in pairs(Library.Options) do
        if not self.Ignore[idx] and opt.Type then
            if opt.Type == "Toggle" or opt.Type == "Slider" then
                data[idx] = opt.Value
            elseif opt.Type == "Keybind" then
                data[idx] = typeof(opt.Value) == "EnumItem" and opt.Value.Name or tostring(opt.Value)
            elseif opt.Type == "Input" then
                data[idx] = opt.Value
            elseif opt.Type == "Dropdown" then
                if type(opt.Value) == "table" then
                    local list = {}
                    for k, v in pairs(opt.Value) do 
                        if v then 
                            if typeof(k) == "Instance" then
                                table.insert(list, k.Name)
                            else
                                table.insert(list, k) 
                            end
                        end 
                    end
                    data[idx] = list
                else
                    data[idx] = typeof(opt.Value) == "Instance" and opt.Value.Name or opt.Value
                end
            end
        end
    end
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then Library:Notify("Failed to encode") return false end
    local path = self.Folder .. "/" .. name .. ".json"
    local success, err = pcall(writefile, path, encoded)
    if success then Library:Notify("Saved: " .. name) return true end
    Library:Notify("Save failed: " .. tostring(err))
    return false
end

function SaveManager:Load(name)
    if not readfile or not isfile then Library:Notify("readfile not available") return false end
    local path = self.Folder .. "/" .. name .. ".json"
    if not isfile(path) then Library:Notify("Not found: " .. name) return false end
    local ok, raw = pcall(readfile, path)
    if not ok or not raw then Library:Notify("Read failed") return false end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or type(data) ~= "table" then Library:Notify("Invalid file") return false end
    for idx, value in pairs(data) do
        local opt = Library.Options[idx]
        if opt and opt.SetValue then
            pcall(function()
                if opt.Type == "Keybind" and type(value) == "string" then
                    opt:SetValue(Enum.KeyCode[value] or Enum.KeyCode.Unknown)
                else
                    opt:SetValue(value)
                end
            end)
        end
    end
    Library:Notify("Loaded: " .. name)
    return true
end

function SaveManager:Delete(name)
    if not delfile or not isfile then return false end
    local path = self.Folder .. "/" .. name .. ".json"
    if isfile(path) then
        pcall(delfile, path)
        Library:Notify("Deleted: " .. name)
        return true
    end
    return false
end

function SaveManager:ListConfigs()
    local list = {}
    if not listfiles or not isfolder or not makefolder then return list end
    pcall(makefolder, self.Folder)
    local ok, files = pcall(listfiles, self.Folder)
    if not ok or type(files) ~= "table" then return list end
    for _, filePath in ipairs(files) do
        local name = filePath:match("([^/\\]+)%.json$")
        if name and name ~= "autoload" then table.insert(list, name) end
    end
    return list
end

function SaveManager:GetAutoload()
    if not readfile or not isfile then return nil end
    local path = self.Folder .. "/autoload.txt"
    if isfile(path) then
        local ok, name = pcall(readfile, path)
        if ok and name and name ~= "" then return name:gsub("%s+", "") end
    end
    return nil
end

function SaveManager:SetAutoload(name)
    if not writefile then Library:Notify("writefile not available") return false end
    ensureFolder(self.Folder)
    local ok = pcall(writefile, self.Folder .. "/autoload.txt", tostring(name))
    if ok then Library:Notify("Autoload: " .. name) return true end
    return false
end

function SaveManager:RemoveAutoload()
    if not delfile and not writefile then return false end
    local path = self.Folder .. "/autoload.txt"
    if isfile and isfile(path) then
        if delfile then pcall(delfile, path) else pcall(writefile, path, "") end
        Library:Notify("Autoload removed")
        return true
    end
    return false
end

function SaveManager:BuildConfigSection(tab, side)
    side = side or "Right"
    local group = tab:AddGroup("Config", side, "save")
    local selectedConfig = nil

    local function refreshList()
        local opt = Library.Options.ConfigList
        if opt and opt.SetValues then opt:SetValues(self:ListConfigs()) end
    end

    group:AddDropdown("ConfigList", {
        Text = "Configs",
        Values = self:ListConfigs(),
        Default = nil,
        Callback = function(v) selectedConfig = v end,
    })

    group:AddInput("ConfigNameInput", {
        Text = "Config name",
        Default = "",
        Placeholder = "",
    })

    group:AddButton("Refresh", function()
        refreshList()
        Library:Notify("Refreshed")
    end)

    local function getName()
        local input = Library.Options.ConfigNameInput
        local typed = ""
        if input then
            typed = tostring(input.Value or ""):gsub("^%s+", ""):gsub("%s+$", "")
        end
        if typed ~= "" then return typed end
        return selectedConfig
    end

    group:AddButton("Save", function()
        local name = getName()
        if not name or name == "" then Library:Notify("Select or enter a name") return end
        if self:Save(name) then
            refreshList()
            selectedConfig = name
            local opt = Library.Options.ConfigList
            if opt and opt.SetValue then pcall(function() opt:SetValue(name) end) end
        end
    end)

    group:AddButton("Load", function()
        local name = getName()
        if not name or name == "" then Library:Notify("Select or enter a name") return end
        self:Load(name)
    end)

    group:AddButton("Delete", function()
        local name = getName()
        if not name or name == "" then Library:Notify("Select or enter a name") return end
        self:Delete(name)
        if self:GetAutoload() == name then self:RemoveAutoload() end
        refreshList()
    end)

    group:AddButton("Set AutoLoad", function()
        local name = getName()
        if not name or name == "" then Library:Notify("Select or enter a name") return end
        self:SetAutoload(name)
    end)

    group:AddButton("Remove AutoLoad", function()
        self:RemoveAutoload()
    end)

    return group
end

function SaveManager:LoadAutoloadConfig()
    local name = self:GetAutoload()
    if name then self:Load(name) end
end

Library.SaveManager = SaveManager

function Library:AddFloatingButton(cfg)
    cfg = cfg or {}
    local parent = GuiParent()
    local floatGui = parent:FindFirstChild("UILibFloating")
    if not floatGui then
        floatGui = New("ScreenGui", {
            Name = "UILibFloating",
            ResetOnSpawn = false,
            DisplayOrder = 150,
            IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, parent)
    end

    local existingBtn = floatGui:FindFirstChild("UILibFloatingBtn")
    if existingBtn then
        existingBtn:Destroy()
    end

    local size = cfg.Size or 48
    local btn = New("TextButton", {
        Name = "UILibFloatingBtn",
        AnchorPoint = Vector2.new(0, 0),
        Position = cfg.Position or UDim2.new(1, -16 - size, 1, -16 - size),
        Size = UDim2.fromOffset(size, size),
        BackgroundColor3 = T.Group,
        BackgroundTransparency = T.BgTransparency or 0,
        Text = "",
        AutoButtonColor = false,
    }, floatGui)
    Corner(btn, cfg.Round and math.floor(size / 2) or 8)
    Stroke(btn, T.Stroke, 0.4)

    local iconSize = cfg.IconSize or math.floor(size * 0.42)
    local icon = New("ImageLabel", {
        BackgroundTransparency = 1,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.fromScale(0.5, 0.5),
        Size = UDim2.fromOffset(iconSize, iconSize),
        ImageColor3 = T.Text,
    }, btn)
    if cfg.Icon then Library:ApplyIcon(icon, cfg.Icon) end

    if not cfg.Icon and cfg.Text then
        local lbl = Label(btn, cfg.Text, 12, T.Text, Enum.Font.GothamMedium)
        lbl.Size = UDim2.fromScale(1, 1)
        lbl.TextXAlignment = Enum.TextXAlignment.Center
        lbl.TextYAlignment = Enum.TextYAlignment.Center
    end

    local state = false
    local listeners = {}

    local function fire(...)
        if type(cfg.Callback) == "function" then safeCall(cfg.Callback, ...) end
        for _, fn in ipairs(listeners) do safeCall(fn, ...) end
    end

    Connect(btn.MouseEnter, function()
        Tween(btn, 0.12, { BackgroundColor3 = state and Color3.fromRGB(58, 58, 58) or T.Hover })
    end)
    Connect(btn.MouseLeave, function()
        Tween(btn, 0.12, { BackgroundColor3 = state and Color3.fromRGB(52, 52, 52) or T.Group })
    end)

    local dragging, dragStart, startPos, wasDragged = false, nil, nil, false
    Connect(btn.InputBegan, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            wasDragged = false
            dragStart = input.Position
            startPos = btn.Position
        end
    end)
    Connect(UIS.InputChanged, function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch) then
            local d = input.Position - dragStart
            if d.Magnitude > 4 then wasDragged = true end
            btn.Position = UDim2.new(
                startPos.X.Scale, startPos.X.Offset + d.X,
                startPos.Y.Scale, startPos.Y.Offset + d.Y
            )
        end
    end)
    Connect(UIS.InputEnded, function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)

    local obj = { Button = btn, Value = false, Type = "FloatingButton" }

    function obj:OnChanged(fn)
        if type(fn) == "function" then table.insert(listeners, fn) end
        return obj
    end

    function obj:SetValue(v, silent)
        obj.Value = not not v
        state = obj.Value
        if cfg.Toggleable then
            Tween(btn, 0.15, { BackgroundColor3 = state and Color3.fromRGB(52, 52, 52) or T.Group })
            Tween(icon, 0.15, { ImageColor3 = state and T.Accent or T.Text })
        end
        if not silent then fire(obj.Value) end
    end

    function obj:Destroy() btn:Destroy() end

    Connect(btn.MouseButton1Click, function()
        if wasDragged then return end
        if cfg.Toggleable then
            obj:SetValue(not obj.Value)
        else
            fire()
        end
    end)

    return obj
end

function Library:AddFloatingWindowToggle(win, cfg)
    cfg = cfg or {}
    cfg.Icon = cfg.Icon or "menu"
    cfg.Toggleable = true
    local fb = self:AddFloatingButton(cfg)
    local startState = win.Visible ~= false
    fb:SetValue(startState, true)
    fb:OnChanged(function(v) win:Toggle(v) end)
    return fb
end

if not Library._dropdownListener then
    Library._dropdownListener = UIS.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1
            and input.UserInputType ~= Enum.UserInputType.Touch then return end
        for _, d in ipairs(Library._dropdowns) do
            if d.open and not d.hitTest(input.Position) then d.close() end
        end
    end)
end

return Library
