					Text = text, Font = Enum.Font.Gotham, TextSize = 14, TextColor3 = T.Text, AutoButtonColor = false,
					Size = UDim2.new(1, 0, 0, 32), BackgroundColor3 = T.Element, BorderSizePixel = 0,
				}, holder)
				Corner(b, 4)
				Connect(b.MouseEnter, function() Tween(b, .18, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
				Connect(b.MouseLeave, function() Tween(b, .18, { BackgroundColor3 = T.Element }) end)
				Connect(b.MouseButton1Click, function()
					Library:PlaySound("Click")
					b.BackgroundColor3 = Color3.fromRGB(70, 70, 70); Tween(b, .3, { BackgroundColor3 = T.Element })
					fire(callback)
				end)
				return b
			end

			function Group:AddToggle(idx, o)
				o = o or {}
				local obj = { Value = o.Default or false, Type = "Toggle" }
				local row = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Element, BackgroundTransparency = 1, BorderSizePixel = 0 }, holder)
				RowHover(row)
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(8, 0); l.Size = UDim2.new(1, -56, 1, 0)
				local cb = CheckBox(row, 24)
				local box, boxStroke, holder2, checkScale, boxScale = cb.box, cb.stroke, cb.holder, cb.checkScale, cb.scale

				local function hover(on)
					Tween(boxStroke, .18, { Transparency = on and 0 or (obj.Value and 0 or .5), Color = on and T.Accent or (obj.Value and T.Accent or T.Stroke) })
				end
				Connect(row.MouseEnter, function() hover(true) end)
				Connect(row.MouseLeave, function() hover(false) end)

				function obj:SetValue(v, silent)
					obj.Value = v and true or false
					Library.Flags[idx] = obj.Value
					if obj.Value then
						holder2.Visible = true; checkScale.Scale = 0
						Tween(box, .2, { BackgroundColor3 = T.Accent, BackgroundTransparency = 0 })
						Tween(boxStroke, .2, { Color = T.Accent, Transparency = 0 })
						Tween(checkScale, .28, { Scale = 1 }, Enum.EasingStyle.Back)
						Tween(boxScale, .1, { Scale = 1.15 })
						task.delay(.1, function() Tween(boxScale, .22, { Scale = 1 }, Enum.EasingStyle.Back) end)
					else
						Tween(box, .2, { BackgroundColor3 = T.Element, BackgroundTransparency = .15 })
						Tween(boxStroke, .2, { Color = T.Stroke, Transparency = .5 })
						Tween(checkScale, .14, { Scale = .3 })
						task.delay(.14, function() if not obj.Value then holder2.Visible = false end end)
					end
					if not silent then fire(o.Callback, obj.Value) end
				end
				Connect(row.MouseButton1Click, function()
					obj:SetValue(not obj.Value)
					Library:PlaySound("Toggle")
				end)
				reg(idx, obj); obj:SetValue(obj.Value, true)
				return obj
			end

			function Group:AddSlider(idx, o)
				o = o or {}
				local min, max, rnd = o.Min or 0, o.Max or 100, o.Rounding or 0
				local obj = { Value = math.clamp(o.Default or min, min, max), Type = "Slider" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, BorderSizePixel = 0 }, holder)
				RowHover(row)
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(6, 4); l.Size = UDim2.new(.7, 0, 0, 20)
				local val = Label(row, "", 14, T.Text, Enum.Font.Gotham); val.AnchorPoint = Vector2.new(1, 0); val.Position = UDim2.new(1, -6, 0, 4)
				val.Size = UDim2.new(.3, 0, 0, 20); val.TextXAlignment = Enum.TextXAlignment.Right
				local bar = New("TextButton", { Text = "", AutoButtonColor = false, Position = UDim2.fromOffset(6, 30), Size = UDim2.new(1, -12, 0, 3), BackgroundColor3 = T.Stroke, BorderSizePixel = 0 }, row)
				Corner(bar, 2)
				local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, bar); Corner(fill, 2)
				local knob = New("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(10, 10), BackgroundColor3 = T.Accent, BorderSizePixel = 0 }, bar); Corner(knob, 5)
				function obj:SetValue(v, silent)
					local m = 10 ^ rnd; v = math.clamp(math.floor(v * m + .5) / m, min, max)
					obj.Value = v; Library.Flags[idx] = v
					local a = (v - min) / (max - min)
					Tween(fill, .1, { Size = UDim2.fromScale(a, 1) }); Tween(knob, .1, { Position = UDim2.new(a, 0, .5, 0) })
					val.Text = tostring(v) .. (o.Suffix or "")
					if not silent then fire(o.Callback, v) end
				end
				local dragging = false
				local function upd(x)
					local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
					obj:SetValue(min + (max - min) * a)
				end
				Connect(bar.InputBegan, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i.Position.X) end end)
				Connect(UIS.InputChanged, function(i) if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end end)
				Connect(UIS.InputEnded, function(i) if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end end)
				reg(idx, obj); obj:SetValue(obj.Value, true)
				return obj
			end

			function Group:AddInput(idx, o)
				o = o or {}
				local obj = { Value = o.Default or "", Type = "Input" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1 }, holder)
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(6, 4); l.Size = UDim2.new(1, 0, 0, 20)
				local box = New("TextBox", {
					Position = UDim2.fromOffset(6, 26), Size = UDim2.new(1, -12, 0, 28), BackgroundColor3 = T.Element, BorderSizePixel = 0, Text = obj.Value,
					PlaceholderText = o.Placeholder or "", PlaceholderColor3 = T.SubText, TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 14,
					ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left,
				}, row)
				Corner(box, 4); Pad(box, 8, 0, 8, 0)
				Connect(box.Focused, function() Tween(box, .18, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
				Connect(box.FocusLost, function() Tween(box, .18, { BackgroundColor3 = T.Element }); obj:SetValue(box.Text) end)
				function obj:SetValue(v, silent) obj.Value = tostring(v); box.Text = obj.Value; Library.Flags[idx] = obj.Value; if not silent then fire(o.Callback, obj.Value) end end
				reg(idx, obj)
				return obj
			end

			function Group:AddDropdown(idx, o)
				o = o or {}
				local values = o.Values or {}
				local obj = { Value = o.Multi and {} or (o.Default or values[1]), Type = "Dropdown", Values = values }
				if o.Multi and type(o.Default) == "table" then for _, v in ipairs(o.Default) do obj.Value[v] = true end end
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1 }, holder)
				List(row, 2)
				local head = New("TextButton", { Text = "", AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Element, BorderSizePixel = 0 }, row)
				Corner(head, 4)
				local ddBadge = New("Frame", { AnchorPoint = Vector2.new(0, .5), Position = UDim2.new(0, 6, .5, 0), Size = UDim2.fromOffset(24, 24), BackgroundColor3 = T.Element, BackgroundTransparency = .4 }, head)
				Corner(ddBadge, 7)
				local ddIcon = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(14, 14), ImageColor3 = T.SubText }, ddBadge)
				Library:ApplyIcon(ddIcon, o.Icon or "list")
				local l = Label(head, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(38, 0); l.Size = UDim2.new(.5, -10, 1, 0)
				local cur = Label(head, "", 13, T.SubText, Enum.Font.Gotham); cur.AnchorPoint = Vector2.new(1, 0); cur.Position = UDim2.new(1, -32, 0, 0)
				cur.Size = UDim2.new(.5, -40, 1, 0); cur.TextXAlignment = Enum.TextXAlignment.Right; cur.TextTruncate = Enum.TextTruncate.AtEnd
				local arrow = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -10, .5, 0), Size = UDim2.fromOffset(14, 14), ImageColor3 = T.SubText }, head)
				local hasArrow = Library:ApplyIcon(arrow, "chevron-down")
				Connect(head.MouseEnter, function() Tween(head, .18, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
				Connect(head.MouseLeave, function() Tween(head, .18, { BackgroundColor3 = T.Element }) end)
				local list = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Element, BorderSizePixel = 0, Visible = false, LayoutOrder = 2 }, row)
				Corner(list, 4); List(list, 2); Pad(list, 4, 4, 4, 4)
				local listScale = New("UIScale", { Scale = 1 }, list)
				local items = {}
				local dstate = { open = false }
				function dstate.close() dstate.open = false; list.Visible = false; if hasArrow then Tween(arrow, .25, { Rotation = 0 }) end end
				function dstate.hitTest(pos) if InRect(head, pos) then return true end; if dstate.open and InRect(list, pos) then return true end; for _, b in pairs(items) do if InRect(b, pos) then return true end end; return false end
				table.insert(Library._dropdowns, dstate)

				local function text()
					if o.Multi then
						local t = {}
						for _, v in ipairs(obj.Values) do if obj.Value[v] then table.insert(t, v) end end
						return #t > 0 and table.concat(t, ", ") or "None"
					end
					return tostring(obj.Value or "None")
				end
				local function refresh()
					cur.Text = text(); Library.Flags[idx] = obj.Value
					for v, b in pairs(items) do
						local on = o.Multi and obj.Value[v] or obj.Value == v
						Tween(b, .2, { TextColor3 = on and T.Accent or T.SubText })
					end
				end
				local function build()
					for _, b in pairs(items) do b:Destroy() end
					items = {}
					for i, v in ipairs(obj.Values) do
						local b = New("TextButton", { Text = v, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.SubText, AutoButtonColor = false, Size = UDim2.new(1, 0, 0, 24), BackgroundColor3 = T.Element, BackgroundTransparency = 1, BorderSizePixel = 0, LayoutOrder = i }, list)
						Connect(b.MouseEnter, function() Tween(b, .15, { BackgroundTransparency = .85 }) end)
						Connect(b.MouseLeave, function() Tween(b, .15, { BackgroundTransparency = 1 }) end)
						Connect(b.MouseButton1Click, function()
							if o.Multi then obj.Value[v] = not obj.Value[v] or nil else obj.Value = v end
							Library:PlaySound("Click"); refresh(); fire(o.Callback, obj.Value)
						end)
						items[v] = b
					end
					refresh()
				end
				function obj:SetValues(v) obj.Values = v; if not o.Multi and obj.Value ~= nil and not table.find(v, obj.Value) then obj.Value = v[1] end; build() end
				function obj:SetValue(v, silent)
					if o.Multi then obj.Value = {}; for k, on in pairs(type(v) == "table" and v or {}) do if on then obj.Value[type(k) == "number" and on or k] = true end end
					else obj.Value = v end
					refresh(); if not silent then fire(o.Callback, obj.Value) end
				end
				Connect(head.MouseButton1Click, function()
					Library:PlaySound("Click")
					if dstate.open then dstate.close() else
						for _, d in ipairs(Library._dropdowns) do if d ~= dstate then d.close() end end
						dstate.open = true; list.Visible = true; listScale.Scale = .95; Tween(listScale, .2, { Scale = 1 }, Enum.EasingStyle.Quint)
						if hasArrow then Tween(arrow, .25, { Rotation = 180 }) end
					end
				end)
				build(); reg(idx, obj)
				return obj
			end

			function Group:AddKeybind(idx, o)
				o = o or {}
				local obj = { Value = o.Default or "None", Type = "Keybind" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 1, BorderSizePixel = 0 }, holder)
				RowHover(row)
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(6, 0); l.Size = UDim2.new(1, -84, 1, 0)
				local b = New("TextButton", { Text = obj.Value, AutoButtonColor = false, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.Text,
					AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -6, .5, 0), Size = UDim2.fromOffset(64, 24), BackgroundColor3 = T.Stroke, BorderSizePixel = 0 }, row)
				Corner(b, 4)
				local listening = false
				function obj:SetValue(v, silent) obj.Value = tostring(v); b.Text = obj.Value; Library.Flags[idx] = obj.Value; if not silent then fire(o.Callback, obj.Value) end end
				Connect(b.MouseButton1Click, function() listening = true; Library._listening = true; b.Text = "..."; Library:PlaySound("Click") end)
				Connect(UIS.InputBegan, function(i, gp)
					if listening and i.UserInputType == Enum.UserInputType.Keyboard then
						listening = false; Library._listening = false; obj:SetValue(i.KeyCode == Enum.KeyCode.Escape and "None" or i.KeyCode.Name)
					elseif listening and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
						if not InRect(b, i.Position) then listening = false; Library._listening = false; obj:SetValue(obj.Value) end
					elseif not listening and not gp and i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode.Name == obj.Value then
						fire(o.Callback, obj.Value)
					end
				end)
				reg(idx, obj)
				return obj
			end

			return Group
		end
		return Tab
	end

	function Win:AddConfigTab(icon)
		local Tab = Win:AddTab("Configs", icon or "save")
		local g = Tab:AddGroup("Configs", "folder", "Left")
		local g2 = Tab:AddGroup("Menu", "settings", "Right")
		local fs = (writefile and readfile and isfolder and makefolder and listfiles and isfile)
		local function ensure() if fs and not isfolder("UILib") then makefolder("UILib") end; if fs and not isfolder(Library.ConfigFolder) then makefolder(Library.ConfigFolder) end end
		local function names() ensure(); local out = {}; if fs then for _, p in ipairs(listfiles(Library.ConfigFolder)) do local n = p:match("([^/\\]+)%.json$"); if n then table.insert(out, n) end end end; return out end
		local nameBox = g:AddInput("__cfgname", { Text = "Config name", Placeholder = "my config" })
		local dd = g:AddDropdown("__cfglist", { Text = "Configs", Icon = "file-json", Values = names() })
		local function path(n) return Library.ConfigFolder .. "/" .. n .. ".json" end
		g:AddButton("Create / Save", function()
			local n = (nameBox.Value ~= "" and nameBox.Value) or dd.Value
			if not fs or not n or n == "" then return Library:Notify("Config", "Enter a name.") end
			ensure(); local data = {}
			for k, v in pairs(Library.Flags) do if not k:match("^__cfg") then data[k] = v end end
			writefile(path(n), HttpService:JSONEncode(data)); dd:SetValues(names()); dd:SetValue(n, true)
			Library:Notify("Config", "Saved '" .. n .. "'")
		end)
		g:AddButton("Load", function()
			local n = dd.Value
			if not fs or not n or not isfile(path(n)) then return Library:Notify("Config", "Nothing to load.") end
			local ok, data = pcall(function() return HttpService:JSONDecode(readfile(path(n))) end)
			if not ok then return Library:Notify("Config", "Corrupt config.") end
			for k, v in pairs(data) do local opt = Library.Options[k]; if opt then pcall(opt.SetValue, opt, v, true) end end
			Library:Notify("Config", "Loaded '" .. n .. "'")
		end)
		g:AddButton("Delete", function() local n = dd.Value; if fs and n and isfile(path(n)) then delfile(path(n)); dd:SetValues(names()); Library:Notify("Config", "Deleted '" .. n .. "'") end end)
		g:AddButton("Refresh list", function() dd:SetValues(names()) end)
		g2:AddKeybind("__menukey", { Text = "Menu key", Default = Win.ToggleKey.Name, Callback = function() end })
		g2:AddButton("Unload UI", function() Library:Unload() end)
		return Tab
	end

	table.insert(Library.Windows, Win)
	return Win
end

if not Library._dropdownListener then
	Library._dropdownListener = UIS.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		for _, d in ipairs(Library._dropdowns) do
			if d.open and not d.hitTest(input.Position) then d.close() end
		end
	end)
end

function Library:Unload()
	for _, c in ipairs(self.Connections) do pcall(function() c:Disconnect() end) end
	for _, w in ipairs(self.Windows) do
		if w.Blur then pcall(function() w.Blur:Destroy() end) end
		pcall(function() w.Gui:Destroy() end)
	end
	if self.NotifyGui then pcall(function() self.NotifyGui:Destroy() end) end
	if self._dropdownListener then pcall(function() self._dropdownListener:Disconnect() end) end
	for _, s in ipairs(SoundService:GetChildren()) do if s.Name == "UILibSound" then pcall(function() s:Destroy() end) end end
	self.Windows, self.Connections = {}, {}
	self.NotifyGui, self.NotifyHolder = nil, nil
	self._dropdowns, self._dropdownListener = {}, nil
	self._listening = false
end

return Library
