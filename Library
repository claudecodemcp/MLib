                TextColor3 = T.SubText,
                Font = Enum.Font.GothamMedium,
                AutoButtonColor = false,
                ClipsDescendants = true,
                ZIndex = 2,
            }, row)
            Corner(keyChip, 4)
            Stroke(keyChip, T.Stroke, 0.5)
            Pad(keyChip, 8, 0, 8, 0)
            New("UISizeConstraint", { MinSize = Vector2.new(30, 22) }, keyChip)

            local function updateLabelPos()
                local chipWidth = keyChip.AbsoluteSize.X
                if chipWidth <= 0 then chipWidth = 30 end
                l.Position = UDim2.fromOffset(6 + chipWidth + 6, 0)
                l.Size = UDim2.new(1, -42 - chipWidth - 6, 1, 0)
            end
            Connect(keyChip:GetPropertyChangedSignal("AbsoluteSize"), updateLabelPos)
            task.defer(updateLabelPos)

            local listening = false
            local boundKey = Enum.KeyCode.Unknown
            if type(kbOpts.Default) == "string" and kbOpts.Default ~= "None" then
                boundKey = Enum.KeyCode[kbOpts.Default] or Enum.KeyCode.Unknown
            elseif typeof(kbOpts.Default) == "EnumItem" then
                boundKey = kbOpts.Default
            end

            local function refreshChip()
                if boundKey == Enum.KeyCode.Unknown then
                    keyChip.Text = "—"
                    keyChip.TextColor3 = T.SubText
                else
                    keyChip.Text = boundKey.Name
                    keyChip.TextColor3 = T.Text
                end
            end
            refreshChip()

            local function stopListening(resetText)
                listening = false
                Library._listening = false
                Library._listeningStart = nil
                if resetText then refreshChip() end
            end

            Connect(keyChip.MouseButton1Click, function()
                listening = true
                Library._listening = true
                Library._listeningStart = tick()
                keyChip.Text = "..."
                keyChip.TextColor3 = T.Accent
            end)

            local kbObj = { Value = boundKey, Type = "Keybind", Name = kbName }
            attachCallbacks(kbObj)

            function kbObj:SetValue(v, silent)
                boundKey = v
                self.Value = v
                Library.Flags[kbName] = v
                refreshChip()
                if not silent then emit(self, kbOpts, v) end
            end

            Connect(UIS.InputBegan, function(input, gameProcessed)
                if listening then
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                        or input.UserInputType == Enum.UserInputType.Touch then
                        local mp = UIS:GetMouseLocation()
                        if not InRect(keyChip, mp) then stopListening(true) end
                        return
                    end
                    if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                    if input.KeyCode == Enum.KeyCode.Escape then
                        stopListening(true)
                        return
                    end
                    if gameProcessed then return end
                    stopListening(false)
                    kbObj:SetValue(input.KeyCode)
                    return
                end
                if gameProcessed or Library._listening then return end
                if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
                if boundKey == Enum.KeyCode.Unknown then return end
                if input.KeyCode == boundKey then
                    if kbOpts.SyncToggleState then
                        obj:SetValue(not obj.Value)
                    end
                    if type(kbOpts.OnPressed) == "function" then safeCall(kbOpts.OnPressed) end
                    emit(kbObj, kbOpts, boundKey)
                end
            end)

            Library.Options[kbName] = kbObj
            Library.Flags[kbName] = boundKey
            return kbObj
        end

        return obj
    end

    function api:AddSlider(idx, o)
        o = o or {}
        local min, max, rnd = o.Min or 0, o.Max or 100, o.Rounding or 0
        local obj = { Value = math.clamp(o.Default or min, min, max), Type = "Slider" }
        attachCallbacks(obj)

        local row = New("Frame", {
            Size = UDim2.new(1, 0, 0, 50),
            BackgroundColor3 = T.Group,
            BackgroundTransparency = 1,
        }, holder)
        RowHover(row)

        local l = Label(row, o.Text or idx, 13, T.Text)
        l.Position = UDim2.fromOffset(6, 6)
        l.Size = UDim2.new(0.62, 0, 0, 18)

        local valLabel = Label(row, "", 13, T.SubText)
        valLabel.AnchorPoint = Vector2.new(1, 0)
        valLabel.Position = UDim2.new(1, -8, 0, 6)
        valLabel.Size = UDim2.new(0.35, 0, 0, 18)
        valLabel.TextXAlignment = Enum.TextXAlignment.Right

        local bar = New("TextButton", {
            Text = "",
            Position = UDim2.fromOffset(6, 34),
            Size = UDim2.new(1, -12, 0, 5),
            BackgroundColor3 = T.Element,
            BackgroundTransparency = T.ElementTransparency or 0,
            AutoButtonColor = false,
        }, row)
        Corner(bar, 3)
        Stroke(bar, T.Stroke, 0.55)

        local fill = New("Frame", {
            Size = UDim2.fromScale(0, 1),
            BackgroundColor3 = T.Accent,
        }, bar)
        Corner(fill, 3)

        local knob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(13, 13),
            BackgroundColor3 = T.Accent,
        }, bar)
        Corner(knob, 6)
        Stroke(knob, T.Stroke, 0.25)

        function obj:SetValue(v, silent)
            local mult = 10 ^ rnd
            v = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
            obj.Value = v
            Library.Flags[idx] = v
            local alpha = (v - min) / (max - min)
            Tween(fill, 0.1, { Size = UDim2.fromScale(alpha, 1) })
            Tween(knob, 0.1, { Position = UDim2.new(alpha, 0, 0.5, 0) })
            valLabel.Text = tostring(v) .. (o.Suffix or "")
            if not silent then emit(obj, o, v) end
        end

        local dragging = false
        local function update(x)
            local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            obj:SetValue(min + (max - min) * alpha)
        end
        Connect(bar.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input.Position.X)
            end
        end)
        Connect(UIS.InputChanged, function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                update(input.Position.X)
            end
        end)
        Connect(UIS.InputEnded, function() dragging = false end)

        reg(idx, obj)
        obj:SetValue(obj.Value, true)
        return obj
    end

