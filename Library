local IconLib
pcall(function() IconLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"))() end)
function Library:ApplyIcon(img, name)
	if type(name) == "number" then name = "rbxassetid://" .. name end
	if type(name) == "string" and (name:match("^rbxassetid://") or name:match("^rbxasset://")) then
		img.Image = name; img.Visible = true; return true
	end
	if IconLib and type(name) == "string" then
		name = name:gsub("^lucide[%-:]", "")
		local ok, res = pcall(function() return IconLib.GetAsset(name) end)
		if ok and res then
			img.Image = res.Url; img.ImageRectSize = res.ImageRectSize; img.ImageRectOffset = res.ImageRectOffset; img.Visible = true; return true
		end
	end
	img.Visible = false
	return false
end

