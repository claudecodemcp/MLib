-- CreateWindow
-------------------------------------------------
function ScriptLib:CreateWindow(config)
    config = config or {}
    local Title     = config.Title or "Script Lib"
    local Size      = config.Size or UDim2.fromOffset(560, 400)
    local Position  = config.Position or UDim2.fromOffset(100, 80)
    local ToggleKey = config.ToggleKey or Enum.KeyCode.RightControl

    local Window = {
        Tabs = {},
        ActiveTab = nil,
        Flags = ScriptLib.Flags,
    }

    -- Main frame
    local Main = Create("Frame", {
        Name = "Main",
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = Theme.WindowTransparency,
        BorderSizePixel = 0,
        Position = Position,
        Size = Size,
        ClipsDescendants = true,
        Parent = ScreenGui,
    })
    AddCorner(Main)
    AddStroke(Main, 0.4)
    AddNoise(Main)
    AddVignette(Main)

    -- Soft open animation
    Main.Size = UDim2.fromOffset(Size.X.Offset * 0.92, Size.Y.Offset * 0.92)
    Main.BackgroundTransparency = 1
    Tween(Main, {
        Size = Size,
        BackgroundTransparency = Theme.WindowTransparency,
    }, TweenInfoMed)

    -- Top bar
    local TopBar = Create("Frame", {
        Name = "TopBar",
        BackgroundColor3 = Theme.Secondary,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 38),
        ZIndex = 5,
        Parent = Main,
    })
    AddCorner(TopBar)
    Create("Frame", {
        BackgroundColor3 = Theme.Secondary,
        BackgroundTransparency = 0.2,
        BorderSizePixel = 0,
        Position = UDim2.new(0, 0, 1, -12),
        Size = UDim2.new(1, 0, 0, 12),
        ZIndex = 5,
        Parent = TopBar,
    })

    local TitleLabel = Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 0),
        Size = UDim2.new(1, -50, 1, 0),
        Font = Enum.Font.GothamMedium,
        Text = Title,
        TextColor3 = Theme.Text,
        TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 6,
        Parent = TopBar,
    })

    local CloseBtn = Create("TextButton", {
        BackgroundTransparency = 1,
        Position = UDim2.new(1, -32, 0.5, -10),
        Size = UDim2.fromOffset(20, 20),
        Font = Enum.Font.GothamBold,
        Text = "×",
        TextColor3 = Theme.TextDim,
        TextSize = 18,
        ZIndex = 6,
        Parent = TopBar,
    })
    CloseBtn.MouseEnter:Connect(function()
        Tween(CloseBtn, { TextColor3 = Theme.Danger })
    end)
    CloseBtn.MouseLeave:Connect(function()
        Tween(CloseBtn, { TextColor3 = Theme.TextDim })
    end)
    CloseBtn.MouseButton1Click:Connect(function()
        Tween(Main, {
            Size = UDim2.fromOffset(Size.X.Offset * 0.92, Size.Y.Offset * 0.92),
            BackgroundTransparency = 1,
        }, TweenInfoMed)
        task.delay(0.25, function()
            Main.Visible = false
            Main.Size = Size
            Main.BackgroundTransparency = Theme.WindowTransparency
        end)
    end)

    MakeDraggable(Main, TopBar)

    -- Tab bar
    local TabBar = Create("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 38),
        Size = UDim2.new(1, 0, 0, 30),
        ZIndex = 5,
        Parent = Main,
    })
    Create("UIListLayout", {
        FillDirection = Enum.FillDirection.Horizontal,
        Padding = UDim.new(0, 4),
        SortOrder = Enum.SortOrder.LayoutOrder,
        Parent = TabBar,
    })
    Create("UIPadding", {
        PaddingLeft = UDim.new(0, 10),
        PaddingTop = UDim.new(0, 4),
        Parent = TabBar,
    })

    -- Content
    local Content = Create("Frame", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(0, 68),
        Size = UDim2.new(1, 0, 1, -68),
        ClipsDescendants = true,
        Parent = Main,
    })

    -------------------------------------------------
    -- AddTab
    -------------------------------------------------
    function Window:AddTab(name)
        local Tab = { Name = name }

        local TabBtn = Create("TextButton", {
            BackgroundColor3 = Theme.Tertiary,
            BackgroundTransparency = 1,
            Size = UDim2.fromOffset(0, 22),
            AutomaticSize = Enum.AutomaticSize.X,
            Font = Enum.Font.Gotham,
            Text = "  " .. name .. "  ",
            TextColor3 = Theme.TextDim,
            TextSize = 12,
            AutoButtonColor = false,
            ZIndex = 6,
            Parent = TabBar,
        })
        AddCorner(TabBtn, 6)

        local Indicator = Create("Frame", {
            BackgroundColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Position = UDim2.new(0, 4, 1, -2),
            Size = UDim2.new(1, -8, 0, 2),
            Visible = false,
            ZIndex = 7,
            Parent = TabBtn,
        })
        AddCorner(Indicator, 2)

        local TabPage = Create("ScrollingFrame", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            CanvasSize = UDim2.new(0, 0, 0, 0),
            ScrollBarThickness = 2,
            ScrollBarImageColor3 = Theme.Accent,
            BorderSizePixel = 0,
            Visible = false,
            Parent = Content,
        })

        local LeftCol = Create("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.fromOffset(10, 8),
            Size = UDim2.new(0.5, -14, 1, -16),
            Parent = TabPage,
        })
        local LeftLayout = Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = LeftCol,
        })

        local RightCol = Create("Frame", {
            BackgroundTransparency = 1,
            Position = UDim2.new(0.5, 4, 0, 8),
            Size = UDim2.new(0.5, -14, 1, -16),
            Parent = TabPage,
        })
        local RightLayout = Create("UIListLayout", {
            Padding = UDim.new(0, 8),
            SortOrder = Enum.SortOrder.LayoutOrder,
            Parent = RightCol,
        })

        local function UpdateCanvas()
            local h = math.max(LeftLayout.AbsoluteContentSize.Y, RightLayout.AbsoluteContentSize.Y)
            TabPage.CanvasSize = UDim2.new(0, 0, 0, h + 20)
        end
        LeftLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)
        RightLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(UpdateCanvas)

        function Tab:Show()
            if Window.ActiveTab then
                Window.ActiveTab.Page.Visible = false
                Tween(Window.ActiveTab.Button, {
                    BackgroundTransparency = 1,
                    TextColor3 = Theme.TextDim,
                })
                Window.ActiveTab.Indicator.Visible = false
            end
            TabPage.Visible = true
            Tween(TabBtn, {
                BackgroundTransparency = 0,
                TextColor3 = Theme.Text,
            })
            Indicator.Visible = true
            Window.ActiveTab = { Page = TabPage, Button = TabBtn, Indicator = Indicator }
        end

        TabBtn.MouseButton1Click:Connect(function()
            Tab:Show()
        end)

        -------------------------------------------------
        -- Groupbox
        -------------------------------------------------
        local function CreateGroupbox(side, name)
            local Holder = side == 1 and LeftCol or RightCol

            local Box = Create("Frame", {
                BackgroundColor3 = Theme.Secondary,
                BackgroundTransparency = 0.25,
                BorderSizePixel = 0,
                Size = UDim2.new(1, 0, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                Parent = Holder,
            })
            AddCorner(Box, 10)
            AddStroke(Box, 0.55)
            AddNoise(Box)

            Create("TextLabel", {
                BackgroundTransparency = 1,
                Size = UDim2.new(1, -16, 0, 26),
                Position = UDim2.fromOffset(10, 2),
                Font = Enum.Font.GothamMedium,
                Text = name,
                TextColor3 = Theme.Text,
                TextSize = 12,
                TextXAlignment = Enum.TextXAlignment.Left,
                ZIndex = 2,
                Parent = Box,
            })

            local Container = Create("Frame", {
                BackgroundTransparency = 1,
                Position = UDim2.fromOffset(8, 28),
                Size = UDim2.new(1, -16, 0, 0),
                AutomaticSize = Enum.AutomaticSize.Y,
                ZIndex = 2,
                Parent = Box,
            })
            Create("UIListLayout", {
                Padding = UDim.new(0, 5),
                SortOrder = Enum.SortOrder.LayoutOrder,
                Parent = Container,
            })
            Create("UIPadding", {
                PaddingBottom = UDim.new(0, 10),
                Parent = Container,
            })

            local Groupbox = { Container = Container }

            -- AddLabel
            function Groupbox:AddLabel(text)
                return Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 16),
                    Font = Enum.Font.Gotham,
                    Text = tostring(text),
                    TextColor3 = Theme.TextDim,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    TextWrapped = true,
                    Parent = Container,
                })
            end

            -- AddButton
            function Groupbox:AddButton(text, callback)
                local Btn = Create("TextButton", {
                    BackgroundColor3 = Theme.Tertiary,
                    Size = UDim2.new(1, 0, 0, 28),
                    Font = Enum.Font.Gotham,
                    Text = text,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    AutoButtonColor = false,
                    Parent = Container,
                })
                AddCorner(Btn, 7)

                Btn.MouseEnter:Connect(function()
                    Tween(Btn, { BackgroundColor3 = Theme.Accent })
                end)
                Btn.MouseLeave:Connect(function()
                    Tween(Btn, { BackgroundColor3 = Theme.Tertiary })
                end)
                Btn.MouseButton1Click:Connect(function()
                    if callback then task.spawn(callback) end
                end)
                return Btn
            end

            -- AddToggle
            function Groupbox:AddToggle(flag, options)
                options = options or {}
                local Text     = options.Text or flag or "Toggle"
                local Default  = options.Default == true
                local Callback = options.Callback or function() end

                ScriptLib.Flags[flag] = Default

                local Row = Create("Frame", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 24),
                    Parent = Container,
                })

                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -44, 1, 0),
                    Font = Enum.Font.Gotham,
                    Text = Text,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Row,
                })

                local ToggleBg = Create("Frame", {
                    BackgroundColor3 = Default and Theme.ToggleOn or Theme.ToggleOff,
                    Position = UDim2.new(1, -38, 0.5, -9),
                    Size = UDim2.fromOffset(36, 18),
                    Parent = Row,
                })
                AddCorner(ToggleBg, 99)

                local Circle = Create("Frame", {
                    BackgroundColor3 = Color3.new(1, 1, 1),
                    Position = Default and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                    Size = UDim2.fromOffset(14, 14),
                    Parent = ToggleBg,
                })
                AddCorner(Circle, 99)

                local function Set(val)
                    ScriptLib.Flags[flag] = val
                    Tween(ToggleBg, { BackgroundColor3 = val and Theme.ToggleOn or Theme.ToggleOff })
                    Tween(Circle, {
                        Position = val and UDim2.new(1, -16, 0.5, -7) or UDim2.new(0, 2, 0.5, -7),
                    })
                    Callback(val)
                end

                local Hit = Create("TextButton", {
                    BackgroundTransparency = 1,
                    Size = UDim2.fromScale(1, 1),
                    Text = "",
                    Parent = Row,
                })
                Hit.MouseButton1Click:Connect(function()
                    Set(not ScriptLib.Flags[flag])
                end)

                return { Set = Set, Get = function() return ScriptLib.Flags[flag] end }
            end

            -- AddSlider
            function Groupbox:AddSlider(flag, options)
                options = options or {}
                local Text     = options.Text or flag or "Slider"
                local Min      = options.Min or 0
                local Max      = options.Max or 100
                local Default  = math.clamp(options.Default or Min, Min, Max)
                local Rounding = options.Rounding or 0
                local Suffix   = options.Suffix or ""
                local Callback = options.Callback or function() end

                ScriptLib.Flags[flag] = Default

                local Row = Create("Frame", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 38),
                    Parent = Container,
                })

                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, -50, 0, 14),
                    Font = Enum.Font.Gotham,
                    Text = Text,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Row,
                })

                local ValueLabel = Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Position = UDim2.new(1, -48, 0, 0),
                    Size = UDim2.fromOffset(48, 14),
                    Font = Enum.Font.Gotham,
                    Text = tostring(Default) .. Suffix,
                    TextColor3 = Theme.TextDim,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Right,
                    Parent = Row,
                })

                local BarBg = Create("Frame", {
                    BackgroundColor3 = Theme.SliderBg,
                    Position = UDim2.fromOffset(0, 22),
                    Size = UDim2.new(1, 0, 0, 6),
                    Parent = Row,
                })
                AddCorner(BarBg, 99)

                local Fill = Create("Frame", {
                    BackgroundColor3 = Theme.Accent,
                    Size = UDim2.new((Default - Min) / math.max(Max - Min, 1), 0, 1, 0),
                    Parent = BarBg,
                })
                AddCorner(Fill, 99)

                local dragging = false
                local function Update(val)
                    val = math.clamp(val, Min, Max)
                    val = Round(val, Rounding)
                    ScriptLib.Flags[flag] = val
                    local pct = (val - Min) / math.max(Max - Min, 1)
                    Tween(Fill, { Size = UDim2.new(pct, 0, 1, 0) })
                    ValueLabel.Text = tostring(val) .. Suffix
                    Callback(val)
                end

                local function fromInput(input)
                    local rel = math.clamp(
                        (input.Position.X - BarBg.AbsolutePosition.X) / BarBg.AbsoluteSize.X,
                        0, 1
                    )
                    Update(Min + (Max - Min) * rel)
                end

                BarBg.InputBegan:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = true
                        fromInput(input)
                    end
                end)
                UserInputService.InputEnded:Connect(function(input)
                    if input.UserInputType == Enum.UserInputType.MouseButton1
                    or input.UserInputType == Enum.UserInputType.Touch then
                        dragging = false
                    end
                end)
                UserInputService.InputChanged:Connect(function(input)
                    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                    or input.UserInputType == Enum.UserInputType.Touch) then
                        fromInput(input)
                    end
                end)

                return { Set = Update, Get = function() return ScriptLib.Flags[flag] end }
            end

            -- AddDropdown
            function Groupbox:AddDropdown(flag, options)
                options = options or {}
                local Text     = options.Text or flag or "Dropdown"
                local Values   = options.Values or { "Option 1" }
                local Default  = options.Default or Values[1]
                local Callback = options.Callback or function() end

                ScriptLib.Flags[flag] = Default

                local Row = Create("Frame", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 46),
                    Parent = Container,
                })

                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 14),
                    Font = Enum.Font.Gotham,
                    Text = Text,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Row,
                })

                local DropBtn = Create("TextButton", {
                    BackgroundColor3 = Theme.Tertiary,
                    Position = UDim2.fromOffset(0, 18),
                    Size = UDim2.new(1, 0, 0, 26),
                    Font = Enum.Font.Gotham,
                    Text = "  " .. tostring(Default) .. "  ▼",
                    TextColor3 = Theme.Text,
                    TextSize = 11,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    AutoButtonColor = false,
                    Parent = Row,
                })
                AddCorner(DropBtn, 7)

                local Open = false
                local ListFrame = Create("Frame", {
                    BackgroundColor3 = Theme.Secondary,
                    BackgroundTransparency = 0.05,
                    Position = UDim2.new(0, 0, 1, 4),
                    Size = UDim2.new(1, 0, 0, 0),
                    Visible = false,
                    ZIndex = 60,
                    Parent = DropBtn,
                })
                AddCorner(ListFrame, 8)
                AddStroke(ListFrame, 0.35)
                Create("UIListLayout", {
                    SortOrder = Enum.SortOrder.LayoutOrder,
                    Parent = ListFrame,
                })

                local function Close()
                    Open = false
                    Tween(ListFrame, { Size = UDim2.new(1, 0, 0, 0) })
                    task.delay(0.15, function()
                        if not Open then ListFrame.Visible = false end
                    end)
                end

                for _, val in ipairs(Values) do
                    local Opt = Create("TextButton", {
                        BackgroundTransparency = 1,
                        Size = UDim2.new(1, 0, 0, 24),
                        Font = Enum.Font.Gotham,
                        Text = "  " .. tostring(val),
                        TextColor3 = Theme.Text,
                        TextSize = 11,
                        TextXAlignment = Enum.TextXAlignment.Left,
                        ZIndex = 61,
                        Parent = ListFrame,
                    })
                    Opt.MouseEnter:Connect(function()
                        Opt.BackgroundTransparency = 0.85
                        Opt.BackgroundColor3 = Theme.Accent
                    end)
                    Opt.MouseLeave:Connect(function()
                        Opt.BackgroundTransparency = 1
                    end)
                    Opt.MouseButton1Click:Connect(function()
                        ScriptLib.Flags[flag] = val
                        DropBtn.Text = "  " .. tostring(val) .. "  ▼"
                        Callback(val)
                        Close()
                    end)
                end

                DropBtn.MouseButton1Click:Connect(function()
                    if Open then
                        Close()
                    else
                        Open = true
                        ListFrame.Visible = true
                        Tween(ListFrame, { Size = UDim2.new(1, 0, 0, #Values * 24) })
                    end
                end)

                return {
                    Set = function(v)
                        ScriptLib.Flags[flag] = v
                        DropBtn.Text = "  " .. tostring(v) .. "  ▼"
                        Callback(v)
                    end,
                    Get = function() return ScriptLib.Flags[flag] end,
                }
            end

            -- AddInput
            function Groupbox:AddInput(flag, options)
                options = options or {}
                local Text        = options.Text or flag or "Input"
                local Default     = options.Default or ""
                local Placeholder = options.Placeholder or ""
                local Callback    = options.Callback or function() end

                ScriptLib.Flags[flag] = Default

                local Row = Create("Frame", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 46),
                    Parent = Container,
                })

                Create("TextLabel", {
                    BackgroundTransparency = 1,
                    Size = UDim2.new(1, 0, 0, 14),
                    Font = Enum.Font.Gotham,
                    Text = Text,
                    TextColor3 = Theme.Text,
                    TextSize = 12,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    Parent = Row,
                })

                local Box = Create("TextBox", {
                    BackgroundColor3 = Theme.Tertiary,
                    Position = UDim2.fromOffset(0, 18),
                    Size = UDim2.new(1, 0, 0, 26),
                    Font = Enum.Font.Gotham,
                    Text = Default,
                    PlaceholderText = Placeholder,
                    TextColor3 = Theme.Text,
                    PlaceholderColor3 = Theme.TextDim,
                    TextSize = 11,
                    ClearTextOnFocus = false,
                    Parent = Row,
                })
                AddCorner(Box, 7)
                Create("UIPadding", {
                    PaddingLeft = UDim.new(0, 8),
                    PaddingRight = UDim.new(0, 8),
                    Parent = Box,
                })

                Box.FocusLost:Connect(function()
                    ScriptLib.Flags[flag] = Box.Text
                    Callback(Box.Text)
                end)

                return {
                    Set = function(v)
                        Box.Text = tostring(v)
                        ScriptLib.Flags[flag] = v
                        Callback(v)
                    end,
                    Get = function() return ScriptLib.Flags[flag] end,
                }
            end

            -- AddDivider
            function Groupbox:AddDivider()
                Create("Frame", {
                    BackgroundColor3 = Theme.Outline,
                    BackgroundTransparency = 0.4,
                    BorderSizePixel = 0,
                    Size = UDim2.new(1, 0, 0, 1),
                    Parent = Container,
                })
            end

            return Groupbox
        end

        function Tab:AddLeftGroupbox(name)  return CreateGroupbox(1, name) end
        function Tab:AddRightGroupbox(name) return CreateGroupbox(2, name) end
        function Tab:AddGroupbox(name, side) return CreateGroupbox(side or 1, name) end

        table.insert(Window.Tabs, Tab)
        if not Window.ActiveTab then Tab:Show() end
        return Tab
    end

    function Window:SetTitle(t) TitleLabel.Text = t end

    function Window:Toggle(state)
        if typeof(state) == "boolean" then
            Main.Visible = state
        else
            Main.Visible = not Main.Visible
        end
        if Main.Visible then
            Main.Size = UDim2.fromOffset(Size.X.Offset * 0.92, Size.Y.Offset * 0.92)
            Main.BackgroundTransparency = 1
            Tween(Main, {
                Size = Size,
                BackgroundTransparency = Theme.WindowTransparency,
            }, TweenInfoMed)
        end
    end

    UserInputService.InputBegan:Connect(function(input, gpe)
        if gpe then return end
        if input.KeyCode == ToggleKey then
            Window:Toggle()
        end
    end)

    return Window
end

