		Tab.Btn, Tab.Img, Tab.Fallback, Tab.Page, Tab.Glow, Tab.BtnScale = btn, img, fb, page, glow, btnScale

		Connect(btn.MouseButton1Click, function()
			Library:PlaySound("Tab")
			Win:Select(Tab)
		end)
