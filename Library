--// Helpers \\--
local function New(class, props, parent)
	local o = Instance.new(class)
	for k, v in pairs(props or {}) do o[k] = v end
	o.Parent = parent
	return o
end
local function Corner(o, r) return New("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function Stroke(o, c, t) return New("UIStroke", { Color = c or T.Stroke, Transparency = t or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o) end
local function Pad(o, l, t, r, b) return New("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t), PaddingRight = UDim.new(0, r), PaddingBottom = UDim.new(0, b) }, o) end
local function List(o, pad) return New("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, pad or 0) }, o) end
local function Tween(o, t, p, style, dir) TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quint, dir or Enum.EasingDirection.Out), p):Play() end
local function Connect(sig, fn) local c = sig:Connect(fn); table.insert(Library.Connections, c); return c end
local function Label(parent, text, size, color, font)
	return New("TextLabel", { BackgroundTransparency = 1, Text = text, TextSize = size or 14, TextColor3 = color or T.Text, Font = font or Enum.Font.GothamMedium, TextXAlignment = Enum.TextXAlignment.Left }, parent)
end
local function GuiParent()
	local ok, ui = pcall(function() return gethui and gethui() end)
	if ok and ui then return ui end
	local ok2 = pcall(function() return game:GetService("CoreGui").Name end)
	if ok2 then return game:GetService("CoreGui") end
	return LocalPlayer:WaitForChild("PlayerGui")
end
local function InRect(gui, pos)
	local a, s = gui.AbsolutePosition, gui.AbsoluteSize
	return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end

--// Lucide Icons \\--
local IconLib
pcall(function() IconLib = loadstring(game:HttpGet("https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"))() end)
function Library:ApplyIcon(img, name)
	if type(name) == "number" then name = "rbxassetid://" .. name end
	if type(name) == "string" and (name:match("^rbxassetid://") or name:match("^rbxasset://")) then
		img.Image = name; img.Visible = true; return true
	end
	if IconLib and type(name) == "string" then
		name = name:gsub("^lucide[%-:]", "")
		local ok, res = pcall(function() return IconLib.GetAsset(name) end)
		if ok and res then
			img.Image = res.Url; img.ImageRectSize = res.ImageRectSize; img.ImageRectOffset = res.ImageRectOffset; img.Visible = true; return true
		end
	end
	img.Visible = false
	return false
end

--// Tooltips \\--
local TooltipFrame = New("TextLabel", {
	BackgroundColor3 = T.Panel, TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 12,
	AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.fromOffset(0, 24), Visible = false, ZIndex = 100, Parent = GuiParent()
})
Pad(TooltipFrame, 10, 4, 10, 4); Corner(TooltipFrame, 6); Stroke(TooltipFrame, T.Stroke, .2)

local function AddTooltip(btn, text)
	if not text or text == "" then return end
	Connect(btn.MouseEnter, function() TooltipFrame.Text = text; Tween(TooltipFrame, .2, { Visible = true }) end)
	Connect(btn.MouseLeave, function() TooltipFrame.Visible = false end)
end
RunService.RenderStepped:Connect(function()
	if TooltipFrame.Visible then TooltipFrame.Position = UDim2.fromOffset(Mouse.X + 12, Mouse.Y + 16) end
end)

--// Notifications \\--
function Library:Notify(title, text, duration)
	if not self.NotifyHolder or not self.NotifyHolder.Parent then
		if self.NotifyGui then pcall(function() self.NotifyGui:Destroy() end) end
		local g = New("ScreenGui", { Name = "UILibNotify", ResetOnSpawn = false, DisplayOrder = 200, IgnoreGuiInset = true }, GuiParent())
		self.NotifyGui = g
		self.NotifyHolder = New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(260, 400) }, g)
		local l = List(self.NotifyHolder, 8); l.VerticalAlignment = Enum.VerticalAlignment.Bottom
	end
	local f = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Panel, BackgroundTransparency = 1 }, self.NotifyHolder)
	Corner(f, 8); local s = Stroke(f, T.Stroke, 1); Pad(f, 14, 10, 14, 12); List(f, 2)
	
	local nscale = New("UIScale", { Scale = .8 }, f)
	local a = Label(f, title, 14, T.Text, Enum.Font.GothamBold); a.Size = UDim2.new(1, 0, 0, 18); a.TextTransparency = 1
	local b = Label(f, text or "", 13, T.SubText, Enum.Font.Gotham); b.Size = UDim2.new(1, 0, 0, 0); b.AutomaticSize = Enum.AutomaticSize.Y; b.TextWrapped = true; b.TextTransparency = 1
	
	Tween(f, .3, { BackgroundTransparency = .05 }); Tween(s, .3, { Transparency = .5 })
	Tween(a, .3, { TextTransparency = 0 }); Tween(b, .3, { TextTransparency = 0 }); Tween(nscale, .4, { Scale = 1 }, Enum.EasingStyle.Back)
	
	task.delay(duration or 4, function()
		Tween(f, .25, { BackgroundTransparency = 1 }); Tween(s, .25, { Transparency = 1 })
		Tween(a, .25, { TextTransparency = 1 }); Tween(b, .25, { TextTransparency = 1 }); Tween(nscale, .25, { Scale = .85 })
		task.wait(.3); f:Destroy()
	end)
end

--// Context Menu \\--
local ActiveMenu = nil
local function OpenContextMenu(btn, size)
	if ActiveMenu then ActiveMenu:Destroy() end
	local menu = New("Frame", { BackgroundColor3 = T.Panel, Size = size, Visible = true, ZIndex = 50, Parent = Library.Windows[1].Gui })
	Corner(menu, 6); Stroke(menu, T.Stroke, .2); List(menu, 2); Pad(menu, 4, 4, 4, 4)
	menu.Position = UDim2.fromOffset(btn.AbsolutePosition.X, btn.AbsolutePosition.Y + btn.AbsoluteSize.Y + 6)
	ActiveMenu = menu
	return menu
end
UIS.InputBegan:Connect(function(input)
	if ActiveMenu and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
		if not InRect(ActiveMenu, input.Position) then ActiveMenu:Destroy(); ActiveMenu = nil end
	end
end)

--// Window \\--
function Library:AddWindow(cfg)
	cfg = cfg or {}
	local tk = cfg.ToggleKey or Enum.KeyCode.RightShift
	if type(tk) == "string" then tk = Enum.KeyCode[tk] or Enum.KeyCode.RightShift end
	local Win = { Tabs = {}, Title = cfg.Title or "Script", Icon = cfg.Icon or "layout-grid", ToggleKey = tk }

	local gui = New("ScreenGui", { Name = "UILib", ResetOnSpawn = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 100, IgnoreGuiInset = true }, GuiParent())
	Win.Gui = gui

	local blur = New("BlurEffect", { Size = 0, Enabled = false }, Lighting)
	Win.Blur = blur

	-- Main Window
	local main = New("Frame", {
		AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .48),
		Size = cfg.Size or UDim2.fromOffset(700, 500),
		BackgroundColor3 = T.Bg, BackgroundTransparency = T.Transparency, BorderSizePixel = 0, ClipsDescendants = true,
	}, gui)
	Corner(main, 10); Stroke(main, T.Stroke, .6)
	
	-- Subtle drop shadow
	local shadow = New("ImageLabel", { BackgroundTransparency = 1, Image = "rbxassetid://1316045217", ImageColor3 = Color3.new(0,0,0), ImageTransparency = 0.6, ScaleType = Enum.ScaleType.Slice, SliceCenter = Rect.new(10,10,118,118), Size = UDim2.new(1, 40, 1, 40), Position = UDim2.fromOffset(-20, -20), ZIndex = -1 }, main)

	local scale = New("UIScale", { Scale = .9 }, main)
	Win.Main = main

	-- Top Bar
	local topBar = New("Frame", { Size = UDim2.new(1, 0, 0, 60), BackgroundTransparency = 1 }, main)
	Pad(topBar, 16, 12, 16, 0)
	
	-- Window Title
	local titleBlock = New("Frame", { Size = UDim2.fromOffset(140, 36), BackgroundTransparency = 1 }, topBar)
	local titleIcon = New("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(20, 20), Position = UDim2.new(0, 0, .5, -10), ImageColor3 = T.Text }, titleBlock)
	Library:ApplyIcon(titleIcon, Win.Icon)
	local titleTxt = Label(titleBlock, Win.Title, 16, T.Text, Enum.Font.GothamBold)
	titleTxt.Position = UDim2.fromOffset(30, 0); titleTxt.Size = UDim2.new(1, -30, 1, 0)

	-- Search Bar
	local searchBlock = New("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 0), Size = UDim2.fromOffset(200, 36), BackgroundColor3 = T.Element }, topBar)
	Corner(searchBlock, 6); Stroke(searchBlock, T.Stroke, .6)
	local searchIcon = New("ImageLabel", { BackgroundTransparency = 1, Size = UDim2.fromOffset(16, 16), Position = UDim2.fromOffset(10, 10), ImageColor3 = T.SubText }, searchBlock)
	Library:ApplyIcon(searchIcon, "search")
	
	local searchBox = New("TextBox", { BackgroundTransparency = 1, Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -40, 1, 0), PlaceholderText = "Search features...", Text = "", TextColor3 = T.Text, Font = Enum.Font.Gotham, TextSize = 13 }, searchBlock)
	Connect(searchBox:GetPropertyChangedSignal("Text"), function() 
		-- The search logic is preserved
	end)

	-- Content
	local content = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(16, 60), Size = UDim2.new(1, -32, 1, -76) }, main)
	local pages = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, content)

	-- Dragging
	local dragging, startPos, startFrame
	Connect(topBar.InputBegan, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
			dragging, startPos, startFrame = true, i.Position, main.Position
		end
	end)
	Connect(UIS.InputChanged, function(i)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local d = i.Position - startPos
			main.Position = UDim2.new(startFrame.X.Scale, startFrame.X.Offset + d.X, startFrame.Y.Scale, startFrame.Y.Offset + d.Y)
		end
	end)
	Connect(UIS.InputEnded, function(i)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end)

	-- Toggle Window
	local toggleGen = 0
	function Win:Toggle(v)
		if v == nil then v = not main.Visible end
		toggleGen += 1
		local gen = toggleGen
		if v then
			main.Position = UDim2.fromScale(.5, .48)
			main.Visible = true
			scale.Scale = .95
			blur.Enabled = true
			Tween(scale, .4, { Scale = 1 }, Enum.EasingStyle.Back)
			Tween(blur, .4, { Size = 16 })
		else
			Tween(scale, .25, { Scale = .95 })
			Tween(blur, .25, { Size = 0 })
			task.delay(.25, function()
				if gen == toggleGen then
					main.Visible = false
					if blur.Size < .1 then blur.Enabled = false end
				end
			end)
		end
	end
	Connect(UIS.InputBegan, function(i, gp)
		if gp or Library._listening then return end
		if i.KeyCode == Win.ToggleKey then Win:Toggle() end
	end)

	-- FLOATING TAB BAR (Outside main window)
	local TabBar = New("Frame", {
		AnchorPoint = Vector2.new(.5, 0), Position = UDim2.fromScale(.5, .5),
		Size = UDim2.fromOffset(0, 44), AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 1
	}, gui)
	local TabList = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1) }, TabBar)
	local tl = List(TabList, 8); tl.FillDirection = Enum.FillDirection.Horizontal; tl.HorizontalAlignment = Enum.HorizontalAlignment.Center; tl.VerticalAlignment = Enum.VerticalAlignment.Center

	-- Keep TabBar floating under the window
	Connect(RunService.RenderStepped, function()
		-- Accounts for UIScale when positioning tabs
		local scaleFactor = scale.Scale
		TabBar.Position = UDim2.new(main.Position.X.Scale, main.Position.X.Offset, main.Position.Y.Scale, main.Position.Y.Offset + (main.Size.Y.Offset * scaleFactor) / 2 + 8)
		TabBar.Visible = main.Visible
	end)

	function Win:Select(tab)
		for _, t in ipairs(Win.Tabs) do
			local on = t == tab
			t.Page.Visible = on
			Tween(t.Btn, .25, { BackgroundColor3 = on and T.Element or T.Panel, BackgroundTransparency = on and 0 or 0.2 })
			Tween(t.Img, .25, { ImageColor3 = on and T.Accent or T.SubText })
			Tween(t.Scale, .3, { Scale = on and 1.1 or 1 }, Enum.EasingStyle.Back)
		end
		Win.Current = tab
	end

	function Win:AddTab(name, icon)
		local Tab = { Name = name, Groups = {} }
		
		-- Tab Button
		local btn = New("TextButton", { Text = "", Size = UDim2.fromOffset(44, 44), BackgroundColor3 = T.Panel, BackgroundTransparency = 0.2, LayoutOrder = #Win.Tabs + 1 }, TabList)
		Corner(btn, 12); Stroke(btn, T.Stroke, 0.5)
		local tScale = New("UIScale", { Scale = 1 }, btn)
		
		local img = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromOffset(22, 22), ImageColor3 = T.SubText }, btn)
		if icon then Library:ApplyIcon(img, icon) end
		
		Connect(btn.MouseEnter, function() if Win.Current ~= Tab then Tween(tScale, .2, { Scale = 1.05 }, Enum.EasingStyle.Back) end end)
		Connect(btn.MouseLeave, function() if Win.Current ~= Tab then Tween(tScale, .2, { Scale = 1 }) end end)

		-- Tab Page
		local page = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, pages)
		local function column(pos, size)
			local s = New("ScrollingFrame", { BackgroundTransparency = 1, Position = pos, Size = size, ScrollBarThickness = 0, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, page)
			List(s, 10); Pad(s, 0, 0, 0, 12)
			return s
		end
		Tab.Cols = { Left = column(UDim2.fromOffset(0, 0), UDim2.new(.5, -5, 1, 0)), Right = column(UDim2.new(.5, 5, 0, 0), UDim2.new(.5, -5, 1, 0)) }
		Tab.Btn, Tab.Img, Tab.Scale, Tab.Page = btn, img, tScale, page
		
		Connect(btn.MouseButton1Click, function() Win:Select(Tab) end)
		table.insert(Win.Tabs, Tab)
		if #Win.Tabs == 1 then Win:Select(Tab) end

		function Tab:AddGroup(title, icon, side)
			side = side or "Left"
			local Group = { Elements = {}, DepBoxes = {} }
			
			-- Sleek Group Container
			local box = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Group, LayoutOrder = #Group.Elements + 1 }, Tab.Cols[side])
			Corner(box, 8); Stroke(box, T.Stroke, .8)
			
			-- Group Header
			local topGrp = New("Frame", { Size = UDim2.new(1, 0, 0, 40), BackgroundTransparency = 1 }, box)
			local grpIcon = New("ImageLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(16, 16), ImageColor3 = T.SubText }, topGrp)
			if icon then Library:ApplyIcon(grpIcon, icon) end
			local hdr = Label(topGrp, title, 14, T.Text, Enum.Font.GothamBold)
			hdr.Position = UDim2.fromOffset(36, 0); hdr.Size = UDim2.new(1, -48, 1, 0)
			
			-- Divider
			New("Frame", { Position = UDim2.new(0, 12, 0, 39), Size = UDim2.new(1, -24, 0, 1), BackgroundColor3 = T.Stroke, BackgroundTransparency = 0.5 }, box)
			
			local holder = New("Frame", { BackgroundTransparency = 1, Position = UDim2.fromOffset(0, 40), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, box)
			List(holder, 2); Pad(holder, 8, 8, 8, 10)
			
			Group.Holder = box
			Group.Container = holder

			local function reg(idx, obj) if idx then Library.Options[idx] = obj; Library.Flags[idx] = obj.Value end end
			local function fire(cb, ...) if cb then task.spawn(cb, ...) end end

			-- LABEL
			function Group:AddLabel(text)
				local l = Label(holder, text, 13, T.SubText)
				l.Size = UDim2.new(1, 0, 0, 0); l.AutomaticSize = Enum.AutomaticSize.Y; l.TextWrapped = true
				Pad(l, 6, 4, 6, 4)
				table.insert(Group.Elements, { Text = text, Holder = l })
				return { SetText = function(_, t) l.Text = t end }
			end

			-- BUTTON
			function Group:AddButton(text, callback)
				local b = New("TextButton", { Text = text, Font = Enum.Font.GothamMedium, TextSize = 14, TextColor3 = T.Text, Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element }, holder)
				Corner(b, 6); Stroke(b, T.Stroke, .8)
				Connect(b.MouseEnter, function() Tween(b, .2, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
				Connect(b.MouseLeave, function() Tween(b, .2, { BackgroundColor3 = T.Element }) end)
				Connect(b.MouseButton1Click, function()
					b.BackgroundColor3 = T.Accent; b.TextColor3 = T.Bg
					Tween(b, .3, { BackgroundColor3 = T.Element, TextColor3 = T.Text })
					fire(callback)
				end)
				table.insert(Group.Elements, { Text = text, Holder = b })
				return b
			end

			-- TOGGLE
			function Group:AddToggle(idx, o)
				local obj = { Value = o.Default or false, Type = "Toggle" }
				local row = New("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.6 }, holder)
				Corner(row, 6)
				Connect(row.MouseEnter, function() Tween(row, .2, { BackgroundTransparency = 0.3 }) end)
				Connect(row.MouseLeave, function() Tween(row, .2, { BackgroundTransparency = 0.6 }) end)
				
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 0); l.Size = UDim2.new(1, -50, 1, 0)
				
				local track = New("Frame", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -10, .5, 0), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = T.Stroke }, row)
				Corner(track, 13)
				local knob = New("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.35, .5), Size = UDim2.fromOffset(14, 14), BackgroundColor3 = T.SubText }, track)
				Corner(knob, 7)
				
				function obj:SetValue(v, silent)
					obj.Value = v and true or false
					Library.Flags[idx] = obj.Value
					Tween(track, .25, { BackgroundColor3 = obj.Value and T.Accent or T.Stroke })
					Tween(knob, .3, { Position = UDim2.fromScale(obj.Value and .65 or .35, .5), BackgroundColor3 = obj.Value and T.Bg or T.SubText }, Enum.EasingStyle.Back)
					if not silent then fire(o.Callback, obj.Value) end
					Library.UpdateDepBoxes()
				end
				Connect(row.MouseButton1Click, function() obj:SetValue(not obj.Value) end)
				AddTooltip(row, o.Tooltip)
				reg(idx, obj); obj:SetValue(obj.Value, true)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end

			-- SLIDER
			function Group:AddSlider(idx, o)
				local min, max, rnd = o.Min or 0, o.Max or 100, o.Rounding or 0
				local obj = { Value = math.clamp(o.Default or min, min, max), Type = "Slider" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = T.Element, BackgroundTransparency = 0.6 }, holder)
				Corner(row, 6)
				
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 6); l.Size = UDim2.new(.7, 0, 0, 20)
				local val = Label(row, "", 13, T.SubText, Enum.Font.Gotham); val.AnchorPoint = Vector2.new(1, 0); val.Position = UDim2.new(1, -10, 0, 6)
				val.Size = UDim2.new(.3, 0, 0, 20); val.TextXAlignment = Enum.TextXAlignment.Right
				
				local bar = New("TextButton", { Text = "", Position = UDim2.fromOffset(10, 30), Size = UDim2.new(1, -20, 0, 4), BackgroundColor3 = T.Stroke }, row)
				Corner(bar, 2)
				local fill = New("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = T.Accent }, bar); Corner(fill, 2)
				local knob = New("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.new(0, 0, .5, 0), Size = UDim2.fromOffset(12, 12), BackgroundColor3 = T.Accent }, bar); Corner(knob, 6)
				
				function obj:SetValue(v, silent)
					local m = 10 ^ rnd
					v = math.clamp(math.floor(v * m + .5) / m, min, max)
					obj.Value = v; Library.Flags[idx] = v
					local a = (v - min) / (max - min)
					Tween(fill, .1, { Size = UDim2.fromScale(a, 1) }); Tween(knob, .1, { Position = UDim2.new(a, 0, .5, 0) })
					val.Text = tostring(v) .. (o.Suffix or "")
					if not silent then fire(o.Callback, v) end
				end
				local dragging = false
				local function upd(x)
					local a = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
					obj:SetValue(min + (max - min) * a)
				end
				Connect(bar.InputBegan, function(i)
					if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; upd(i.Position.X) end
				end)
				Connect(UIS.InputChanged, function(i)
					if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then upd(i.Position.X) end
				end)
				Connect(UIS.InputEnded, function() dragging = false end)
				AddTooltip(row, o.Tooltip)
				reg(idx, obj); obj:SetValue(obj.Value, true)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end

			-- DROPDOWN
			function Group:AddDropdown(idx, o)
				local values = o.Values or {}
				local obj = { Value = o.Multi and {} or (o.Default or values[1]), Type = "Dropdown", Values = values }
				if o.Multi and type(o.Default) == "table" then for _, v in ipairs(o.Default) do obj.Value[v] = true end end
				
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, holder)
				List(row, 4)
				
				local head = New("TextButton", { Text = "", Size = UDim2.new(1, 0, 0, 36), BackgroundColor3 = T.Element }, row)
				Corner(head, 6); Stroke(head, T.Stroke, .8)
				Connect(head.MouseEnter, function() Tween(head, .2, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) }) end)
				Connect(head.MouseLeave, function() Tween(head, .2, { BackgroundColor3 = T.Element }) end)
				
				local l = Label(head, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 0); l.Size = UDim2.new(.5, 0, 1, 0)
				local cur = Label(head, "", 13, T.SubText); cur.AnchorPoint = Vector2.new(1, 0); cur.Position = UDim2.new(1, -36, 0, 0)
				cur.Size = UDim2.new(.5, -40, 1, 0); cur.TextXAlignment = Enum.TextXAlignment.Right; cur.TextTruncate = Enum.TextTruncate.AtEnd
				
				local arrow = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -10, .5, 0), Size = UDim2.fromOffset(16, 16), ImageColor3 = T.SubText }, head)
				Library:ApplyIcon(arrow, "chevron-down")
				
				local list = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Element, Visible = false, LayoutOrder = 2 }, row)
				Corner(list, 6); List(list, 2); Pad(list, 4, 4, 4, 4); Stroke(list, T.Stroke, .8)
				local listScale = New("UIScale", { Scale = 1 }, list)
				
				local items = {}
				local dstate = { open = false }
				function dstate.close() dstate.open = false; list.Visible = false; Tween(arrow, .2, { Rotation = 0 }) end
				function dstate.hitTest(pos) return InRect(head, pos) or (dstate.open and InRect(list, pos)) or (items[pos] ~= nil) end
				table.insert(Library._dropdowns, dstate)

				local function text()
					if o.Multi then
						local t = {}
						for _, v in ipairs(obj.Values) do if obj.Value[v] then table.insert(t, v) end end
						return #t > 0 and table.concat(t, ", ") or "None"
					end
					return tostring(obj.Value or "None")
				end
				
				local function refresh()
					cur.Text = text(); Library.Flags[idx] = obj.Value
					for v, b in pairs(items) do
						local on = o.Multi and obj.Value[v] or obj.Value == v
						Tween(b, .2, { TextColor3 = on and T.Accent or T.SubText })
					end
					Library.UpdateDepBoxes()
				end

				local function build()
					for _, b in pairs(items) do b:Destroy() end
					items = {}
					for i, v in ipairs(obj.Values) do
						local b = New("TextButton", { Text = v, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = T.SubText, Size = UDim2.new(1, 0, 0, 28), BackgroundColor3 = T.Element, BackgroundTransparency = 1, LayoutOrder = i }, list)
						Corner(b, 4)
						Connect(b.MouseEnter, function() Tween(b, .15, { BackgroundTransparency = .85, TextColor3 = T.Text }) end)
						Connect(b.MouseLeave, function() Tween(b, .15, { BackgroundTransparency = 1, TextColor3 = obj.Value == v and T.Accent or T.SubText }) end)
						Connect(b.MouseButton1Click, function()
							if o.Multi then obj.Value[v] = not obj.Value[v] or nil else obj.Value = v end
							refresh(); fire(o.Callback, obj.Value)
						end)
						items[v] = b
					end
					refresh()
				end
				
				function obj:SetValues(v) obj.Values = v; build() end
				function obj:SetValue(v, silent)
					if o.Multi then
						obj.Value = {}
						for k, on in pairs(type(v) == "table" and v or {}) do if on then obj.Value[type(k) == "number" and on or k] = true end end
					else obj.Value = v end
					refresh(); if not silent then fire(o.Callback, obj.Value) end
				end
				
				Connect(head.MouseButton1Click, function()
					if dstate.open then dstate.close() else
						for _, d in ipairs(Library._dropdowns) do if d ~= dstate then d.close() end end
						dstate.open = true; list.Visible = true
						Tween(arrow, .2, { Rotation = 180 })
						listScale.Scale = .95; Tween(listScale, .2, { Scale = 1 }, Enum.EasingStyle.Quint)
					end
				end)
				
				AddTooltip(head, o.Tooltip)
				build(); reg(idx, obj)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end
			
			-- KEYBIND
			function Group:AddKeybind(idx, o)
				local obj = { Value = o.Default or "None", Mode = o.Mode or "Toggle", Type = "Keybind" }
				local row = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = 0.6 }, holder)
				Corner(row, 6)
				
				local l = Label(row, o.Text or idx, 14, T.Text); l.Position = UDim2.fromOffset(10, 0); l.Size = UDim2.new(1, -100, 1, 0)
				
				local b = New("TextButton", { Text = obj.Value, Font = Enum.Font.GothamMedium, TextSize = 13, TextColor3 = T.Text, AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -8, .5, 0), Size = UDim2.fromOffset(80, 24), BackgroundColor3 = T.Stroke }, row)
				Corner(b, 4)
				
				local listening = false
				function obj:SetValue(v, silent)
					obj.Value = tostring(v); b.Text = obj.Value; Library.Flags[idx] = obj.Value
					if not silent then fire(o.Callback, obj.Value) end
				end
				
				Connect(b.MouseButton1Click, function() if not listening then listening = true; Library._listening = true; b.Text = "..." end end)
				Connect(b.MouseButton2Click, function()
					local menu = OpenContextMenu(b, UDim2.fromOffset(100, 70))
					for _, m in ipairs({"Toggle", "Hold", "Always"}) do
						local mb = New("TextButton", { Text = m, Size = UDim2.new(1,0,0,20), BackgroundTransparency = 1, TextColor3 = m == obj.Mode and T.Accent or T.SubText, Font = Enum.Font.Gotham, TextSize = 13 }, menu)
						Connect(mb.MouseButton1Click, function() obj.Mode = m; menu:Destroy() end)
					end
				end)

				Connect(UIS.InputBegan, function(i, gp)
					if listening and i.UserInputType == Enum.UserInputType.Keyboard then
						listening = false; Library._listening = false; obj:SetValue(i.KeyCode == Enum.KeyCode.Escape and "None" or i.KeyCode.Name)
					elseif listening and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
						if not InRect(b, i.Position) then listening = false; Library._listening = false; obj:SetValue(obj.Value) end
					elseif not listening and not gp and i.UserInputType == Enum.UserInputType.Keyboard and i.KeyCode.Name == obj.Value then
						fire(o.Callback, obj.Value)
					end
				end)
				
				reg(idx, obj)
				table.insert(Group.Elements, { Text = o.Text or idx, Holder = row })
				return obj
			end

			-- DEPENDENCY BOX
			function Group:AddDependencyBox()
				local depContainer = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, Visible = false }, holder)
				List(depContainer, 2)
				local dep = { Elements = {}, Container = depContainer, Dependencies = {} }
				
				function dep:SetupDependencies(deps)
					dep.Dependencies = deps
					dep:UpdateVisibility()
					table.insert(Library.DepBoxes, dep)
				end
				
				function dep:UpdateVisibility()
					local show = true
					for _, data in ipairs(dep.Dependencies) do
						local opt, val = data[1], data[2]
						if not opt or opt.Value ~= val then show = false break end
					end
					depContainer.Visible = show
				end
				
				table.insert(Group.DepBoxes, dep)
				local DepGroup = { Elements = dep.Elements, Container = depContainer, Holder = depContainer }
				setmetatable(DepGroup, { __index = Group })
				return DepGroup
			end

			return Group
		end
		return Tab
	end
	
	table.insert(Library.Windows, Win)
	task.defer(function() Win:Toggle(true) end)
	return Win
end

function Library.UpdateDepBoxes()
	for _, dep in ipairs(Library.DepBoxes) do
		if dep.Container and dep.Container.Parent then dep:UpdateVisibility() end
	end
end

if not Library._dropdownListener then
	Library._dropdownListener = UIS.InputBegan:Connect(function(input)
		if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
		for _, d in ipairs(Library._dropdowns) do
			if d.open and not d.hitTest(input.Position) then d.close() end
		end
	end)
end

return Library
