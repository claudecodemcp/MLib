        local Tab = { Name = name, Groups = {}, Tabboxes = {} }
        local btn = New("TextButton", { Text = "", Size = UDim2.fromOffset(42, 42), BackgroundColor3 = T.Bg, BackgroundTransparency = T.BgTransparency or 0, AutoButtonColor = false, LayoutOrder = #Win.Tabs + 1 }, tabList)
        Corner(btn, 8)
        Stroke(btn, T.Stroke, 0.5)
        local img = New("ImageLabel", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(18, 18), ImageColor3 = T.SubText }, btn)
        if icon then Library:ApplyIcon(img, icon) end

        local page = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, pages)
        local function makeColumn(pos, size)
            local scroller = New("ScrollingFrame", { BackgroundTransparency = 1, Position = pos, Size = size, ScrollBarThickness = 3, ScrollBarImageColor3 = Color3.fromRGB(70, 70, 70), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y, ScrollingDirection = Enum.ScrollingDirection.Y }, page)
            List(scroller, 12)
            Pad(scroller, 2, 2, 8, 14)
            return scroller
        end

        Tab.Cols = { Left = makeColumn(UDim2.fromOffset(0, 0), UDim2.new(0.5, -8, 1, 0)), Right = makeColumn(UDim2.new(0.5, 8, 0, 0), UDim2.new(0.5, -8, 1, 0)) }
        Tab.Btn, Tab.Img, Tab.Page = btn, img, page
        Connect(btn.MouseButton1Click, function() Win:Select(Tab) end)
        table.insert(Win.Tabs, Tab)
        if #Win.Tabs == 1 then Win:Select(Tab) end

        local function reg(idx, obj)
            if idx then Library.Options[idx] = obj; Library.Flags[idx] = obj.Value end
        end

        function Tab:AddGroup(title, side, icon)
            side = side or "Left"
            local Group = {}
            local box = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Group, BackgroundTransparency = T.BgTransparency or 0, LayoutOrder = #Tab.Groups + 1 }, Tab.Cols[side])
            Corner(box, 8)
            Stroke(box, T.Stroke, 0.35)
            List(box, 0) 

            local header = New("Frame", { Size = UDim2.new(1, 0, 0, 44), BackgroundTransparency = 1, LayoutOrder = 1 }, box)
            local iconOffset = 14
            if icon then
                local iconImg = New("ImageLabel", { BackgroundTransparency = 1, Position = UDim2.fromOffset(14, 13), Size = UDim2.fromOffset(18, 18), ImageColor3 = T.Text }, header)
                if Library:ApplyIcon(iconImg, icon) then iconOffset = 42 else iconImg:Destroy() end
            end
            local titleLabel = Label(header, title, 14, T.Text, Enum.Font.GothamMedium)
            titleLabel.Position = UDim2.fromOffset(iconOffset, 0)
            titleLabel.Size = UDim2.new(1, -iconOffset - 14, 1, 0)

            local divider = New("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundColor3 = T.Stroke, BackgroundTransparency = 0.5, LayoutOrder = 2 }, box)
            Pad(divider, 12, 0, 12, 0)

            local holder = New("Frame", { BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 }, box)
            List(holder, 6)
            Pad(holder, 10, 6, 10, 12)

            Group.Holder = box
            Group.Container = holder
            local elements = BuildElements(holder, reg)
            for k, v in pairs(elements) do Group[k] = v end
            table.insert(Tab.Groups, Group)
            return Group
        end

        return Tab
    end

    table.insert(Library.Windows, Win)
    return Win
end

local SaveManager = {}
SaveManager.Folder = "UILib/configs"
SaveManager.Ignore = { ConfigList = true, ConfigName = true }

local function ensureFolder(path)
    if not isfolder or not makefolder then return end
    local current = ""
    for part in string.gmatch(path, "[^/]+") do
        current = current == "" and part or (current .. "/" .. part)
        if not isfolder(current) then pcall(makefolder, current) end
    end
end

function SaveManager:SetFolder(folder)
    self.Folder = folder or "UILib/configs"
    ensureFolder(self.Folder)
end

function SaveManager:Ignore(key) self.Ignore[key] = true end
function SaveManager:Unignore(key) self.Ignore[key] = nil end
function SaveManager:SetIgnoreIndexes(indexes)
    for _, idx in ipairs(indexes or {}) do self.Ignore[idx] = true end
end

local function serializeValue(opt)
    local t = opt.Type
    if t == "Toggle" then return opt.Value and true or false
    elseif t == "Slider" then return tonumber(opt.Value) or 0
    elseif t == "Input" then return tostring(opt.Value or "")
    elseif t == "Keybind" then
        if typeof(opt.Value) == "EnumItem" then return opt.Value.Name end
        return tostring(opt.Value)
    elseif t == "Dropdown" then
        local v = opt.Value
        if type(v) ~= "table" then return v end
        if opt.Multi then
            local list = {}
            for k, on in pairs(v) do if on then table.insert(list, k) end end
            return list
        end
        return v
    end
    return nil
end

function SaveManager:Save(name)
    if not writefile then Library:Notify("writefile not available") return false end
    name = tostring(name or "")
    if name == "" then Library:Notify("Enter a config name") return false end
    ensureFolder(self.Folder)
    local data = {}
    for idx, opt in pairs(Library.Options) do
        if not self.Ignore[idx] and opt.Type then
            local ok, value = pcall(serializeValue, opt)
            if ok and value ~= nil then data[idx] = value end
        end
    end
    local ok, encoded = pcall(HttpService.JSONEncode, HttpService, data)
    if not ok then Library:Notify("Failed to encode config") return false end
    local path = self.Folder .. "/" .. name .. ".json"
    local success, err = pcall(writefile, path, encoded)
    if success then Library:Notify("Saved: " .. name) return true end
    Library:Notify("Save failed: " .. tostring(err))
    return false
end

function SaveManager:Load(name)
    if not readfile or not isfile then Library:Notify("readfile not available") return false end
    name = tostring(name or "")
    local path = self.Folder .. "/" .. name .. ".json"
    if not isfile(path) then Library:Notify("Not found: " .. name) return false end
    local ok, raw = pcall(readfile, path)
    if not ok or not raw then Library:Notify("Read failed") return false end
    local ok2, data = pcall(HttpService.JSONDecode, HttpService, raw)
    if not ok2 or type(data) ~= "table" then Library:Notify("Invalid config file") return false end
    for idx, value in pairs(data) do
        local opt = Library.Options[idx]
        if opt and type(opt.SetValue) == "function" and not self.Ignore[idx] then
            pcall(function()
                if opt.Type == "Keybind" and type(value) == "string" then
                    opt:SetValue(Enum.KeyCode[value] or Enum.KeyCode.Unknown)
                else
                    opt:SetValue(value)
                end
            end)
        end
    end
    Library:Notify("Loaded: " .. name)
    return true
end

function SaveManager:Delete(name)
    if not delfile or not isfile then return false end
    local path = self.Folder .. "/" .. name .. ".json"
    if isfile(path) then
        pcall(delfile, path)
        Library:Notify("Deleted: " .. name)
        return true
    end
    return false
end

function SaveManager:ListConfigs()
    local list = {}
    if not listfiles or not isfolder or not makefolder then return list end
    pcall(makefolder, self.Folder)
    local ok, files = pcall(listfiles, self.Folder)
    if not ok or type(files) ~= "table" then return list end
    for _, filePath in ipairs(files) do
        local name = filePath:match("([^/\\]+)%.json$")
        if name and name ~= "autoload" then table.insert(list, name) end
    end
    return list
end

function SaveManager:GetAutoload()
    if not readfile or not isfile then return nil end
    local path = self.Folder .. "/autoload.txt"
    if isfile(path) then
        local ok, name = pcall(readfile, path)
        if ok and name and name ~= "" then return name:gsub("%s+", "") end
    end
    return nil
end

function SaveManager:SetAutoload(name)
    if not writefile then Library:Notify("writefile not available") return false end
    ensureFolder(self.Folder)
    local ok = pcall(writefile, self.Folder .. "/autoload.txt", tostring(name))
    if ok then Library:Notify("Autoload: " .. name) return true end
    return false
end

function SaveManager:RemoveAutoload()
    if not delfile and not writefile then return false end
    local path = self.Folder .. "/autoload.txt"
    if isfile and isfile(path) then
        if delfile then pcall(delfile, path) else pcall(writefile, path, "") end
        Library:Notify("Autoload removed")
        return true
    end
    return false
end

function SaveManager:Refresh()
    local opt = Library.Options.ConfigList
    if opt and opt.SetValues then
        local current = opt.Value
        opt:SetValues(self:ListConfigs())
        if current then
            local found = false
            for _, v in ipairs(opt.Values) do if v == current then found = true break end end
            if found then pcall(function() opt:SetValue(current) end) end
        end
    end
end

function SaveManager:BuildConfigSection(tab, side)
    side = side or "Right"
    local group = tab:AddGroup("Config", side, "save")
    local configName = ""
    local selectedConfig = nil

    group:AddDropdown("ConfigList", {
        Text = "Configs",
        Values = self:ListConfigs(),
        Default = nil,
        Callback = function(v) selectedConfig = v end,
    })
    group:AddButton("Refresh List", function()
        self:Refresh()
        Library:Notify("Refreshed")
    end)
    group:AddLabel("Config name:")

    local inputRow = New("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundColor3 = T.Element, BackgroundTransparency = T.ElementTransparency or 0, ClipsDescendants = true }, group.Container)
    Corner(inputRow, 6)
    Stroke(inputRow, T.Stroke, 0.55)
    local textBox = New("TextBox", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), PlaceholderText = "config name...", PlaceholderColor3 = T.SubText, TextColor3 = T.Text, TextSize = 13, Font = Enum.Font.Gotham, ClearTextOnFocus = false, TextXAlignment = Enum.TextXAlignment.Left }, inputRow)
    Pad(textBox, 10, 0, 10, 0)
    Connect(textBox:GetPropertyChangedSignal("Text"), function() configName = textBox.Text end)

    local function resolveName() return configName ~= "" and configName or selectedConfig end

    group:AddButton("Add", function()
        local name = resolveName()
        if not name or name == "" then Library:Notify("Enter a name") return end
        if self:Save(name) then
            self:Refresh()
            local opt = Library.Options.ConfigList
            if opt and opt.SetValue then pcall(function() opt:SetValue(name) end) end
            selectedConfig = name
        end
    end)
    group:AddButton("Overwrite", function()
        local name = selectedConfig or resolveName()
        if not name or name == "" then Library:Notify("Select a config") return end
        self:Save(name)
        self:Refresh()
    end)
    group:AddButton("Load", function()
        local name = selectedConfig or resolveName()
        if not name or name == "" then Library:Notify("Select a config") return end
        self:Load(name)
    end)
    group:AddButton("Delete", function()
        local name = selectedConfig or resolveName()
        if not name or name == "" then Library:Notify("Select a config") return end
        self:Delete(name)
        if self:GetAutoload() == name then self:RemoveAutoload() end
        self:Refresh()
        selectedConfig = nil
    end)
    group:AddButton("Set as AutoLoad", function()
        local name = selectedConfig or resolveName()
        if not name or name == "" then Library:Notify("Select a config") return end
        self:SetAutoload(name)
    end)
    group:AddButton("Remove AutoLoad", function() self:RemoveAutoload() end)
    return group
end

function SaveManager:LoadAutoloadConfig()
    local name = self:GetAutoload()
    if name then self:Load(name) end
end

Library.SaveManager = SaveManager

if not Library._dropdownListener then
    Library._dropdownListener = UIS.InputBegan:Connect(function(input)
        if input.UserInputType ~= Enum.UserInputType.MouseButton1 and input.UserInputType ~= Enum.UserInputType.Touch then return end
        for _, d in ipairs(Library._dropdowns) do
            if d.open and not d.hitTest(input.Position) then d.close() end
        end
    end)
end

return Library
