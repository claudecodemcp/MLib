            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(14, 14),
            ImageColor3 = T.Accent,
            ImageTransparency = 1,
        }, box)
        Library:ApplyIcon(check, "check")

        function obj:SetValue(v, silent)
            obj.Value = not not v
            Library.Flags[idx] = obj.Value
            if obj.Value then
                Tween(box, 0.15, { BackgroundColor3 = T.Hover })
                Tween(check, 0.15, { ImageTransparency = 0 })
            else
                Tween(box, 0.15, { BackgroundColor3 = T.Element })
                Tween(check, 0.15, { ImageTransparency = 1 })
            end
            if not silent then emit(obj, o, obj.Value) end
        end

        Connect(row.MouseButton1Click, function() obj:SetValue(not obj.Value) end)
        reg(idx, obj)
        obj:SetValue(obj.Value, true)

        function obj:AddInlineKeybind(kbName, kbOpts)
            kbOpts = kbOpts or {}

            local keyChip = New("TextButton", {
                AnchorPoint = Vector2.new(0, 0.5),
                Position = UDim2.new(0, 6, 0.5, 0),
                Size = UDim2.fromOffset(30, 22),
                AutomaticSize = Enum.AutomaticSize.X,
