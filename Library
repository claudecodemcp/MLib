                local mp = UIS:GetMouseLocation()
                if not InRect(keyBtn, mp) then stopListening(true) end
                return
            end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if input.KeyCode == Enum.KeyCode.Escape then
                stopListening(true)
                return
            end
            if gameProcessed then return end
            stopListening(false)
            obj:SetValue(input.KeyCode)
        end)

        Connect(UIS.InputBegan, function(input, gameProcessed)
            if gameProcessed or listening or Library._listening then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if obj.Value == Enum.KeyCode.Unknown then return end
            if input.KeyCode == obj.Value then
                if type(o.OnPressed) == "function" then safeCall(o.OnPressed) end
                emit(obj, o, obj.Value)
            end
        end)

        reg(idx, obj)
        obj:SetValue(obj.Value, true)
        return obj
    end

    function api:AddInput(idx, o)
        o = o or {}
        local obj = { Value = tostring(o.Default or ""), Type = "Input" }
        attachCallbacks(obj)

        local row = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        }, holder)
        List(row, 4)

        local titleLbl = Label(row, o.Text or idx, 13, T.Text)
        titleLbl.Size = UDim2.new(1, 0, 0, 16)
        titleLbl.LayoutOrder = 1

        local inputWrap = New("Frame", {
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = T.Element,
            BackgroundTransparency = T.ElementTransparency or 0,
            ClipsDescendants = true,
            LayoutOrder = 2,
        }, row)
        Corner(inputWrap, 6)
        Stroke(inputWrap, T.Stroke, 0.55)

        local box = New("TextBox", {
            BackgroundTransparency = 1,
            Size = UDim2.fromScale(1, 1),
            Text = obj.Value,
            PlaceholderText = o.Placeholder or "Type here...",
            PlaceholderColor3 = T.SubText,
            TextColor3 = T.Text,
            TextSize = 13,
            Font = Enum.Font.Gotham,
            ClearTextOnFocus = false,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, inputWrap)
        Pad(box, 10, 0, 10, 0)

        function obj:SetValue(v, silent)
            local str = tostring(v or "")
            obj.Value = str
            if box.Text ~= str then box.Text = str end
            Library.Flags[idx] = str
            if not silent then emit(obj, o, str) end
        end

        Connect(box.FocusLost, function()
            if box.Text ~= obj.Value then obj:SetValue(box.Text) end
        end)

        reg(idx, obj)
        return obj
    end

    return api
end

function Library:AddWindow(cfg)
    cfg = cfg or {}
    local toggleKey = cfg.ToggleKey or Enum.KeyCode.RightShift
    if type(toggleKey) == "string" then
        toggleKey = Enum.KeyCode[toggleKey] or Enum.KeyCode.RightShift
    end

    local Win = {
        Tabs = {},
        Title = cfg.Title or "UILib",
        ToggleKey = toggleKey,
        Visible = true,
    }

    local gui = New("ScreenGui", {
        Name = "UILib",
        ResetOnSpawn = false,
        ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        DisplayOrder = 100,
        IgnoreGuiInset = true,
    }, GuiParent())
    Win.Gui = gui

    local main = New("Frame", {
        AnchorPoint = Vector2.new(0.5, 0.5),
