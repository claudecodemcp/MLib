local function GuiParent()
    local ok, ui = pcall(function() return gethui and gethui() end)
    if ok and ui then return ui end
    local ok2 = pcall(function() return game:GetService("CoreGui").Name end)
    if ok2 then return game:GetService("CoreGui") end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function InRect(gui, pos)
    local a = gui.AbsolutePosition
    local s = gui.AbsoluteSize
    return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end

local function RowHover(row, baseColor)
    baseColor = baseColor or T.Group
    Connect(row.MouseEnter, function() Tween(row, 0.12, { BackgroundColor3 = T.Hover }) end)
    Connect(row.MouseLeave, function() Tween(row, 0.12, { BackgroundColor3 = baseColor }) end)
end

local function safeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local args = table.pack(...)
    task.spawn(function()
        pcall(fn, table.unpack(args, 1, args.n))
    end)
end

local function attachCallbacks(obj)
    obj._listeners = obj._listeners or {}
    function obj:OnChanged(fn)
        if type(fn) == "function" then table.insert(self._listeners, fn) end
        return self
    end
    return obj
end

local function emit(obj, options, ...)
    if options and type(options.Callback) == "function" then
        safeCall(options.Callback, ...)
    end
    for _, fn in ipairs(obj._listeners or {}) do
        safeCall(fn, ...)
    end
end

local IconLib = nil

local function ensureIconLib()
    if IconLib then return true end
    pcall(function()
        IconLib = loadstring(game:HttpGet(
            "https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"
        ))()
    end)
    return IconLib ~= nil
end

pcall(ensureIconLib)

local function iconFileNameFor(url)
    local hash = 5381
    for i = 1, #url do
        hash = ((hash * 33) + string.byte(url, i)) % 4294967291
    end
    local ext = url:match("%.(%w+)%??") or url:match("%.(%w+)$") or "png"
    return tostring(hash) .. "." .. ext
end

local function downloadIcon(url)
    if writeassetfile then
        if isfolder and not isfolder("UILib") then pcall(makefolder, "UILib") end
        if isfolder and not isfolder("UILib/icons") then pcall(makefolder, "UILib/icons") end
        local path = "UILib/icons/" .. iconFileNameFor(url)
        if isfile and isfile(path) then
            local ok, asset = pcall(writeassetfile, path)
            if ok and asset then return asset end
        end
        local ok, data = pcall(function() return game:HttpGet(url) end)
        if ok and data and #data > 0 then
            local ok2, asset = pcall(writeassetfile, path, data)
            if ok2 and asset then return asset end
        end
    end

    if writefile and getcustomasset and isfolder and makefolder then
        if not isfolder("UILib") then pcall(makefolder, "UILib") end
        if not isfolder("UILib/icons") then pcall(makefolder, "UILib/icons") end
        local path = "UILib/icons/" .. iconFileNameFor(url)
        if isfile and isfile(path) then
            local ok, asset = pcall(getcustomasset, path)
            if ok and asset then return asset end
        end
        local ok, data = pcall(function() return game:HttpGet(url) end)
        if ok and data and #data > 0 then
            pcall(writefile, path, data)
            local ok2, asset = pcall(getcustomasset, path)
            if ok2 and asset then return asset end
        end
    end

    return nil
end

local function ResolveImage(name)
    if not name or name == "" then return nil end

    local cached = Library.IconCache[name]
    if cached ~= nil then
        return cached.url, cached.offset, cached.size
    end

    if type(name) == "number" then
        local url = "rbxassetid://" .. tostring(name)
        Library.IconCache[name] = { url = url }
        return url, nil, nil
    end

    if type(name) ~= "string" then return nil end

    if name:match("^rbxassetid://")
        or name:match("^rbxasset://")
        or name:match("^rbxthumb://")
        or name:match("^synasset://")
        or name:match("^assetdelivery://") then
        Library.IconCache[name] = { url = name }
        return name, nil, nil
    end

    if name:match("^https?://") then
        local asset = downloadIcon(name)
        Library.IconCache[name] = { url = asset }
        return asset, nil, nil
    end

    if ensureIconLib() then
        local clean = name:gsub("^lucide[%-:]", "")
        local ok, res = pcall(function() return IconLib.GetAsset(clean) end)
        if ok and res and res.Url then
            Library.IconCache[name] = {
                url = res.Url,
                offset = res.ImageRectOffset,
                size = res.ImageRectSize,
            }
            return res.Url, res.ImageRectOffset, res.ImageRectSize
        end
    end

    Library.IconCache[name] = { url = nil }
    return nil
end

function Library:ApplyIcon(img, name)
    if not img then return false end
    local url, offset, size = ResolveImage(name)
    if url then
        img.Image = url
        img.ImageRectOffset = offset or Vector2.zero
        img.ImageRectSize = size or Vector2.zero
        img.Visible = true
        return true
    end
    img.Visible = false
    return false
end

function Library:IconPreview(name)
    local url = ResolveImage(name)
    return url ~= nil
end

function Library:SetCustomCursor(enabled)
    if enabled == self._cursorEnabled then return end
    self._cursorEnabled = enabled
    if enabled then
        local parent = GuiParent()
        local curGui = parent:FindFirstChild("UILibCursor")
        if not curGui then
            curGui = New("ScreenGui", {
                Name = "UILibCursor",
                ResetOnSpawn = false,
                DisplayOrder = 999,
                IgnoreGuiInset = true,
                ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
            }, parent)
        end
        local img = curGui:FindFirstChild("CursorImage")
        if not img then
            img = New("ImageLabel", {
                Name = "CursorImage",
                Size = UDim2.fromOffset(24, 24),
                BackgroundTransparency = 1,
                Image = "rbxassetid://103359337734981",
                ImageColor3 = T.Text,
                ZIndex = 1000,
            }, curGui)
        end
        self._cursorImage = img
        pcall(function() UIS.MouseIconEnabled = false end)
        if self._cursorConn then
            pcall(function() self._cursorConn:Disconnect() end)
        end
        self._cursorConn = RunService.RenderStepped:Connect(function()
            if img and img.Parent then
                local mp = UIS:GetMouseLocation()
                img.Position = UDim2.fromOffset(mp.X, mp.Y)
            end
        end)
    else
        pcall(function() UIS.MouseIconEnabled = true end)
        if self._cursorConn then
            pcall(function() self._cursorConn:Disconnect() end)
            self._cursorConn = nil
        end
        if self._cursorImage then
            pcall(function() self._cursorImage.Parent:Destroy() end)
            self._cursorImage = nil
        end
    end
end

function Library:SetDPIScale(v)
    local n = tonumber(v)
    if not n then return end
    local scale = n > 10 and (n / 100) or n
    for _, w in ipairs(self.Windows) do
        if type(w.SetDPIScale) == "function" then
            pcall(function() w:SetDPIScale(scale) end)
        end
    end
end

Library._activeToasts = Library._activeToasts or {}

local function layoutToasts()
    local y = 16
    for _, card in ipairs(Library._activeToasts) do
        if card and card.Parent then
            Tween(card, 0.25, { Position = UDim2.new(1, -16, 0, y) })
            y = y + card.AbsoluteSize.Y + 8
        end
    end
end

function Library:Notify(text, duration)
    local isTable = type(text) == "table"
    local titleText = "Notification"
    local bodyText = ""

    if isTable then
        titleText = tostring(text.Title or text.title or "Notification")
        bodyText = tostring(text.Description or text.description or text.Content or text.content or text.Message or text.message or "")
        duration = text.Duration or text.Time or text.duration or text.time or duration or 4
        if bodyText == "" then
            bodyText = titleText
            titleText = "Notification"
        end
    else
        bodyText = tostring(text or "")
        duration = duration or 4
    end

    local entry = { Text = bodyText, Title = titleText, Time = os.date("%H:%M:%S"), Id = #Library.Notifications + 1 }
    table.insert(Library.Notifications, 1, entry)
    if #Library.Notifications > 50 then table.remove(Library.Notifications) end

    local parent = GuiParent()
    local notifGui = parent:FindFirstChild("UILibNotifications")
    if not notifGui then
        notifGui = New("ScreenGui", {
            Name = "UILibNotifications",
            ResetOnSpawn = false,
            DisplayOrder = 200,
            IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, parent)
    end

    local startY = 16
    for _, c in ipairs(Library._activeToasts) do
        if c and c.Parent then startY = startY + c.AbsoluteSize.Y + 8 end
    end

    local card = New("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 40, 0, startY),
        Size = UDim2.fromOffset(280, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.Group,
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, notifGui)
    Corner(card, 8)
    Stroke(card, T.Stroke, 0.35)

    local inner = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, card)
    Pad(inner, 12, 10, 12, 10)
    List(inner, 4)

    local title = Label(inner, titleText, 12, T.SubText)
    title.Size = UDim2.new(1, 0, 0, 14)

    local body = Label(inner, bodyText, 13, T.Text)
    body.Size = UDim2.new(1, 0, 0, 0)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.TextWrapped = true

    table.insert(Library._activeToasts, card)
    Tween(card, 0.3, { BackgroundTransparency = T.BgTransparency or 0, Position = UDim2.new(1, -16, 0, startY) })
    task.defer(layoutToasts)

    task.delay(duration, function()
        if card and card.Parent then
            Tween(card, 0.25, {
                BackgroundTransparency = 1,
                Position = UDim2.new(1, 40, 0, card.Position.Y.Offset),
            })
            task.wait(0.28)
            local idx = table.find(Library._activeToasts, card)
            if idx then table.remove(Library._activeToasts, idx) end
            card:Destroy()
            layoutToasts()
        end
    end)

    if Library._notifViewer and Library._notifViewer.Refresh then
        Library._notifViewer.Refresh()
    end
    return entry
end

local function ProfileCacheKey(value)
    if type(value) == "table" then
        return tostring(value.UserId or value.Id or value.userId or value.id
            or value.Name or value.Username or value.name or value.username or "")
    end
    return tostring(value)
end

local function NormalizeProfileInput(value)
    if type(value) == "table" then
        return {
            UserId      = value.UserId or value.Id or value.userId or value.id,
            Name        = value.Name or value.Username or value.name or value.username,
            DisplayName = value.DisplayName or value.displayName or value.Displayname,
            Image       = value.Image or value.Avatar or value.image or value.avatar,
        }
    end
    local num = tonumber(value)
    return {
        UserId = num,
        Name   = (not num) and tostring(value) or nil,
    }
end

local function FetchProfile(value, callback)
    local key = ProfileCacheKey(value)
    local cached = Library._userCache[key]
    if cached then
        if callback then callback(cached) end
        return cached
    end

    if Library._userFetching[key] then
        if callback then table.insert(Library._userFetching[key], callback) end
        return nil
    end

    Library._userFetching[key] = callback and { callback } or {}

    local initial = NormalizeProfileInput(value)

    task.spawn(function()
        local info = {
            UserId      = initial.UserId,
            Name        = initial.Name,
            DisplayName = initial.DisplayName,
            Image       = initial.Image,
        }

        if not info.UserId and info.Name and info.Name ~= "" then
            local ok, id = pcall(function()
                return Players:GetUserIdFromNameAsync(info.Name)
            end)
            if ok and id then info.UserId = id end
        end

        if info.UserId then
            local plr = Players:GetPlayerByUserId(info.UserId)
            if plr then
                info.Name = plr.Name
                info.DisplayName = plr.DisplayName
            else
                if not info.Name then
                    local ok, name = pcall(function()
                        return Players:GetNameFromUserIdAsync(info.UserId)
                    end)
                    if ok and name then info.Name = name end
                end
                if not info.DisplayName then info.DisplayName = info.Name end
            end

            if not info.Image then
                local thumbOk, thumb = pcall(function()
                    return Players:GetUserThumbnailAsync(
                        info.UserId,
                        Enum.ThumbnailType.HeadShot,
                        Enum.ThumbnailSize.Size48x48
                    )
                end)
                if thumbOk and thumb then info.Image = thumb end
            end
        end

        info.Name        = info.Name        or key
        info.DisplayName = info.DisplayName or info.Name

        Library._userCache[key] = info

        local callbacks = Library._userFetching[key]
        Library._userFetching[key] = nil
        if callbacks then
            for _, cb in ipairs(callbacks) do
                pcall(cb, info)
            end
        end
    end)

    return nil
end

function Library:GetProfile(value)
    return Library._userCache[ProfileCacheKey(value)]
end

function Library:FetchProfile(value, callback)
    return FetchProfile(value, callback)
end

local function BuildElements(holder, reg)
    local api = {}

    function api:AddLabel(text)
        local l = Label(holder, tostring(text or ""), 13, T.SubText)
        l.Size = UDim2.new(1, 0, 0, 0)
        l.AutomaticSize = Enum.AutomaticSize.Y
        l.TextWrapped = true
        Pad(l, 4, 2, 4, 2)
        local obj = {
            Type    = "Label",
            Value   = tostring(text or ""),
            Callback = nil,
            TextLabel = l,
        }
        obj._listeners = {}
        function obj:SetText(new)
            self.Value = tostring(new or "")
            l.Text = self.Value
            if type(self.Callback) == "function" then
                safeCall(self.Callback, self.Value)
            end
            for _, fn in ipairs(self._listeners or {}) do
                safeCall(fn, self.Value)
            end
        end
        function obj:GetText() return self.Value end
        function obj:OnChanged(fn)
            if type(fn) == "function" then table.insert(self._listeners, fn) end
            return self
        end
        return obj
    end

    function api:AddButton(text, callback)
        local obj = { Type = "Button" }
        attachCallbacks(obj)

        local b = New("TextButton", {
            Text = text,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextColor3 = T.Text,
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = T.Element,
            BackgroundTransparency = T.ElementTransparency or 0,
            AutoButtonColor = false,
