				Tween(btn, .2, { BackgroundTransparency = 0.2 })
				Tween(glow, .2, { ImageTransparency = 0.7, Size = UDim2.fromOffset(40, 40) })
			end
		end)
		Connect(btn.MouseLeave, function()
			if Win.Current ~= Tab then
				Tween(btn, .2, { BackgroundTransparency = 0.6 })
				Tween(glow, .2, { ImageTransparency = 1, Size = UDim2.fromOffset(30, 30) })
			end
		end)

		local page = New("Frame", { BackgroundTransparency = 1, Size = UDim2.fromScale(1, 1), Visible = false }, pages)

		local function column(pos, size)
			local s = New("ScrollingFrame", {
				BackgroundTransparency = 1, BorderSizePixel = 0, Position = pos, Size = size, ScrollBarThickness = 0,
				CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
			}, page)
			List(s, 8); Pad(s, 0, 0, 0, 12)
			return s
		end

