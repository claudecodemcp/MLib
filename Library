----------------------------------------------------------------------
--// Notifications
----------------------------------------------------------------------
function Library:Notify(title, text, duration)
	if not self.NotifyHolder or not self.NotifyHolder.Parent then
		if self.NotifyGui then pcall(function() self.NotifyGui:Destroy() end) end
		local g = New("ScreenGui", { Name = "UILibNotify", ResetOnSpawn = false, DisplayOrder = 200, IgnoreGuiInset = true }, GuiParent())
		self.NotifyGui = g
		self.NotifyHolder = New("Frame", { BackgroundTransparency = 1, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -16, 1, -16), Size = UDim2.fromOffset(280, 400) }, g)
		local l = List(self.NotifyHolder, 8); l.VerticalAlignment = Enum.VerticalAlignment.Bottom
	end
	local f = New("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = T.Panel, BackgroundTransparency = 1 }, self.NotifyHolder)
	Corner(f, 8); local s = Stroke(f, T.Stroke, 1); Pad(f, 14, 10, 14, 12); List(f, 2)
	
	local nscale = New("UIScale", { Scale = .8 }, f)
	local a = Label(f, title, 14, T.Text, T.FontBold); a.Size = UDim2.new(1, 0, 0, 18); a.TextTransparency = 1
	local b = Label(f, text or "", 13, T.SubText); b.Size = UDim2.new(1, 0, 0, 0); b.AutomaticSize = Enum.AutomaticSize.Y; b.TextWrapped = true; b.TextTransparency = 1
	
	Tween(f, .3, { BackgroundTransparency = .05 }); Tween(s, .3, { Transparency = .5 })
	Tween(a, .3, { TextTransparency = 0 }); Tween(b, .3, { TextTransparency = 0 }); Tween(nscale, .4, { Scale = 1 }, Enum.EasingStyle.Back)
	PlaySound("9118823103", 0.3) -- Pop sound
	
	task.delay(duration or 4, function()
		Tween(f, .25, { BackgroundTransparency = 1 }); Tween(s, .25, { Transparency = 1 })
		Tween(a, .25, { TextTransparency = 1 }); Tween(b, .25, { TextTransparency = 1 }); Tween(nscale, .25, { Scale = .85 })
		task.wait(.3); f:Destroy()
	end)
end

