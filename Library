            }, head)
            Corner(currentAvatar, 11)
            Stroke(currentAvatar, T.Stroke, 0.4)
        end

        local currentLbl = Label(head, "", 12, T.SubText)
        currentLbl.AnchorPoint = Vector2.new(1, 0.5)
        if profiles then
            currentLbl.Position = UDim2.new(1, -58, 0.5, 0)
            currentLbl.Size     = UDim2.new(0.5, -68, 0, 16)
        else
            currentLbl.Position = UDim2.new(1, -32, 0.5, 0)
            currentLbl.Size     = UDim2.new(0.5, -20, 0, 16)
        end
        currentLbl.TextXAlignment = Enum.TextXAlignment.Right
        currentLbl.TextTruncate   = Enum.TextTruncate.AtEnd

        local arrow = New("ImageLabel", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            ImageColor3 = T.SubText,
        }, head)
        Library:ApplyIcon(arrow, "chevron-down")

        local listWrap = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = T.Group,
            BackgroundTransparency = T.BgTransparency or 0,
            ClipsDescendants = true,
            Visible = false,
            LayoutOrder = 2,
        }, row)
        Corner(listWrap, 6)
        Stroke(listWrap, T.Stroke, 0.8)

        local listScroll = New("ScrollingFrame", {
            Size = UDim2.new(1, 0, 1, 0),
            BackgroundTransparency = 1,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Color3.fromRGB(70, 70, 70),
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
        }, listWrap)
        Corner(listScroll, 6)
        List(listScroll, 3)
        Pad(listScroll, 5, 5, 5, 5)

        local listScale = New("UIScale", { Scale = 1 }, listWrap)
        local items = {}
        local state = { open = false }

        local function computeListHeight()
            local count = #obj.Values
            local h = count * itemHeight + math.max(0, count - 1) * 3 + 10
            return math.clamp(h, 32, profiles and 320 or 220)
        end

        function state.close()
            state.open = false
            Tween(listScale, 0.15, { Scale = 0.96 })
            task.delay(0.12, function()
                if not state.open then
                    listWrap.Visible = false
                    listWrap.Size = UDim2.new(1, 0, 0, 0)
                end
            end)
            Tween(arrow, 0.18, { Rotation = 0 })
        end
        function state.hitTest(pos)
            return InRect(head, pos) or (state.open and InRect(listWrap, pos))
        end
        table.insert(Library._dropdowns, state)

        local function valueLabel(v)
            if type(v) == "table" then
                return v.DisplayName or v.Name or v.Username or tostring(v.UserId or "?")
            end
            return tostring(v)
        end

        local function getText()
            if o.Multi then
                local sel = {}
                for _, v in ipairs(obj.Values) do
                    if obj.Value[v] then table.insert(sel, v) end
                end
                if profiles then
                    if #sel == 0 then return "None" end
                    if #sel == 1 then
                        local info = Library:GetProfile(sel[1])
                        return (info and (info.DisplayName or info.Name)) or valueLabel(sel[1])
                    end
                    return #sel .. " selected"
                end
                return #sel > 0 and table.concat(sel, ", ") or "None"
            end
            if profiles then
                local info = Library:GetProfile(obj.Value)
                if info then return info.DisplayName or info.Name or valueLabel(obj.Value) end
                return valueLabel(obj.Value or "None")
            end
            return tostring(obj.Value or "None")
        end

        local function updateHeaderAvatar()
            if not currentAvatar then return end
            if o.Multi then
                currentAvatar.Visible = false
                return
            end
            local info = Library:GetProfile(obj.Value)
            if info and info.Image then
                currentAvatar.Image = info.Image
                currentAvatar.Visible = true
            else
                currentAvatar.Visible = false
            end
        end

        local function snapshot()
            if not o.Multi then return obj.Value end
            local copy = {}
            for k, on in pairs(obj.Value) do if on then copy[k] = true end end
            return copy
        end

        local function refresh()
            currentLbl.Text = getText()
            updateHeaderAvatar()
            Library.Flags[idx] = obj.Value

            for v, btn in pairs(items) do
                local on = o.Multi and obj.Value[v] or (obj.Value == v)
                if profiles then
                    local nameLbl = btn:FindFirstChild("NameLbl")
                    if nameLbl then
                        Tween(nameLbl, 0.12, { TextColor3 = on and T.Accent or T.Text })
                    end
                else
                    local lbl = btn:FindFirstChildWhichIsA("TextLabel")
                    if lbl then Tween(lbl, 0.12, { TextColor3 = on and T.Accent or T.SubText }) end
                    local icon = btn:FindFirstChildWhichIsA("ImageLabel")
                    if icon then Tween(icon, 0.12, { ImageColor3 = on and T.Accent or T.SubText }) end
                end
            end
        end

        local function build()
            for _, b in pairs(items) do b:Destroy() end
            items = {}
            for i, v in ipairs(obj.Values) do
                local btn = New("TextButton", {
                    Text = "",
                    Size = UDim2.new(1, 0, 0, itemHeight),
                    BackgroundColor3 = T.Element,
                    BackgroundTransparency = 1,
                    AutoButtonColor = false,
                    ClipsDescendants = true,
                    LayoutOrder = i,
                }, listScroll)
                Corner(btn, 5)

                if profiles then
                    local avatar = New("ImageLabel", {
                        Name = "AvatarImg",
                        BackgroundTransparency = 1,
                        AnchorPoint = Vector2.new(0, 0.5),
                        Position = UDim2.new(0, 8, 0.5, 0),
                        Size = UDim2.fromOffset(32, 32),
                        Image = "",
                    }, btn)
                    Corner(avatar, 16)
                    Stroke(avatar, T.Stroke, 0.5)

                    local nameLbl = Label(btn, valueLabel(v), 13, T.Text)
                    nameLbl.Name = "NameLbl"
                    nameLbl.Position = UDim2.fromOffset(48, 5)
                    nameLbl.Size = UDim2.new(1, -56, 0, 16)
                    nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
                    nameLbl.Font = Enum.Font.GothamMedium

                    local userLbl = Label(btn, "", 11, Color3.fromRGB(120, 120, 120))
                    userLbl.Name = "UserLbl"
                    userLbl.Position = UDim2.fromOffset(48, 23)
                    userLbl.Size = UDim2.new(1, -56, 0, 14)
                    userLbl.TextTruncate = Enum.TextTruncate.AtEnd

                    local function applyInfo(info)
                        if not avatar or not avatar.Parent then return end
                        if info.Image then avatar.Image = info.Image end
                        nameLbl.Text = info.DisplayName or info.Name or valueLabel(v)
                        userLbl.Text = info.Name and ("@" .. info.Name) or ""
                        local on = o.Multi and obj.Value[v] or (obj.Value == v)
                        nameLbl.TextColor3 = on and T.Accent or T.Text
                    end

                    local cached = Library:GetProfile(v)
                    if cached then
                        applyInfo(cached)
                    else
                        FetchProfile(v, function(info)
                            applyInfo(info)
                            if not o.Multi and obj.Value == v then
                                task.defer(refresh)
                            end
                        end)
                    end
                else
                    local iconOffset = 8
                    if o.ValueImages and o.ValueImages[v] then
                        local iconImg = New("ImageLabel", {
                            BackgroundTransparency = 1,
                            Position = UDim2.new(0, 8, 0.5, 0),
                            AnchorPoint = Vector2.new(0, 0.5),
                            Size = UDim2.fromOffset(16, 16),
                            ImageColor3 = T.SubText,
                            ImageTransparency = 1,
                        }, btn)
                        if Library:ApplyIcon(iconImg, o.ValueImages[v]) then
                            iconOffset = 32
                        else
                            iconImg:Destroy()
                        end
                    end

                    local lbl = Label(btn, tostring(v), 13, T.SubText)
                    lbl.Position = UDim2.fromOffset(iconOffset, 0)
                    lbl.Size = UDim2.new(1, -iconOffset - 8, 1, 0)
                    lbl.TextTruncate = Enum.TextTruncate.AtEnd
                end

                Connect(btn.MouseEnter, function() Tween(btn, 0.1, { BackgroundTransparency = 0.55 }) end)
                Connect(btn.MouseLeave, function() Tween(btn, 0.1, { BackgroundTransparency = 1 }) end)
                Connect(btn.MouseButton1Click, function()
                    if o.Multi then
                        obj.Value[v] = not obj.Value[v] or nil
                    else
                        obj.Value = v
                        state.close()
                    end
                    refresh()
                    emit(obj, o, snapshot())
                end)
                items[v] = btn
            end
            if state.open then
                listWrap.Size = UDim2.new(1, 0, 0, computeListHeight())
            end
            refresh()
        end

        function obj:SetValues(newValues)
            obj.Values = newValues
            if not o.Multi then
                local found = false
                for _, v in ipairs(newValues) do
                    if v == obj.Value then found = true break end
                end
                if not found then
                    obj.Value = newValues[1]
                    Library.Flags[idx] = obj.Value
                end
            end
            build()
        end

        function obj:SetValue(v, silent)
            if o.Multi then
                obj.Value = {}
                if type(v) == "table" then
                    for k, on in pairs(v) do
                        if on then
                            if type(k) == "number" then obj.Value[on] = true
                            else obj.Value[k] = true end
                        end
                    end
                end
            else
                obj.Value = v
            end
            if profiles and not o.Multi and not Library:GetProfile(v) then
                FetchProfile(v, function()
                    if obj.Value == v then task.defer(refresh) end
                end)
            end
            refresh()
            if not silent then emit(obj, o, snapshot()) end
        end

        Connect(head.MouseButton1Click, function()
            if state.open then
                state.close()
            else
                for _, d in ipairs(Library._dropdowns) do
                    if d ~= state then d.close() end
                end
                state.open = true
                listWrap.Size = UDim2.new(1, 0, 0, computeListHeight())
                listWrap.Visible = true
                listScale.Scale = 0.96
                Tween(arrow, 0.18, { Rotation = 180 })
                Tween(listScale, 0.18, { Scale = 1 }, Enum.EasingStyle.Quint)
            end
        end)

        build()
        reg(idx, obj)
        return obj
    end

