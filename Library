    Stroke(main, T.Stroke, 0.45)
    Win.Main = main

    if T.BackgroundGradient then
        New("UIGradient", T.BackgroundGradient, main)
    end

    if T.FallingEmojis then
        local bgFrame = New("Frame", {
            Size = UDim2.fromScale(1, 1),
            BackgroundTransparency = 1,
            ClipsDescendants = true,
            ZIndex = 0,
        }, main)
        Corner(bgFrame, 10)

        local iconNames = {"snowflake", "gift", "tree-pine", "snowman", "star", "sparkles"}
        local particles = {}

        local lanes = {}
        for i = 1, 40 do
            table.insert(lanes, i / 40)
        end
        for i = #lanes, 2, -1 do
            local j = math.random(i)
            lanes[i], lanes[j] = lanes[j], lanes[i]
        end

        for i = 1, 25 do
            local xPos = lanes[i]
