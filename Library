local T = Library.Theme

local function New(class, props, parent)
    local obj = Instance.new(class)
    if obj:IsA("GuiObject") then obj.BorderSizePixel = 0 end
    for k, v in pairs(props or {}) do obj[k] = v end
    if parent then obj.Parent = parent end
    return obj
end

local function Corner(obj, radius)
    return New("UICorner", { CornerRadius = UDim.new(0, radius or 6) }, obj)
end

local function Stroke(obj, color, transparency)
    return New("UIStroke", {
        Color = color or T.Stroke,
        Transparency = transparency or 0.4,
        ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
        LineJoinMode = Enum.LineJoinMode.Round,
        Thickness = 1,
    }, obj)
end

local function Pad(obj, l, t, r, b)
    return New("UIPadding", {
        PaddingLeft = UDim.new(0, l or 0),
        PaddingTop = UDim.new(0, t or 0),
        PaddingRight = UDim.new(0, r or 0),
        PaddingBottom = UDim.new(0, b or 0),
    }, obj)
end

local function List(obj, padding, fill)
    return New("UIListLayout", {
        SortOrder = Enum.SortOrder.LayoutOrder,
        Padding = UDim.new(0, padding or 0),
        FillDirection = fill or Enum.FillDirection.Vertical,
    }, obj)
end

local function Tween(obj, time, props, style, direction)
    local info = TweenInfo.new(
        time or 0.18,
        style or Enum.EasingStyle.Quint,
        direction or Enum.EasingDirection.Out
    )
    local tw = TweenService:Create(obj, info, props)
    tw:Play()
    return tw
end

local function Connect(signal, fn)
    local c = signal:Connect(fn)
    table.insert(Library.Connections, c)
    return c
end

local function Label(parent, text, size, color, font)
    return New("TextLabel", {
        BackgroundTransparency = 1,
        Text = text or "",
        TextSize = size or 14,
        TextColor3 = color or T.Text,
        Font = font or Enum.Font.GothamMedium,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextTruncate = Enum.TextTruncate.AtEnd,
        RichText = true,
    }, parent)
end

local function GuiParent()
    local ok, ui = pcall(function() return gethui and gethui() end)
    if ok and ui then return ui end
    local ok2 = pcall(function() return game:GetService("CoreGui").Name end)
    if ok2 then return game:GetService("CoreGui") end
    return Players.LocalPlayer:WaitForChild("PlayerGui")
end

local function InRect(gui, pos)
    local a = gui.AbsolutePosition
    local s = gui.AbsoluteSize
    return pos.X >= a.X and pos.X <= a.X + s.X and pos.Y >= a.Y and pos.Y <= a.Y + s.Y
end

local function RowHover(row, baseColor)
    baseColor = baseColor or T.Group
    Connect(row.MouseEnter, function() Tween(row, 0.12, { BackgroundColor3 = T.Hover }) end)
    Connect(row.MouseLeave, function() Tween(row, 0.12, { BackgroundColor3 = baseColor }) end)
end

local function safeCall(fn, ...)
    if type(fn) ~= "function" then return end
    local args = table.pack(...)
    task.spawn(function()
        pcall(fn, table.unpack(args, 1, args.n))
    end)
end

local function attachCallbacks(obj)
    obj._listeners = obj._listeners or {}
    function obj:OnChanged(fn)
        if type(fn) == "function" then table.insert(self._listeners, fn) end
        return self
    end
    return obj
end

local function emit(obj, options, ...)
    if options and type(options.Callback) == "function" then
        safeCall(options.Callback, ...)
    end
    for _, fn in ipairs(obj._listeners or {}) do
        safeCall(fn, ...)
    end
end

local IconLib
pcall(function()
    IconLib = loadstring(game:HttpGet(
        "https://raw.githubusercontent.com/deividcomsono/lucide-roblox-direct/refs/heads/main/source.lua"
    ))()
end)

local function ResolveImage(name)
    if type(name) == "number" then return "rbxassetid://" .. tostring(name), nil, nil end
    if type(name) ~= "string" then return nil end
    if name:match("^rbxassetid://") or name:match("^rbxasset://") then return name, nil, nil end
    if name:match("^https?://") then
        if writefile and getcustomasset and isfolder and makefolder then
            local folder = "UILib/assets"
            if not isfolder(folder) then pcall(makefolder, folder) end
            local filename = folder .. "/" .. HttpService:GenerateGUID(false) .. ".png"
            local ok, data = pcall(game.HttpGet, game, name)
            if ok and data then
                pcall(writefile, filename, data)
                local ok2, asset = pcall(getcustomasset, filename)
                if ok2 and asset then return asset, nil, nil end
            end
        end
        return name, nil, nil
    end
    if IconLib then
        local clean = name:gsub("^lucide[%-:]", "")
        local ok, res = pcall(function() return IconLib.GetAsset(clean) end)
        if ok and res then return res.Url, res.ImageRectOffset, res.ImageRectSize end
    end
    return nil
end

function Library:ApplyIcon(img, name)
    if not img then return false end
    local url, offset, size = ResolveImage(name)
    if url then
        img.Image = url
        img.ImageRectOffset = offset or Vector2.zero
        img.ImageRectSize = size or Vector2.zero
        img.Visible = true
        return true
    end
    img.Visible = false
    return false
end

Library._activeToasts = Library._activeToasts or {}

local function layoutToasts()
    local y = 16
    for _, card in ipairs(Library._activeToasts) do
        if card and card.Parent then
            Tween(card, 0.25, { Position = UDim2.new(1, -16, 0, y) })
            y = y + card.AbsoluteSize.Y + 8
        end
    end
end

function Library:Notify(text, duration)
    duration = duration or 4
    text = tostring(text)

    local entry = { Text = text, Time = os.date("%H:%M:%S"), Id = #Library.Notifications + 1 }
    table.insert(Library.Notifications, 1, entry)
    if #Library.Notifications > 50 then table.remove(Library.Notifications) end

    local parent = GuiParent()
    local notifGui = parent:FindFirstChild("UILibNotifications")
    if not notifGui then
        notifGui = New("ScreenGui", {
            Name = "UILibNotifications",
            ResetOnSpawn = false,
            DisplayOrder = 200,
            IgnoreGuiInset = true,
            ZIndexBehavior = Enum.ZIndexBehavior.Sibling,
        }, parent)
    end

    local startY = 16
    for _, c in ipairs(Library._activeToasts) do
        if c and c.Parent then startY = startY + c.AbsoluteSize.Y + 8 end
    end

    local card = New("Frame", {
        AnchorPoint = Vector2.new(1, 0),
        Position = UDim2.new(1, 40, 0, startY),
        Size = UDim2.fromOffset(280, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundColor3 = T.Group,
        BackgroundTransparency = 1,
        ClipsDescendants = true,
    }, notifGui)
    Corner(card, 8)
    Stroke(card, T.Stroke, 0.35)

    local inner = New("Frame", {
        Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y,
        BackgroundTransparency = 1,
    }, card)
    Pad(inner, 12, 10, 12, 10)
    List(inner, 4)

    local title = Label(inner, "Notification", 12, T.SubText)
    title.Size = UDim2.new(1, 0, 0, 14)

    local body = Label(inner, text, 13, T.Text)
    body.Size = UDim2.new(1, 0, 0, 0)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.TextWrapped = true

    table.insert(Library._activeToasts, card)
    Tween(card, 0.3, { BackgroundTransparency = 0, Position = UDim2.new(1, -16, 0, startY) })
    task.defer(layoutToasts)

    task.delay(duration, function()
        if card and card.Parent then
            Tween(card, 0.25, {
                BackgroundTransparency = 1,
                Position = UDim2.new(1, 40, 0, card.Position.Y.Offset),
            })
            task.wait(0.28)
            local idx = table.find(Library._activeToasts, card)
            if idx then table.remove(Library._activeToasts, idx) end
            card:Destroy()
            layoutToasts()
        end
    end)

    if Library._notifViewer and Library._notifViewer.Refresh then
        Library._notifViewer.Refresh()
    end
    return entry
end

local function BuildElements(holder, reg)
    local api = {}

    function api:AddLabel(text)
        local l = Label(holder, text, 13, T.SubText)
        l.Size = UDim2.new(1, 0, 0, 0)
        l.AutomaticSize = Enum.AutomaticSize.Y
        l.TextWrapped = true
        Pad(l, 4, 2, 4, 2)
        return {
            SetText = function(_, new) l.Text = new end,
            OnChanged = function(self) return self end,
        }
    end

    function api:AddButton(text, callback)
        local obj = { Type = "Button" }
        attachCallbacks(obj)

        local b = New("TextButton", {
            Text = text,
            Font = Enum.Font.GothamMedium,
            TextSize = 13,
            TextColor3 = T.Text,
            Size = UDim2.new(1, 0, 0, 34),
            BackgroundColor3 = T.Element,
            AutoButtonColor = false,
        }, holder)
        Corner(b, 6)
        Stroke(b, T.Stroke, 0.55)
        Connect(b.MouseEnter, function() Tween(b, 0.12, { BackgroundColor3 = Color3.fromRGB(52, 52, 52) }) end)
        Connect(b.MouseLeave, function() Tween(b, 0.12, { BackgroundColor3 = T.Element }) end)

        local opts = { Callback = callback }
        local function fire() emit(obj, opts) end
        Connect(b.MouseButton1Click, fire)

        function obj:Press() fire() end
        obj.Button = b
        return obj
    end

    function api:AddToggle(idx, o)
        o = o or {}
        local obj = { Value = o.Default or false, Type = "Toggle" }
        attachCallbacks(obj)

        local row = New("TextButton", {
            Text = "",
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = T.Group,
            BackgroundTransparency = 1,
            AutoButtonColor = false,
        }, holder)
        RowHover(row)

        local l = Label(row, o.Text or idx, 13, T.Text)
        l.Position = UDim2.fromOffset(6, 0)
        l.Size = UDim2.new(1, -42, 1, 0)

        local box = New("Frame", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.fromOffset(20, 20),
            BackgroundColor3 = Color3.fromRGB(16, 16, 16),
        }, row)
        Corner(box, 5)
        Stroke(box, T.Stroke, 0.4)

        local check = New("ImageLabel", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.fromScale(0.5, 0.5),
            Size = UDim2.fromOffset(14, 14),
            ImageColor3 = T.Accent,
            ImageTransparency = 1,
        }, box)
        Library:ApplyIcon(check, "check")

        function obj:SetValue(v, silent)
            obj.Value = not not v
            Library.Flags[idx] = obj.Value
            if obj.Value then
                Tween(box, 0.15, { BackgroundColor3 = Color3.fromRGB(45, 45, 45) })
                Tween(check, 0.15, { ImageTransparency = 0 })
            else
                Tween(box, 0.15, { BackgroundColor3 = Color3.fromRGB(16, 16, 16) })
                Tween(check, 0.15, { ImageTransparency = 1 })
            end
            if not silent then emit(obj, o, obj.Value) end
        end

        Connect(row.MouseButton1Click, function() obj:SetValue(not obj.Value) end)
        reg(idx, obj)
        obj:SetValue(obj.Value, true)
        return obj
    end

    function api:AddSlider(idx, o)
        o = o or {}
        local min, max, rnd = o.Min or 0, o.Max or 100, o.Rounding or 0
        local obj = { Value = math.clamp(o.Default or min, min, max), Type = "Slider" }
        attachCallbacks(obj)

        local row = New("Frame", {
            Size = UDim2.new(1, 0, 0, 50),
            BackgroundColor3 = T.Group,
            BackgroundTransparency = 1,
        }, holder)
        RowHover(row)

        local l = Label(row, o.Text or idx, 13, T.Text)
        l.Position = UDim2.fromOffset(6, 6)
        l.Size = UDim2.new(0.62, 0, 0, 18)

        local valLabel = Label(row, "", 13, T.SubText)
        valLabel.AnchorPoint = Vector2.new(1, 0)
        valLabel.Position = UDim2.new(1, -8, 0, 6)
        valLabel.Size = UDim2.new(0.35, 0, 0, 18)
        valLabel.TextXAlignment = Enum.TextXAlignment.Right

        local bar = New("TextButton", {
            Text = "",
            Position = UDim2.fromOffset(6, 34),
            Size = UDim2.new(1, -12, 0, 5),
            BackgroundColor3 = Color3.fromRGB(16, 16, 16),
            AutoButtonColor = false,
        }, row)
        Corner(bar, 3)
        Stroke(bar, T.Stroke, 0.55)

        local fill = New("Frame", {
            Size = UDim2.fromScale(0, 1),
            BackgroundColor3 = T.Accent,
        }, bar)
        Corner(fill, 3)

        local knob = New("Frame", {
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0, 0, 0.5, 0),
            Size = UDim2.fromOffset(13, 13),
            BackgroundColor3 = T.Accent,
        }, bar)
        Corner(knob, 6)
        Stroke(knob, Color3.fromRGB(20, 20, 20), 0.25)

        function obj:SetValue(v, silent)
            local mult = 10 ^ rnd
            v = math.clamp(math.floor(v * mult + 0.5) / mult, min, max)
            obj.Value = v
            Library.Flags[idx] = v
            local alpha = (v - min) / (max - min)
            Tween(fill, 0.1, { Size = UDim2.fromScale(alpha, 1) })
            Tween(knob, 0.1, { Position = UDim2.new(alpha, 0, 0.5, 0) })
            valLabel.Text = tostring(v) .. (o.Suffix or "")
            if not silent then emit(obj, o, v) end
        end

        local dragging = false
        local function update(x)
            local alpha = math.clamp((x - bar.AbsolutePosition.X) / bar.AbsoluteSize.X, 0, 1)
            obj:SetValue(min + (max - min) * alpha)
        end
        Connect(bar.InputBegan, function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1
                or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                update(input.Position.X)
            end
        end)
        Connect(UIS.InputChanged, function(input)
            if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
                or input.UserInputType == Enum.UserInputType.Touch) then
                update(input.Position.X)
            end
        end)
        Connect(UIS.InputEnded, function() dragging = false end)

        reg(idx, obj)
        obj:SetValue(obj.Value, true)
        return obj
    end

    function api:AddDropdown(idx, o)
        o = o or {}
        local values = o.Values or {}
        local obj = {
            Value = o.Multi and {} or (o.Default or values[1]),
            Type = "Dropdown",
            Values = values,
        }
        attachCallbacks(obj)
        if o.Multi and type(o.Default) == "table" then
            for _, v in ipairs(o.Default) do obj.Value[v] = true end
        end

        local row = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            AutomaticSize = Enum.AutomaticSize.Y,
        }, holder)
        List(row, 4)

        local headWrap = New("Frame", {
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = T.Stroke,
            ClipsDescendants = true,
        }, row)
        Corner(headWrap, 6)

        local head = New("TextButton", {
            Text = "",
            Size = UDim2.new(1, -2, 1, -2),
            Position = UDim2.fromOffset(1, 1),
            BackgroundColor3 = T.Element,
            AutoButtonColor = false,
            ClipsDescendants = true,
        }, headWrap)
        Corner(head, 5)
        Connect(head.MouseEnter, function() Tween(head, 0.12, { BackgroundColor3 = Color3.fromRGB(50, 50, 50) }) end)
        Connect(head.MouseLeave, function() Tween(head, 0.12, { BackgroundColor3 = T.Element }) end)

        local titleLbl = Label(head, o.Text or idx, 13, T.Text)
        titleLbl.Position = UDim2.fromOffset(10, 0)
        titleLbl.Size = UDim2.new(0.42, 0, 1, 0)

        local currentLbl = Label(head, "", 12, T.SubText)
        currentLbl.AnchorPoint = Vector2.new(1, 0)
        currentLbl.Position = UDim2.new(1, -32, 0, 0)
        currentLbl.Size = UDim2.new(0.5, -20, 1, 0)
        currentLbl.TextXAlignment = Enum.TextXAlignment.Right
        currentLbl.TextTruncate = Enum.TextTruncate.AtEnd

        local arrow = New("ImageLabel", {
            BackgroundTransparency = 1,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -10, 0.5, 0),
            Size = UDim2.fromOffset(16, 16),
            ImageColor3 = T.SubText,
        }, head)
        Library:ApplyIcon(arrow, "chevron-down")

        local listWrap = New("Frame", {
            Size = UDim2.new(1, 0, 0, 0),
            BackgroundColor3 = T.Stroke,
            ClipsDescendants = true,
            Visible = false,
            LayoutOrder = 2,
        }, row)
        Corner(listWrap, 6)

        local listScroll = New("ScrollingFrame", {
            Size = UDim2.new(1, -2, 1, -2),
            Position = UDim2.fromOffset(1, 1),
            BackgroundColor3 = T.Group,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Color3.fromRGB(70, 70, 70),
            CanvasSize = UDim2.new(),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollingDirection = Enum.ScrollingDirection.Y,
        }, listWrap)
        Corner(listScroll, 5)
        List(listScroll, 3)
        Pad(listScroll, 5, 5, 5, 5)

        local listScale = New("UIScale", { Scale = 1 }, listWrap)
        local items = {}
        local state = { open = false }

        local function computeListHeight()
            local count = #obj.Values
            local h = count * 28 + math.max(0, count - 1) * 3 + 10
            return math.clamp(h, 32, 220)
        end

        function state.close()
            state.open = false
            Tween(listScale, 0.15, { Scale = 0.96 })
            task.delay(0.12, function()
                if not state.open then
                    listWrap.Visible = false
                    listWrap.Size = UDim2.new(1, 0, 0, 0)
                end
            end)
            Tween(arrow, 0.18, { Rotation = 0 })
        end
        function state.hitTest(pos)
            return InRect(headWrap, pos) or (state.open and InRect(listWrap, pos))
        end
        table.insert(Library._dropdowns, state)

        local function getText()
            if o.Multi then
                local sel = {}
                for _, v in ipairs(obj.Values) do
                    if obj.Value[v] then table.insert(sel, v) end
                end
                return #sel > 0 and table.concat(sel, ", ") or "None"
            end
            return tostring(obj.Value or "None")
        end

        local function snapshot()
            if not o.Multi then return obj.Value end
            local copy = {}
            for k, on in pairs(obj.Value) do if on then copy[k] = true end end
            return copy
        end

        local function refresh()
            currentLbl.Text = getText()
            Library.Flags[idx] = obj.Value
            for v, btn in pairs(items) do
                local on = o.Multi and obj.Value[v] or (obj.Value == v)
                Tween(btn, 0.12, { TextColor3 = on and T.Accent or T.SubText })
            end
        end

        local function build()
            for _, b in pairs(items) do b:Destroy() end
            items = {}
            for i, v in ipairs(obj.Values) do
                local b = New("TextButton", {
                    Text = tostring(v),
                    Font = Enum.Font.Gotham,
                    TextSize = 13,
                    TextColor3 = T.SubText,
                    Size = UDim2.new(1, 0, 0, 28),
                    BackgroundColor3 = T.Element,
                    BackgroundTransparency = 1,
                    AutoButtonColor = false,
                    ClipsDescendants = true,
                    LayoutOrder = i,
                }, listScroll)
                Corner(b, 5)
                Connect(b.MouseEnter, function() Tween(b, 0.1, { BackgroundTransparency = 0.55 }) end)
                Connect(b.MouseLeave, function() Tween(b, 0.1, { BackgroundTransparency = 1 }) end)
                Connect(b.MouseButton1Click, function()
                    if o.Multi then
                        obj.Value[v] = not obj.Value[v] or nil
                    else
                        obj.Value = v
                        state.close()
                    end
                    refresh()
                    emit(obj, o, snapshot())
                end)
                items[v] = b
            end
            if state.open then
                listWrap.Size = UDim2.new(1, 0, 0, computeListHeight())
            end
            refresh()
        end

        function obj:SetValues(newValues)
            obj.Values = newValues
            if not o.Multi then
                local found = false
                for _, v in ipairs(newValues) do
                    if v == obj.Value then found = true break end
                end
                if not found then
                    obj.Value = newValues[1]
                    Library.Flags[idx] = obj.Value
                end
            end
            build()
        end

        function obj:SetValue(v, silent)
            if o.Multi then
                obj.Value = {}
                if type(v) == "table" then
                    for k, on in pairs(v) do
                        if on then
                            if type(k) == "number" then obj.Value[on] = true
                            else obj.Value[k] = true end
                        end
                    end
                end
            else
                obj.Value = v
            end
            refresh()
            if not silent then emit(obj, o, snapshot()) end
        end

        Connect(head.MouseButton1Click, function()
            if state.open then
                state.close()
            else
                for _, d in ipairs(Library._dropdowns) do
                    if d ~= state then d.close() end
                end
                state.open = true
                listWrap.Size = UDim2.new(1, 0, 0, computeListHeight())
                listWrap.Visible = true
                listScale.Scale = 0.96
                Tween(arrow, 0.18, { Rotation = 180 })
                Tween(listScale, 0.18, { Scale = 1 }, Enum.EasingStyle.Quint)
            end
        end)

        build()
        reg(idx, obj)
        return obj
    end

