function ScriptLib:Notify(title, text, duration)
    duration = duration or 3

    local Notif = Create("Frame", {
        BackgroundColor3 = Theme.Secondary,
        BackgroundTransparency = 0.1,
        BorderSizePixel = 0,
        Position = UDim2.new(1, 20, 1, -90),
        Size = UDim2.fromOffset(270, 60),
        Parent = ScreenGui,
    })
    AddCorner(Notif, 10)
    AddStroke(Notif, 0.4)
    AddNoise(Notif)

    Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 10),
        Size = UDim2.new(1, -28, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = title or "Notification",
        TextColor3 = Theme.Text,
        TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
        ZIndex = 2,
        Parent = Notif,
    })
    Create("TextLabel", {
        BackgroundTransparency = 1,
        Position = UDim2.fromOffset(14, 28),
        Size = UDim2.new(1, -28, 0, 24),
        Font = Enum.Font.Gotham,
        Text = text or "",
        TextColor3 = Theme.TextDim,
        TextSize = 11,
        TextXAlignment = Enum.TextXAlignment.Left,
        TextWrapped = true,
        ZIndex = 2,
        Parent = Notif,
    })

    Tween(Notif, { Position = UDim2.new(1, -290, 1, -90) }, TweenInfoMed)
    task.delay(duration, function()
        local tw = Tween(Notif, { Position = UDim2.new(1, 20, 1, -90) }, TweenInfoMed)
        tw.Completed:Wait()
        Notif:Destroy()
    end)
end

